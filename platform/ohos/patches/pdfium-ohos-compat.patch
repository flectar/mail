+//
+// Compatibility entry points for pdfium-render 0.9.4. The pinned OHOS PDFium
+// source keeps the implementations under different/removed public names, but
+// the Rust dynamic bindings require these symbols to exist at load time.
+// They are optional APIs for the preview path; unsupported operations return
+// the documented empty/error values rather than failing the whole library load.
+
+#define FPDF_IMPLEMENTATION
+
+#include <cstddef>
+#include <cstdint>
+
+#include "public/fpdf_annot.h"
+#include "public/fpdf_attachment.h"
+#include "public/fpdf_catalog.h"
+#include "public/fpdf_edit.h"
+#include "public/fpdf_formfill.h"
+#include "public/fpdf_structtree.h"
+#include "public/fpdf_sysfontinfo.h"
+#include "public/fpdf_text.h"
+#include "public/fpdfview.h"
+
+// Present in the PDFium API version consumed by pdfium-render 0.9.4, but no
+// longer declared by this OHOS source revision.
+typedef const struct fpdf_structelement_attr_value_t__*
+    FPDF_STRUCTELEMENT_ATTR_VALUE;
+
+extern "C" {
+
+FPDF_EXPORT unsigned long FPDF_CALLCONV
+FPDF_GetDocUserPermissions(FPDF_DOCUMENT document) {
+  return FPDF_GetDocPermissions(document);
+}
+
+FPDF_EXPORT FPDF_PAGEOBJECT FPDF_CALLCONV
+FPDFText_GetTextObject(FPDF_TEXTPAGE text_page, int index) {
+  (void)text_page;
+  (void)index;
+  return nullptr;
+}
+
+FPDF_EXPORT int FPDF_CALLCONV
+FPDFText_IsHyphen(FPDF_TEXTPAGE text_page, int index) {
+  (void)text_page;
+  (void)index;
+  return 0;
+}
+
