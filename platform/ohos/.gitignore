# Nested cargo workspace build artifacts (the root `.cargo/config.toml` maps
# target-dir to the repo root, but keep this for standalone builds).
target/
# hap staging and generated hvigor prerequisites (machine-specific paths).
build/
shell/local.properties
shell/node_modules
shell/entry/build
shell/entry/.preview
# Prebuilt native libraries (fetched by scripts/fetch-pdfium.sh).
prebuilt/arm64/
prebuilt/*.tar.gz
# codelinter/hvigor caches under the shell project
shell/.cache/
# hvigor build metadata, wherever hvigor runs.
.hvigor/
# Generated by build-hap.sh from page-templates/Index.<APP>.ets.
/shell/entry/src/main/ets/pages/Index.ets
