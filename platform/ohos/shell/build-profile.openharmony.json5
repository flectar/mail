{
  app: {
    products: [
      {
        // OpenHarmony has no HMS: Scan Kit is unavailable and Sync pairs
        // through codes and displayed QR codes. build-hap.sh copies this
        // profile over build-profile.json5 for SCAN_KIT=openharmony.
        name: 'default',
        compileSdkVersion: '26.0.0',
        compatibleSdkVersion: '18',
        targetSdkVersion: '26.0.0',
        runtimeOS: 'OpenHarmony',
        buildOption: {
          strictMode: {
            caseSensitiveCheck: true,
            useNormalizedOHMUrl: false,
          },
        },
      },
    ],
    buildModeSet: [{ name: 'debug' }, { name: 'release' }],
  },
  modules: [
    {
      name: 'entry',
      srcPath: './entry',
      targets: [{ name: 'default', applyToProducts: ['default'] }],
    },
  ],
}
