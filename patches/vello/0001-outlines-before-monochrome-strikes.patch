+
+/// The bitmap strikes that may stand in for the font's glyphs.
+///
+/// Monochrome and grayscale `EBDT` strikes in a font with outlines, such as
+/// Calibri's, are meant for a few exact sizes drawn without antialiasing, so
+/// the outlines are drawn instead, as Skia does unless embedded bitmaps are
+/// enabled.
+fn drawn_bitmap_strikes<'a>(font: &skrifa::FontRef<'a>) -> Option<bitmap::BitmapStrikes<'a>> {
+    let strikes = font.bitmap_strikes();
+    if strikes.is_empty()
+        || strikes.format() == Some(BitmapFormat::Ebdt) && font.outline_glyphs().format().is_some()
+    {
+        return None;
+    }
+    Some(strikes)
+}
