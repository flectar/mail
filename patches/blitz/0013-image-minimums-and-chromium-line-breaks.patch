 fn edge_line_break(cx: parley::LineBreakContext) -> Option<bool> {
-    (cx.before == INLINE_START_EDGE).then_some(false)
+    (cx.before == INLINE_START_EDGE || cx.after == INLINE_END_EDGE).then_some(false)
