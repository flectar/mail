+/// The TLS configuration a caller chose, which needs rustls.
+#[cfg(feature = "rustls")]
+type TlsConfig = Option<rustls::ClientConfig>;
+#[cfg(not(feature = "rustls"))]
+type TlsConfig = ();
+
+#[cfg(feature = "rustls")]
+fn with_tls(builder: HttpClientBuilder, tls: &TlsConfig) -> HttpClientBuilder {
+    match tls {
+        Some(tls) => builder.tls_backend_preconfigured(tls.clone()),
+        None => builder,
+    }
+}
+
+#[cfg(not(feature = "rustls"))]
+fn with_tls(builder: HttpClientBuilder, _tls: &TlsConfig) -> HttpClientBuilder {
+    builder
+}
