#: ui/ai-summary.slint:65 ui/ai-summary.slint:87
msgid "Answer by AI"
msgstr "用AI回答"

#: ui/ai-summary.slint:65 ui/ai-summary.slint:87
msgid "Summary by AI"
msgstr "用AI总结"

#: ui/ai-summary.slint:93
msgid "AI can be wrong. Check what matters in the messages."
msgstr "AI 可能出错，请检查邮件中的重要内容。"

#: ui/ai-summary.slint:104
msgid "Close the summary"
msgstr "关闭摘要"

#: ui/ai-summary.slint:110 ui/app.slint:673
msgid "Asking the AI server…"
msgstr "正在询问 AI 服务器…"

#: ui/ai-summary.slint:110
msgid "Summarizing the conversation…"
msgstr "正在总结会话…"

#: ui/ai-summary.slint:119 ui/app.slint:667
msgid "Set up an AI server in Settings to use AI features."
msgstr "请在设置中配置 AI 服务器以使用 AI 功能。"

