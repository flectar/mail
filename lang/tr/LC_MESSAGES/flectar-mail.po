msgid "Remove"
msgstr "Kaldır"

#: ui/ai.slint:276 ui/translation.slint:253
msgid "Remove {}"
msgstr "Kaldır: {}"

#: ui/ai.slint:286
msgid "Add a prompt"
msgstr "İstem ekle"

