msgstr "{} · Sunucuda"

#: ui/dialogs/settings-dialog.slint:2555
msgid "{} · On some servers"
msgstr "{} · Bazı sunucularda"

#: ui/dialogs/settings-dialog.slint:2556
msgid "{} · On this device"
msgstr "{} · Bu cihazda"

#: ui/dialogs/settings-dialog.slint:2564
msgid "On the server"
msgstr "Sunucuda"

#: ui/dialogs/settings-dialog.slint:2565
msgid "On some servers"
msgstr "Bazı sunucularda"

#: ui/dialogs/settings-dialog.slint:2580
msgid "Move {} up"
msgstr "{} yukarı taşı"

#: ui/dialogs/settings-dialog.slint:2591
msgid "Move {} down"
msgstr "{} aşağı taşı"

#: ui/dialogs/settings-dialog.slint:2597 ui/dialogs/settings-dialog.slint:2608
msgid "Edit {}"
