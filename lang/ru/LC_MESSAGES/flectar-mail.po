#: ui/dialogs/settings-dialog.slint:2681 ui/dialogs/settings-dialog.slint:2711
msgid "Add profile"
msgstr "Добавить профиль"

#: ui/dialogs/settings-dialog.slint:2695 ui/dialogs/settings-dialog.slint:2703
msgid "Show account color at the left edge of each message"
msgstr "Показывать цвет учётной записи у левого края каждого сообщения"

#: ui/dialogs/settings-dialog.slint:2725
msgid ""
"No profiles yet. Accounts keep their individual or generated colors until "
