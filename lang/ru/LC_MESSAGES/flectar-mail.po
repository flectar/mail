#: ui/dialogs/settings-dialog.slint:2770 ui/dialogs/settings-dialog.slint:4610
msgid "Edit profile"
msgstr "Редактировать профиль"

#: ui/dialogs/settings-dialog.slint:2780 ui/dialogs/settings-dialog.slint:4942
msgid "Delete profile"
msgstr "Удалить профиль"

#: ui/dialogs/settings-dialog.slint:2796 ui/dialogs/settings-dialog.slint:2842
msgid "Add Gmail"
msgstr "Добавить Gmail"

#: ui/dialogs/settings-dialog.slint:2809 ui/dialogs/settings-dialog.slint:2843
msgid "Add Outlook"
msgstr "Добавить Outlook"

#: ui/dialogs/settings-dialog.slint:2822 ui/dialogs/settings-dialog.slint:2844
msgid "Add mail account"
msgstr "Добавить учётную запись почты"

#: ui/dialogs/settings-dialog.slint:2835 ui/dialogs/settings-dialog.slint:2845
msgid "Cancel sign-in"
