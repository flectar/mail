# Rust build output and locally packaged artifacts
/target/
/.flatpak-builder/
/.flathub-local.yml
/libs/
/.artifacts/
/tmp/
/.devcontainer/
*.AppImage
/platform/android/gradle/.gradle/
/platform/android/gradle/app/build/
/platform/android/gradle/build/
/platform/ios/*.xcodeproj/

# Local OAuth application registrations (see .env.example)
/.env

# Android private signing keys (the public certificate fingerprint is tracked)
*.keystore
*.jks
*.p12

# Editor and operating-system files
*~
.vscode/
.idea/
.DS_Store
.Trash-*/

# Temporary UI previews and local review captures
/ui/.*.slint
/settings-accounts-*.png

# Slint's winit backend resolves through the application lockfiles.
/crates/i-slint-backend-winit/Cargo.lock
/crates/i-slint-backend-android-activity/Cargo.lock
/crates/i-slint-renderer-software/Cargo.lock
/crates/fontique/Cargo.lock
/crates/vello/Cargo.lock
/crates/jmap-client/Cargo.lock

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# The Secret portal test program's build, lockfile copy and Flatpak state.
/packaging/flatpak/secret-portal-test/target/
/packaging/flatpak/secret-portal-test/build/
/packaging/flatpak/secret-portal-test/.flatpak-builder/
/packaging/flatpak/secret-portal-test/Cargo.lock
