# Rust build output and locally packaged artifacts
/target/
/.flatpak-builder/
/libs/
/.artifacts/
/tmp/
/.devcontainer/
*.AppImage
/platform/android/gradle/.gradle/
/platform/android/gradle/app/build/
/platform/android/gradle/build/
/platform/ios/*.xcodeproj/

# Local OAuth application registrations (see .env.example)
/.env

# Android private signing keys (the public certificate fingerprint is tracked)
*.keystore
*.jks
*.p12

# Editor and operating-system files
*~
.vscode/
.idea/
.DS_Store
.Trash-*/

# Temporary UI previews and local review captures
/ui/.*.slint
/settings-accounts-*.png

# Candle and Slint's winit backend resolve through the application lockfiles.
/crates/candle-core/Cargo.lock
/crates/i-slint-backend-winit/Cargo.lock

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# hvigor build metadata (the OHOS shell build regenerates it)
.hvigor/

# The shell entry page is generated by build-hap.sh from page-templates/Index.<APP>.ets.
/platform/ohos/shell/entry/src/main/ets/pages/Index.ets
