    ui-message-contacts(key, argument, second-argument, third-argument) => {
        if (key == "Add an email address, then save the contact.") { return @tr("Add an email address, then save the contact."); }
        if (key == "Enter a valid email address before saving.") { return @tr("Enter a valid email address before saving."); }
        if (key == "Could not save: contact storage is unavailable.") { return @tr("Could not save: contact storage is unavailable."); }
        if (key == "Could not save contact: {}") { return @tr("Could not save contact: {}", argument); }
