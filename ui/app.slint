// Rust view-models call this global for the small amount of date/status text
// that must be materialized before it enters a Slint model. Keeping the
// translations here makes those strings part of the same bundled catalog as
// the declarative UI.
export global I18n {
    pure callback month-name(int, bool) -> string;
    pure callback weekday-short(int) -> string;
    pure callback calendar-all-day() -> string;
    pure callback untitled-event() -> string;
    pure callback no-contact-history() -> string;
    pure callback contact-history-available() -> string;
    pure callback new-contact-entry() -> string;
    pure callback no-connected-account() -> string;
    pure callback interaction-count(int) -> string;
    pure callback last-contacted(int, int, int) -> string;
    pure callback loading-local-data() -> string;
    pure callback local-data-ready() -> string;
    pure callback local-data-unavailable(string) -> string;
    pure callback could-not-display-local-mail(string) -> string;
    pure callback ui-message(string, string, string, string) -> string;
    pure callback ui-message-settings(string, string, string, string) -> string;
    pure callback ui-message-system(string, string, string, string) -> string;
    pure callback ui-message-account(string, string, string, string) -> string;
    pure callback ui-message-data(string, string, string, string) -> string;
    pure callback ui-message-list(string, string, string, string) -> string;
    pure callback ui-message-contacts(string, string, string, string) -> string;
    pure callback ui-message-calendar(string, string, string, string) -> string;
    pure callback ui-message-startup(string, string, string, string) -> string;
    pure callback ui-message-sync(string, string, string, string) -> string;
    pure callback ui-message-actions(string, string, string, string) -> string;
    pure callback ui-message-compose(string, string, string, string) -> string;
    pure callback ui-message-oauth(string, string, string, string) -> string;

    month-name(month, short) => {
        if (month == 1) { return short ? @tr("Jan") : @tr("January"); }
        if (month == 2) { return short ? @tr("Feb") : @tr("February"); }
        if (month == 3) { return short ? @tr("Mar") : @tr("March"); }
        if (month == 4) { return short ? @tr("Apr") : @tr("April"); }
        if (month == 5) { return @tr("May"); }
        if (month == 6) { return short ? @tr("Jun") : @tr("June"); }
        if (month == 7) { return short ? @tr("Jul") : @tr("July"); }
        if (month == 8) { return short ? @tr("Aug") : @tr("August"); }
        if (month == 9) { return short ? @tr("Sep") : @tr("September"); }
        if (month == 10) { return short ? @tr("Oct") : @tr("October"); }
        if (month == 11) { return short ? @tr("Nov") : @tr("November"); }
        if (month == 12) { return short ? @tr("Dec") : @tr("December"); }
        return "";
    }

    weekday-short(day) => {
        if (day == 0) { return @tr("Mon"); }
        if (day == 1) { return @tr("Tue"); }
        if (day == 2) { return @tr("Wed"); }
        if (day == 3) { return @tr("Thu"); }
        if (day == 4) { return @tr("Fri"); }
        if (day == 5) { return @tr("Sat"); }
        return @tr("Sun");
    }

    calendar-all-day() => { return @tr("All day"); }
    untitled-event() => { return @tr("(untitled event)"); }
    no-contact-history() => { return @tr("No conversation history"); }
    contact-history-available() => { return @tr("Conversation history available"); }
    new-contact-entry() => { return @tr("New address-book entry"); }
    no-connected-account() => { return @tr("No connected account"); }
    interaction-count(count) => {
        return @tr("{n} interaction" | "{n} interactions" % count);
    }
    last-contacted(month, day, year) => {
        return @tr("Last contacted {} {}, {}", root.month-name(month, true), day, year);
    }
    loading-local-data() => { return @tr("Loading local data…"); }
    local-data-ready() => { return @tr("Local data ready."); }
    local-data-unavailable(error) => { return @tr("Local data is unavailable: {}", error); }
    could-not-display-local-mail(error) => { return @tr("Could not display local mail: {}", error); }
    ui-message(key, argument, second-argument, third-argument) => {
        if (key == "") { return ""; }
        // Every Rust-originated UI message is selected here from a stable key.
        // Never translate `key` dynamically: explicit @tr expressions keep the
        // complete source catalog available to extraction and translators. The
        // bounded groups avoid a deeply recursive expression in the compiler.
        let settings = root.ui-message-settings(key, argument, second-argument, third-argument);
        if (settings != "") { return settings; }
        let system = root.ui-message-system(key, argument, second-argument, third-argument);
        if (system != "") { return system; }
        let account = root.ui-message-account(key, argument, second-argument, third-argument);
        if (account != "") { return account; }
        let data = root.ui-message-data(key, argument, second-argument, third-argument);
        if (data != "") { return data; }
        let list = root.ui-message-list(key, argument, second-argument, third-argument);
        if (list != "") { return list; }
        let contacts = root.ui-message-contacts(key, argument, second-argument, third-argument);
        if (contacts != "") { return contacts; }
        let calendar = root.ui-message-calendar(key, argument, second-argument, third-argument);
        if (calendar != "") { return calendar; }
        let startup = root.ui-message-startup(key, argument, second-argument, third-argument);
        if (startup != "") { return startup; }
        let sync = root.ui-message-sync(key, argument, second-argument, third-argument);
        if (sync != "") { return sync; }
        let actions = root.ui-message-actions(key, argument, second-argument, third-argument);
        if (actions != "") { return actions; }
        let compose = root.ui-message-compose(key, argument, second-argument, third-argument);
        if (compose != "") { return compose; }
        let oauth = root.ui-message-oauth(key, argument, second-argument, third-argument);
        if (oauth != "") { return oauth; }
        return @tr("An unexpected interface message occurred.");
    }

    ui-message-settings(key, argument, second-argument, third-argument) => {
        if (key == "Notification preferences are active for this session.") { return @tr("Notification preferences are active for this session."); }
        if (key == "Notification preferences saved.") { return @tr("Notification preferences saved."); }
        if (key == "Could not save notifications: {}") { return @tr("Could not save notifications: {}", argument); }
        if (key == "Sync interval is active for this session.") { return @tr("Sync interval is active for this session."); }
        if (key == "Sync interval set to {} minutes.") { return @tr("Sync interval set to {} minutes.", argument); }
        if (key == "Could not save sync interval: {}") { return @tr("Could not save sync interval: {}", argument); }
        if (key == "Message-opening preference updated for this session.") { return @tr("Message-opening preference updated for this session."); }
        if (key == "Message-opening preference saved.") { return @tr("Message-opening preference saved."); }
        if (key == "Could not save message-opening preference: {}") { return @tr("Could not save message-opening preference: {}", argument); }
        if (key == "Theme updated for this session.") { return @tr("Theme updated for this session."); }
        if (key == "Theme preference saved.") { return @tr("Theme preference saved."); }
        if (key == "Could not save theme: {}") { return @tr("Could not save theme: {}", argument); }
        if (key == "Theme palette updated for this session.") { return @tr("Theme palette updated for this session."); }
        if (key == "Theme palette saved.") { return @tr("Theme palette saved."); }
        if (key == "Could not save theme palette: {}") { return @tr("Could not save theme palette: {}", argument); }
        if (key == "Custom theme updated for this session.") { return @tr("Custom theme updated for this session."); }
        if (key == "Custom theme saved.") { return @tr("Custom theme saved."); }
        if (key == "Could not save custom theme: {}") { return @tr("Could not save custom theme: {}", argument); }
        if (key == "Language updated for this session.") { return @tr("Language updated for this session."); }
        if (key == "Language preference saved.") { return @tr("Language preference saved."); }
        if (key == "Could not save language: {}") { return @tr("Could not save language: {}", argument); }
        if (key == "Sidebar icon style updated for this session.") { return @tr("Sidebar icon style updated for this session."); }
        if (key == "Sidebar icon preference saved.") { return @tr("Sidebar icon preference saved."); }
        if (key == "Could not save sidebar icon preference: {}") { return @tr("Could not save sidebar icon preference: {}", argument); }
        if (key == "Avatar preference updated for this session.") { return @tr("Avatar preference updated for this session."); }
        if (key == "Avatar preference saved.") { return @tr("Avatar preference saved."); }
        if (key == "Could not save avatar preference: {}") { return @tr("Could not save avatar preference: {}", argument); }
        if (key == "Workspace layout updated for this session.") { return @tr("Workspace layout updated for this session."); }
        if (key == "Workspace layout preference saved.") { return @tr("Workspace layout preference saved."); }
        if (key == "Could not save workspace layout: {}") { return @tr("Could not save workspace layout: {}", argument); }
        return "";
    }

    ui-message-system(key, argument, second-argument, third-argument) => {
        if (key == "Opened {}") { return @tr("Opened {}", argument); }
        if (key == "Could not open link: {}") { return @tr("Could not open link: {}", argument); }
        if (key == "Copied HTML source") { return @tr("Copied HTML source"); }
        if (key == "Copied selected text") { return @tr("Copied selected text"); }
        if (key == "Copied email text") { return @tr("Copied email text"); }
        if (key == "Copied link") { return @tr("Copied link"); }
        if (key == "Blitz software selection render failed: {}") { return @tr("Blitz software selection render failed: {}", argument); }
        if (key == "Blitz software tile render failed: {}") { return @tr("Blitz software tile render failed: {}", argument); }
        if (key == "Message ready.") { return @tr("Message ready."); }
        if (key == "System tray behavior is unavailable on mobile.") { return @tr("System tray behavior is unavailable on mobile."); }
        if (key == "Close-to-tray is active for this session.") { return @tr("Close-to-tray is active for this session."); }
        if (key == "Saving close behavior…") { return @tr("Saving close behavior…"); }
        if (key == "Closing the window will now keep Flectar Mail in the tray.") { return @tr("Closing the window will now keep Flectar Mail in the tray."); }
        if (key == "Closing the window will now quit Flectar Mail.") { return @tr("Closing the window will now quit Flectar Mail."); }
        if (key == "Could not save close behavior: {}") { return @tr("Could not save close behavior: {}", argument); }
