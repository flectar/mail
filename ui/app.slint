        if (key == "Flectar Mail backup") { return @tr("Flectar Mail backup"); }
        if (key == "Choose where to export the database snapshot") { return @tr("Choose where to export the database snapshot"); }
        if (key == "The platform host does not provide document export.") { return @tr("The platform host does not provide document export."); }
        if (key == "The platform host does not provide document import.") { return @tr("The platform host does not provide document import."); }
        if (key == "Backup exported. Passwords and OAuth tokens were not included.") { return @tr("Backup exported. Passwords and OAuth tokens were not included."); }
        if (key == "Could not export backup: {}") { return @tr("Could not export backup: {}", argument); }
        if (key == "Local data storage is unavailable. Retry startup.") { return @tr("Local data storage is unavailable. Retry startup."); }
        if (key == "Creating verified database snapshot…") { return @tr("Creating verified database snapshot…"); }
        if (key == "Backup imported. All {} account configurations already existed.") { return @tr("Backup imported. All {} account configurations already existed.", argument); }
        if (key == "Imported {} account configurations. Open Accounts and sign in to each one.") { return @tr("Imported {} account configurations. Open Accounts and sign in to each one.", argument); }
