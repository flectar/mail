        if (key == "Opened the system print view.") { return @tr("Opened the system print view."); }
        if (key == "Could not print message: {}") { return @tr("Could not print message: {}", argument); }
        if (key == "Opened the message in your browser.") { return @tr("Opened the message in your browser."); }
        if (key == "Could not open message in browser: {}") { return @tr("Could not open message in browser: {}", argument); }
        if (key == "Connect an account before replying or forwarding.") { return @tr("Connect an account before replying or forwarding."); }
        if (key == "Choose a message first.") { return @tr("Choose a message first."); }
        if (key == "Only drafts can be reopened for editing.") { return @tr("Only drafts can be reopened for editing."); }
        if (key == "Could not open draft: {}") { return @tr("Could not open draft: {}", argument); }
        if (key == "Could not open draft: invalid account identifier") { return @tr("Could not open draft: invalid account identifier"); }
        if (key == "Connected account") { return @tr("Connected account"); }
        if (key == "Could not open composer: {}") { return @tr("Could not open composer: {}", argument); }
        if (key == "Could not open composer: invalid account identifier") { return @tr("Could not open composer: invalid account identifier"); }
        return "";
    }

    ui-message-compose(key, argument, second-argument, third-argument) => {
        if (key == "Attach files to this email") { return @tr("Attach files to this email"); }
        if (key == "The platform host does not provide a document picker.") { return @tr("The platform host does not provide a document picker."); }
        if (key == "Added 1 attachment.") { return @tr("Added 1 attachment."); }
        if (key == "Added {} attachments.") { return @tr("Added {} attachments.", argument); }
        if (key == "Attachments added: {}. Skipped: {} (duplicate, unreadable, or over the 25 MB total limit).") { return @tr("Attachments added: {}. Skipped: {} (duplicate, unreadable, or over the 25 MB total limit).", argument, second-argument); }
        if (key == "Attachment removed.") { return @tr("Attachment removed."); }
        if (key == "Choose the account this message should be sent from.") { return @tr("Choose the account this message should be sent from."); }
        if (key == "Connect an account before saving or sending mail.") { return @tr("Connect an account before saving or sending mail."); }
        if (key == "Message queued for delivery (action {}).") { return @tr("Message queued for delivery (action {}).", argument); }
        if (key == "Draft saved locally (#{}).") { return @tr("Draft saved locally (#{}).", argument); }
        if (key == "Compose failed: {}") { return @tr("Compose failed: {}", argument); }
        if (key == "IMAP port must be between 1 and 65535.") { return @tr("IMAP port must be between 1 and 65535."); }
        if (key == "SMTP port must be between 1 and 65535.") { return @tr("SMTP port must be between 1 and 65535."); }
        if (key == "Local mail data is unavailable. Retry startup.") { return @tr("Local mail data is unavailable. Retry startup."); }
        if (key == "Discovering JMAP and checking capabilities…") { return @tr("Discovering JMAP and checking capabilities…"); }
        if (key == "Certificate imported. Connect to verify the server.") { return @tr("Certificate imported. Connect to verify the server."); }
        if (key == "Could not load account preferences: {}") { return @tr("Could not load account preferences: {}", argument); }
        if (key == "Your edited signature was preserved. Choose No signature to keep it as message text before inserting another.") { return @tr("Your edited signature was preserved. Choose No signature to keep it as message text before inserting another."); }
        if (key == "Certificate import failed: {}") { return @tr("Certificate import failed: {}", argument); }
        if (key == "Paste the PEM certificate into the certificate field.") { return @tr("Paste the PEM certificate into the certificate field."); }
        if (key == "Testing IMAP and SMTP connections…") { return @tr("Testing IMAP and SMTP connections…"); }
        return "";
    }

    ui-message-oauth(key, argument, second-argument, third-argument) => {
        if (key == "Another browser authorization is already in progress; finish it or choose Cancel.") { return @tr("Another browser authorization is already in progress; finish it or choose Cancel."); }
        if (key == "Add app keys in Sign-in settings to enable this provider.") { return @tr("Add app keys in Sign-in settings to enable this provider."); }
        if (key == "Choose Gmail or Outlook OAuth.") { return @tr("Choose Gmail or Outlook OAuth."); }
        if (key == "Complete sign-in in your browser, or choose Cancel here.") { return @tr("Complete sign-in in your browser, or choose Cancel here."); }
        if (key == "Cancelling browser sign-in…") { return @tr("Cancelling browser sign-in…"); }
        if (key == "Calendar core is unavailable.") { return @tr("Calendar core is unavailable."); }
        if (key == "Account no longer exists.") { return @tr("Account no longer exists."); }
        if (key == "Authorize calendar access in your browser.") { return @tr("Authorize calendar access in your browser."); }
        if (key == "OAuth app keys saved.") { return @tr("OAuth app keys saved."); }
        if (key == "{} OAuth settings saved.") { return @tr("{} OAuth settings saved.", argument); }
        if (key == "OAuth settings failed: {}") { return @tr("OAuth settings failed: {}", argument); }
        if (key == "Mail refresh failed: {}") { return @tr("Mail refresh failed: {}", argument); }
        if (key == "Mail filter failed: {}") { return @tr("Mail filter failed: {}", argument); }
        if (key == "Mail pagination failed: {}") { return @tr("Mail pagination failed: {}", argument); }
        if (key == "Could not mark message as read: {}") { return @tr("Could not mark message as read: {}", argument); }
        if (key == "Loading message…") { return @tr("Loading message…"); }
        return "";
    }
}

export component AppWindow inherits Window {
    title: @tr("Flectar Mail");
    icon: @image-url("../resources/app-icon/flectar-mail-masked.png");
    default-font-family: "Google Sans Flex";
    preferred-width: 1320px;
    preferred-height: 800px;
    min-width: 320px;
    min-height: 320px;
    background: root.page-bg;

    callback select_email(int);
    callback search_changed(string);
    callback set_search_filter(string);
    callback select_scope(string);
    callback toggle_folder(int, bool);
    callback toggle_sidebar_section(string, bool);
    callback create_folder(int, int, string);
    callback rename_folder(int, string);
    callback delete_folder(int);
    callback load_more();
    callback toggle_settings();
    callback sync_mail();
    callback message_action(string);
    callback message_action_for_email(int, string);
    callback set_email_checked(int, bool);
    callback set_all_emails_checked(bool);
    callback toggle_mail_label(int, bool);
    callback save_mail_label(int, string, color);
    callback delete_mail_label(int);
    callback search_mail_labels(string);
    callback compose_message_action(string);
    callback close_preview();
    callback print_message();
    callback open_message_in_browser();
    callback save_theme(string);
    callback save_theme_preset(string);
    callback save_custom_theme(color, color, color, color, color, color, color, color, color, color) -> bool;
    callback save_avatar_visibility(bool);
    callback save_workspace_layout(string);
    callback save_language(string);
    callback save_sidebar_icon_style(bool);
    callback save_notification_settings(bool, bool, string);
    callback save_sync_interval(int);
    callback save_mark_read_on_open(bool);
    callback set_close_to_tray(bool);
    callback open_compose();
    callback close_compose();
    callback save_compose(int, string, string, string, string, string, bool);
    callback pick_compose_attachments();
    callback remove_compose_attachment(int);
    callback format_compose(string, string, int, int);
    callback link_compose(string, string, int, int);
    callback edit_compose_body(string, int, int);
    callback update_compose_selection(int, int);
    callback compose_history(string);
    callback compose_editor_pointer_event(float, float, string, bool, bool, bool, bool);
    callback compose_editor_key_event(string, bool, bool, bool, bool) -> bool;
    callback compose_editor_layout_changed();
    callback search_compose_contacts(string, int);
    callback select_compose_contact(int, string) -> string;
    callback add_password_account(string, string, string, string, string, string, string, string, string);
    callback start_oauth(string);
    callback reauth_account(int);
    callback cancel_oauth();
    callback save_oauth_app(string, string, string);
    callback save_oauth_apps(string, string, string);
    pure callback make_account_transfer(string) -> data-transfer;
    pure callback read_account_transfer(data-transfer) -> string;
    callback reorder_account(string, int, bool);
    callback save_account_mail_history(int, string);
    callback connect_account_calendar(int);
    callback set_account_calendar_enabled(int, bool);
    callback connect_caldav(int, string, string, string);
    callback export_account_backup();
    callback import_account_backup();
    callback export_database_snapshot();
    callback delete_all_data();
    callback open_email_link(string);
    callback copy_email_status(string);
    callback email-pointer-event(float, float, string, bool, bool, bool, bool);
    callback email-scroll(float, float);
    callback email-key-event(string, bool, bool, bool, bool, bool, bool);
    callback select-email-text();
    callback set-remote-images(bool);
    callback load-remote-images-for-message();
    callback calendar-navigate(string, int);
    callback calendar-select-date(string);
    callback calendar-set-view(string);
    callback calendar-set-source-enabled(int, bool);
    callback calendar-today();
    callback calendar-open-editor();
    callback calendar-edit-event(int);
    callback calendar-delete-event(int);
    callback calendar-save-event(string, string, string, string, int);
    callback select-contact(int);
    callback search-contacts(string);
    callback select-contact-scope(string);
    callback toggle-contact-section(string, bool);
    callback new-contact();
    callback save-contact(int, string, string, string, string, string, string, string, string, string, string, bool);
    callback delete-contact(int);
    callback load-contacts();
    callback load-more-contacts();
    callback system-back-requested() -> bool;
    callback retry-startup();

    // Host-internal wakeups. Background work only schedules these when data is
    // ready; Rust drains the corresponding bounded channel on Slint's thread.
    callback drain-startup-updates();
    callback drain-core-updates();
    callback drain-mail-list-updates();
    callback drain-mail-metadata-updates();
    callback drain-folder-updates();
    callback drain-message-load-updates();
    callback drain-read-updates();
    callback drain-navigation-updates();
    callback drain-action-updates();
    callback drain-favicon-updates();
    callback drain-profile-avatar-updates();
    callback drain-ui-task-updates();
    callback drain-sync-updates();
    callback drain-data-reset-updates();
    callback drain-contact-load-updates();
    callback refresh-email-resources();

    in property <[EmailRow]> emails: [];
    in property <[SidebarRow]> sidebar_rows: [];
