    ui-message-data(key, argument, second-argument, third-argument) => {
        if (key == "Connect an account before creating a backup.") { return @tr("Connect an account before creating a backup."); }
        if (key == "Export Flectar Mail account backup") { return @tr("Export Flectar Mail account backup"); }
