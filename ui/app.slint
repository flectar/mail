        if (key == "Showing {} of {} message matching \"{}\" · current results complete") { return @tr("Showing {} of {} message matching \"{}\" · current results complete", argument, second-argument, third-argument); }
        if (key == "Showing {} of {} messages matching \"{}\"") { return @tr("Showing {} of {} messages matching \"{}\"", argument, second-argument, third-argument); }
