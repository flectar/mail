        if (key == "Showing {} of {} message") { return @tr("Showing {} of {} message", argument, second-argument); }
        if (key == "Showing {} of {} message · more available") { return @tr("Showing {} of {} message · more available", argument, second-argument); }
        if (key == "Showing {} of {} message · current results complete") { return @tr("Showing {} of {} message · current results complete", argument, second-argument); }
        if (key == "Showing {} of {} messages") { return @tr("Showing {} of {} messages", argument, second-argument); }
        if (key == "Showing {} of {} messages · more available") { return @tr("Showing {} of {} messages · more available", argument, second-argument); }
        if (key == "Showing {} of {} messages · current results complete") { return @tr("Showing {} of {} messages · current results complete", argument, second-argument); }
