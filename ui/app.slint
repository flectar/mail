        if (key == "Label added.") { return @tr("Label added."); }
        if (key == "Label removed.") { return @tr("Label removed."); }
        if (key == "Label created and added.") { return @tr("Label created and added."); }
        if (key == "Label updated.") { return @tr("Label updated."); }
        if (key == "Label deleted.") { return @tr("Label deleted."); }
        if (key == "Could not update label: {}") { return @tr("Could not update label: {}", argument); }
        if (key == "Could not save label: {}") { return @tr("Could not save label: {}", argument); }
        if (key == "Could not delete label: {}") { return @tr("Could not delete label: {}", argument); }
        if (key == "Folder created.") { return @tr("Folder created."); }
