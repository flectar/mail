            save_mark_read_on_open(enabled) => { root.save_mark_read_on_open(enabled); }
            set_close_to_tray(enabled) => { root.set_close_to_tray(enabled); }
            sync_mail => { root.sync_mail(); }
            add_password_account(protocol, email, username, password, jmap-url, imap-host, imap-port, smtp-host, smtp-port) => {
                root.add_password_account(protocol, email, username, password, jmap-url, imap-host, imap-port, smtp-host, smtp-port);
            }
            start_oauth(provider) => { root.start_oauth(provider); }
            reauth_account(account-id) => { root.reauth_account(account-id); }
            cancel_oauth => { root.cancel_oauth(); }
            save_oauth_app(google-id, google-secret, microsoft-id) => {
                root.save_oauth_app(google-id, google-secret, microsoft-id);
            }
            set-remote-images(enabled) => { root.set-remote-images(enabled); }
            make_account_transfer(value) => root.make_account_transfer(value);
            read_account_transfer(value) => root.read_account_transfer(value);
            reorder_account(source, target, after) => { root.reorder_account(source, target, after); }
            save_account_mail_history(account-id, value) => { root.save_account_mail_history(account-id, value); }
            connect_account_calendar(account-id) => { root.connect_account_calendar(account-id); }
            set_account_calendar_enabled(account-id, enabled) => { root.set_account_calendar_enabled(account-id, enabled); }
            connect_caldav(account-id, url, username, password) => { root.connect_caldav(account-id, url, username, password); }
            export_account_backup => { root.export_account_backup(); }
            import_account_backup => { root.import_account_backup(); }
            export_database_snapshot => { root.export_database_snapshot(); }
            delete_all_data => { root.delete_all_data(); }
            open-link(url) => { root.open_email_link(url); }
        }
        }

        compose-dialog := ComposeDialog {
            compact: root.compact-layout;
            attachment-picker-supported: root.document_apis_supported;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            accent: root.accent;
            accent-soft: root.accent-soft;
            body-text: root.body-text;
            border: root.border;
            border-subtle: root.border-subtle;
            control-bg: root.control-bg;
            muted-control-bg: root.muted-control-bg;
            muted-text: root.muted-text;
            secondary-text: root.secondary-text;
            surface: root.surface;
            surface-raised: root.surface-raised;
            title-color: root.title-color;
            compose_open <=> root.compose_open;
            compose_mode: root.compose_mode;
            compose_to <=> root.compose_to;
            compose_cc <=> root.compose_cc;
            compose_bcc <=> root.compose_bcc;
            compose_subject <=> root.compose_subject;
            compose_body <=> root.compose_body;
            compose_accounts: root.connected_accounts;
            compose_account_id <=> root.compose_account_id;
            compose_contact_suggestions: root.compose_contact_suggestions;
            compose_attachments: root.compose_attachments;
            compose_attachment_summary: root.compose_attachment_summary;
            compose_from_label <=> root.compose_from_label;
            compose_notice: root.compose_notice;
            compose_notice_is_error: root.compose_notice_is_error;
            compose_selection_start: root.compose_selection_start;
            compose_selection_end: root.compose_selection_end;
            compose_editor_tiles: root.compose_editor_tiles;
            compose_editor_content_height: root.compose_editor_content_height;
            compose_editor_caret_x: root.compose_editor_caret_x;
            compose_editor_caret_y: root.compose_editor_caret_y;
            compose_editor_caret_height: root.compose_editor_caret_height;
            compose_bold_active: root.compose_bold_active;
            compose_italic_active: root.compose_italic_active;
            compose_underline_active: root.compose_underline_active;
            compose_strike_active: root.compose_strike_active;
            compose_code_active: root.compose_code_active;
            compose_active_link_url: root.compose_active_link_url;
            close_compose => { root.close_compose(); }
            save_compose(account-id, to, cc, bcc, subject, body, send-now) => {
                root.save_compose(account-id, to, cc, bcc, subject, body, send-now);
            }
            pick_compose_attachments => { root.pick_compose_attachments(); }
            remove_compose_attachment(index) => { root.remove_compose_attachment(index); }
            format_compose(kind, body, anchor, cursor) => {
                root.format_compose(kind, body, anchor, cursor);
            }
            link_compose(url, body, anchor, cursor) => {
                root.link_compose(url, body, anchor, cursor);
            }
            edit_compose_body(body, anchor, cursor) => { root.edit_compose_body(body, anchor, cursor); }
            update_compose_selection(anchor, cursor) => { root.update_compose_selection(anchor, cursor); }
            compose_history(direction) => { root.compose_history(direction); }
            compose_editor_pointer_event(x, y, kind, control, shift, alt, meta) => {
                root.compose_editor_pointer_event(x, y, kind, control, shift, alt, meta);
            }
            compose_editor_key_event(key, control, shift, alt, meta) => {
                root.compose_editor_key_event(key, control, shift, alt, meta)
            }
            compose_editor_layout_changed => { root.compose_editor_layout_changed(); }
            search_compose_contacts(query, account-id) => { root.search_compose_contacts(query, account-id); }
            select_compose_contact(index, recipients) => root.select_compose_contact(index, recipients);
        }

        // The rail width comes from the shared workspace geometry. Its hover label is
        // rendered here, above the adjacent workspace, so it can extend right
        // of the icon without being clipped by the rail component.
        Rectangle {
            visible: !root.compact-layout && product-rail.tooltip-text != "";
            x: LayoutMetrics.product-rail-width + 6px;
            y: product-rail.tooltip-y;
            width: rail-tooltip-label.preferred-width + 16px;
            height: 28px;
            border-radius: 5px;
            background: #292929;
            z: 10000;

            rail-tooltip-label := Text {
                text: product-rail.tooltip-text;
                color: white;
                font-size: TypeScale.secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    if root.folder-dialog-open : FolderDialog {
        x: root.safe-area-insets.left;
        y: root.safe-area-insets.top;
        width: root.width - root.safe-area-insets.left - root.safe-area-insets.right;
        height: root.height - root.safe-area-insets.top - root.safe-area-insets.bottom;
        z: 15000;
        mode: root.folder-dialog-mode;
        item-kind: root.folder-dialog-item-kind;
        name <=> root.folder-dialog-name;
        parent-name: root.folder-dialog-parent-name;
        surface-color: root.surface;
        raised-color: root.control-bg;
        ui-border-color: root.border;
        accent-color: root.accent;
        title-color: root.title-color;
        body-color: root.body-text;
        muted-color: root.muted-text;
        cancel => { root.folder-dialog-open = false; }
        submit(name) => {
            root.folder-dialog-open = false;
            if (root.folder-dialog-item-kind == "label") {
                root.save_mail_label(root.folder-dialog-folder-id, name, root.folder-dialog-label-color);
            } else if (root.folder-dialog-mode == "create") {
                root.create-folder(root.folder-dialog-account-id, root.folder-dialog-parent-id, name);
            } else {
                root.rename-folder(root.folder-dialog-folder-id, name);
            }
        }
        confirm-delete => {
            root.folder-dialog-open = false;
            if (root.folder-dialog-item-kind == "label") {
                root.delete_mail_label(root.folder-dialog-folder-id);
            } else {
                root.delete-folder(root.folder-dialog-folder-id);
            }
        }
    }

    // Slint conditional elements are instantiated lazily. The comparatively
    // large onboarding form is unnecessary on normal launches with an account.
    if root.startup_ready && root.connected_accounts.length == 0 : OnboardingView {
        x: root.safe-area-insets.left;
        y: root.safe-area-insets.top;
        width: root.width - root.safe-area-insets.left - root.safe-area-insets.right;
        height: root.height - root.safe-area-insets.top - root.safe-area-insets.bottom;
        startup-ready: root.startup_ready;
        account-setup-in-progress: root.account_setup_in_progress;
        oauth-in-progress: root.oauth_in_progress;
        oauth-settings-saving: root.oauth_settings_saving;
        oauth-settings-error <=> root.oauth_settings_error;
        google-available: root.google_oauth_available;
        microsoft-available: root.microsoft_oauth_available;
        google-bundled: root.google_oauth_bundled;
        microsoft-bundled: root.microsoft_oauth_bundled;
        google-client-id: root.google_client_id;
        google-client-secret: root.google_client_secret;
        ms-client-id: root.ms_client_id;
        oauth-setup-open <=> root.oauth_setup_open;
        save-oauth-apps(google-id, google-secret, microsoft-id) => {
            root.save_oauth_apps(google-id, google-secret, microsoft-id);
        }
        status: root.sync_status;
        page-bg: root.page-bg;
        surface: root.surface;
        hover-surface: root.muted-control-bg;
        title-color: root.title-color;
        body-text: root.body-text;
        muted-text: root.muted-text;
        ui-border: root.border;
        account-email <=> root.account_email;
        account-password <=> root.account_password;
        account-protocol <=> root.account_protocol;
        jmap-url <=> root.jmap_url;
        imap-security <=> root.imap_security;
        smtp-security <=> root.smtp_security;
        trusted-certificate-pem <=> root.trusted_certificate_pem;
        account-username <=> root.account_username;
        oauth-authorization-url: root.oauth_authorization_url;
        oauth-browser-error: root.oauth_browser_error;
        retry-oauth-browser => { root.retry_oauth_browser(); }
        copy-oauth-link => { root.copy_oauth_link(); }
        import-mail-certificate => { root.import_mail_certificate(); }
        imap-host <=> root.imap_host;
        imap-port <=> root.imap_port;
        smtp-host <=> root.smtp_host;
        smtp-port <=> root.smtp_port;
        add-password-account(protocol, email, username, password, jmap-url, imap-host, imap-port, smtp-host, smtp-port) => {
            root.add_password_account(protocol, email, username, password, jmap-url, imap-host, imap-port, smtp-host, smtp-port);
        }
        start-oauth(provider) => {
            root.connect_calendar_on_add = false;
            root.start_oauth(provider);
        }
        cancel-oauth => { root.cancel_oauth(); }
        import-account-backup => {
            root.import_account_backup();
            if (root.connected_accounts.length > 0) {
                root.settings_tab = "Accounts";
                root.settings_open = true;
            }
        }
    }

    // Keep the progressively painted shell inert until its callbacks have a
    // core behind them. This disappears as soon as the first page lands.
    if !root.startup_ready : TouchArea {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        z: 20000;
    }

    if root.startup_failed : Rectangle {
        x: root.safe-area-insets.left;
        y: root.safe-area-insets.top;
        width: root.width - root.safe-area-insets.left - root.safe-area-insets.right;
        height: root.height - root.safe-area-insets.top - root.safe-area-insets.bottom;
        background: root.page-bg;
        z: 30000;

        startup-card := Rectangle {
            width: 460px.min(parent.width - 32px);
            height: 330px.min(parent.height - 32px);
            private property <bool> cramped: parent.height < 420px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 12px;
            border-width: 1px;
            border-color: root.border;
            background: root.surface;
            accessible-role: groupbox;
            accessible-label: @tr("Mailbox startup failed");

            VerticalLayout {
                padding: parent.cramped ? 12px : 24px;
                spacing: parent.cramped ? 8px : 12px;
                Text {
                    text: @tr("Flectar Mail could not open local storage");
                    color: root.title-color;
                    font-size: TypeScale.heading;
                    font-weight: 700;
                    wrap: word-wrap;
                }
                Text {
                    text: root.startup_error;
                    color: root.body-text;
                    font-size: TypeScale.body;
                    wrap: word-wrap;
                }
                Text {
                    text: @tr("Diagnostic ID: {}", root.startup_diagnostic_id);
                    color: root.muted-text;
                    font-size: TypeScale.secondary;
                    accessible-label: @tr("Diagnostic ID {}", root.startup_diagnostic_id);
                }
                Rectangle { vertical-stretch: 1; }
                Button {
                    height: root.height - root.safe-area-insets.top - root.safe-area-insets.bottom < 420px ? 44px : 48px;
                    text: @tr("Retry");
                    primary: true;
                    clicked => {
                        root.retry-startup();
                    }
                }
                Button {
                    height: root.height - root.safe-area-insets.top - root.safe-area-insets.bottom < 420px ? 44px : 48px;
                    text: @tr("Copy diagnostics");
                    clicked => {
                        diagnostic-copy.text = root.diagnostics_text;
                        diagnostic-copy.select-all();
                        diagnostic-copy.copy();
                    }
                }
            }

            // Slint's native text input is the cross-platform clipboard bridge.
            diagnostic-copy := TextInput {
                width: 1px;
                height: 1px;
                opacity: 0;
            }
        }
    }
    AttachmentPreviewDialog {
        x: root.safe-area-insets.left; y: root.safe-area-insets.top;
        width: root.width - root.safe-area-insets.left - root.safe-area-insets.right;
        height: root.height - root.safe-area-insets.top - root.safe-area-insets.bottom;
        compact: root.compact-layout;
    }

    OpenPgpReader { width: parent.width; height: parent.height; }

}
