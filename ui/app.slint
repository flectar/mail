        if (key == "Local contact storage is still starting…") { return @tr("Local contact storage is still starting…"); }
        if (key == "Loading contacts…") { return @tr("Loading contacts…"); }
        return "";
    }

    ui-message-calendar(key, argument, second-argument, third-argument) => {
        if (key == "Could not load calendar: {}") { return @tr("Could not load calendar: {}", argument); }
        if (key == "Calendar shown and syncing.") { return @tr("Calendar shown and syncing."); }
        if (key == "Calendar hidden and sync paused.") { return @tr("Calendar hidden and sync paused."); }
