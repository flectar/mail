    in-out property <int> caldav_account_id: -1;
    in-out property <string> caldav_url: "";
    in-out property <string> caldav_username: "";
    in-out property <string> caldav_password: "";
    in-out property <string> imap_security: "auto";
    in-out property <string> smtp_security: "auto";
    in-out property <string> trusted_certificate_pem;
    in property <string> oauth_authorization_url;
    in property <bool> oauth_browser_error;
    callback retry_oauth_browser();
    callback copy_oauth_link();
    callback copy_oauth_authorization_url();
    copy_oauth_authorization_url => {
        if root.oauth_in_progress && root.oauth_authorization_url != "" {
            oauth-clipboard.text = root.oauth_authorization_url;
            oauth-clipboard.select-all();
            oauth-clipboard.copy();
        }
    }
    oauth-clipboard := TextInput {
        x: -10000px; y: -10000px; width: 1px; height: 1px;
        visible: false; enabled: false; read-only: true;
        accessible-role: none;
    }

    callback import_mail_certificate();
    in-out property <string> imap_host: "";
    in-out property <string> imap_port: "993";
    in-out property <string> smtp_host: "";
    in-out property <string> smtp_port: "465";
    in-out property <string> google_client_id: "";
    in-out property <string> google_client_secret: "";
    in-out property <string> ms_client_id: "";
    in-out property <bool> custom_oauth_open: false;
    in property <bool> custom_oauth_configured: false;
    in property <bool> google_oauth_available: false;
    in property <bool> microsoft_oauth_available: false;
    in-out property <bool> oauth_setup_open: false;
    in property <bool> oauth_settings_saving: false;
    in-out property <string> oauth_settings_error: "";
    in property <bool> google_oauth_bundled: false;
    in property <bool> microsoft_oauth_bundled: false;
    // Android/iOS must use their native print frameworks; until those hosts
    // provide one, do not expose the desktop file:// printing fallback.
    in property <bool> print_supported: true;
    in property <bool> document_apis_supported: true;

    // Neutral, low-chrome surfaces keep the message content visually primary.
    // Interactive controls come from Slint's desktop widget set.
    private property <bool> dark-mode: root.theme_mode == "dark" ? true
        : root.theme_mode == "light" ? false
        : Palette.color-scheme == ColorScheme.dark;
    private property <color> page-bg: AppTheme.page-bg;
    private property <color> surface: AppTheme.surface;
    private property <color> surface-raised: AppTheme.surface-raised;
    private property <color> sidebar-bg: AppTheme.sidebar-bg;
    private property <color> control-bg: AppTheme.control-bg;
    private property <color> muted-control-bg: AppTheme.muted-control-bg;
    private property <color> accent: AppTheme.accent;
    private property <color> accent-soft: AppTheme.accent-soft;
    private property <color> accent-pale: AppTheme.accent-pale;
    private property <color> selected-row: AppTheme.selected-row;
    private property <color> avatar-bg: AppTheme.avatar-bg;
    private property <color> avatar-selected-bg: AppTheme.avatar-selected-bg;
    private property <color> border: AppTheme.border;
    private property <color> border-subtle: AppTheme.border-subtle;
    private property <color> title-color: AppTheme.title;
    private property <color> heading: AppTheme.heading;
    private property <color> body-text: AppTheme.body;
    private property <color> secondary-text: AppTheme.secondary;
    private property <color> muted-text: AppTheme.muted;
    private property <color> faint-text: AppTheme.faint;
    // This content-driven breakpoint is the smallest width that can hold the
    // rail, folders, message list, and a useful reading pane simultaneously.
    private property <bool> compact-layout: root.width - root.safe-area-insets.left - root.safe-area-insets.right < 980px;
    private property <bool> compact-primary-nav-visible: root.compact-layout
        && !root.compose_open && !root.calendar_editor_open
        && !(root.active_view == "mail" && mail-view.compact-page == "message")
        && !(root.active_view == "contacts" && contacts-view.detail-page-visible)
        && !(root.active_view == "files" && FilesUi.preview-open);
    private property <length> compact-primary-nav-height: LayoutMetrics.compact-navigation-height;
    private property <bool> folder-dialog-open: false;
    private property <string> folder-dialog-item-kind: "folder";
    private property <string> folder-dialog-mode: "create";
    private property <int> folder-dialog-account-id: -1;
    private property <int> folder-dialog-folder-id: -1;
    private property <int> folder-dialog-parent-id: -1;
    private property <string> folder-dialog-parent-name: "";
    private property <string> folder-dialog-name: "";
    private property <color> folder-dialog-label-color: transparent;

    function open-folder-create(account-id: int, parent-id: int, parent-name: string) {
        root.folder-dialog-item-kind = "folder";
        root.folder-dialog-mode = "create";
        root.folder-dialog-account-id = account-id;
        root.folder-dialog-parent-id = parent-id;
        root.folder-dialog-parent-name = parent-name;
        root.folder-dialog-name = "";
        root.folder-dialog-open = true;
    }

    function open-folder-rename(folder-id: int, name: string) {
        root.folder-dialog-item-kind = "folder";
        root.folder-dialog-mode = "rename";
        root.folder-dialog-folder-id = folder-id;
        root.folder-dialog-parent-name = "";
        root.folder-dialog-name = name;
        root.folder-dialog-open = true;
    }

    function open-folder-delete(folder-id: int, name: string) {
        root.folder-dialog-item-kind = "folder";
        root.folder-dialog-mode = "delete";
        root.folder-dialog-folder-id = folder-id;
        root.folder-dialog-parent-name = "";
        root.folder-dialog-name = name;
        root.folder-dialog-open = true;
    }

    function open-label-rename(label-id: int, name: string, color: color) {
        root.folder-dialog-item-kind = "label";
        root.folder-dialog-mode = "rename";
        root.folder-dialog-folder-id = label-id;
        root.folder-dialog-name = name;
        root.folder-dialog-label-color = color;
        root.folder-dialog-open = true;
    }

    function open-label-delete(label-id: int, name: string) {
        root.folder-dialog-item-kind = "label";
        root.folder-dialog-mode = "delete";
        root.folder-dialog-folder-id = label-id;
        root.folder-dialog-name = name;
        root.folder-dialog-open = true;
    }

    system-back-requested => {
        if MailAttachments.open { MailAttachments.command("close", ""); return true; }
        if root.active_view == "files" && FilesUi.transfers-open {FilesUi.transfers-open=false;return true;}
        if root.active_view == "files" && FilesUi.dialog != "" { FilesUi.dialog = ""; return true; }
        if root.active_view == "files" && files-view.close-navigation() { return true; }
        if root.active_view == "files" && FilesUi.preview-open { FilesUi.preview-open = false; if FilesUi.busy { FilesUi.command("cancel", "", ""); } FilesUi.command("release-preview", "", ""); return true; }
        if root.active_view == "files" && FilesUi.can-up && !FilesUi.busy { FilesUi.command("up", "", ""); return true; }
        if (root.folder-dialog-open) {
            root.folder-dialog-open = false;
            return true;
        }
        if (!root.compact-layout) {
            return false;
        }
        if (root.compose_open) {
            compose-dialog.back-requested();
            return true;
        }
        if (root.calendar_editor_open) {
            root.calendar_editor_open = false;
            return true;
        }
        if (root.settings_open) {
            root.settings_open = false;
            return true;
        }
        if (root.active_view == "mail" && mail-view.folders-open) {
            mail-view.folders-open = false;
            return true;
        }
        if (root.active_view == "mail" && mail-view.compact-page == "message") {
            mail-view.compact-page = "list";
            root.close_preview();
            return true;
        }
        if (root.active_view == "contacts" && contacts-view.detail-page-visible) {
            contacts-view.detail-page-visible = false;
            return true;
        }
        return false;
    }

    changed theme-mode => {
        Palette.color-scheme = root.theme-mode == "dark" ? ColorScheme.dark
            : root.theme-mode == "light" ? ColorScheme.light
            : ColorScheme.unknown;
    }

    Rectangle {
        // Paint the useful application chrome immediately. Data models hydrate
        // in the background; first-run onboarding replaces this shell only
        // after the account query has completed.
        visible: !root.startup_ready || root.connected_accounts.length > 0;
        x: root.safe-area-insets.left;
        y: root.safe-area-insets.top;
        width: root.width - root.safe-area-insets.left - root.safe-area-insets.right;
        height: root.height - root.safe-area-insets.top - root.safe-area-insets.bottom;
        background: root.page-bg;

        product-rail := ProductRail {
            visible: !root.compact-layout;
            x: 0px;
            y: 0px;
            width: LayoutMetrics.product-rail-width;
            height: parent.height;
            active-view <=> root.active_view;
            settings-active: root.settings_open;
            background-color: root.sidebar-bg;
            divider-color: root.border;
            accent-color: root.accent;
            accent-background: root.accent-soft;
            title-color: root.title-color;
            muted-color: root.muted-text;
            open-settings => { root.toggle_settings(); }
            select-view(view) => {
                root.active_view = view;
                root.settings_open = false;
                if (view == "contacts") { root.load-contacts(); }
                if (view == "files") { FilesUi.command("load", "", ""); }
            }
        }

        WorkspaceFrame {
            visible: root.active_view == "mail";
            compact: root.compact-layout;
            reserve-compact-navigation: root.compact-primary-nav-visible;
            available-width: parent.width;
            available-height: parent.height;

        mail-view := MailView {
            loading: !root.startup_hydrated || root.mail_page_loading;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            compact: root.compact-layout;
            layout-mode: root.workspace_layout;
            show-avatars: root.show_avatars;
            emails: root.emails;
            sidebar_rows: root.sidebar_rows;
            mail_labels: root.mail_labels;
            mail_label_results: root.mail_label_results;
            selected_mail_label_count: root.selected_mail_label_count;
            email_tiles: root.email_tiles;
            email_links: root.email_links;
            active_view: root.active_view;
            selected_scope: root.selected_scope;
            selected_scope_title: root.selected_scope_title;
            unified_count: root.unified_count;
            total_count: root.total_count;
            search_query: root.search_query;
            search_filter: root.search_filter;
            list_status: root.startup_ready ? root.list_status : I18n.loading-local-data();
            selected_sender: root.selected_sender;
            selected_address: root.selected_address;
            selected_subject: root.selected_subject;
            selected_time: root.selected_time;
            selected_to: root.selected_to;
            selected_label: root.selected_label;
            selected_is_draft: root.selected_is_draft;
            selected_initials: root.selected_initials;
            selected_favicon: root.selected_favicon;
            selected_has_favicon: root.selected_has_favicon;
            selected_plain_text: root.selected_plain_text;
            selected_source: root.selected_source;
            selected_text: root.selected_text;
            has_selection: root.has_selection;
            clipboard_request: root.clipboard_request;
            clipboard_request_id: root.clipboard_request_id;
            sync_in_progress: root.sync_in_progress;
            can_load_more: root.can_load_more;
            loading_more: root.mail_loading_more;
            list_content_revision: root.mail_list_revision;
            selection-count: root.mail_selection_count;
            has_selected: root.startup_ready && root.has_selected;
            previous-email-id: root.previous_email_id;
            next-email-id: root.next_email_id;
            selected_starred: root.selected_starred;
            selected_unread: root.selected_unread;
            selected_sender_verification: root.selected_sender_verification;
            remote-images-blocked: root.remote-images-blocked;
            monochrome_sidebar_icons: root.monochrome_sidebar_icons;
            print_supported: root.print_supported;
            mail_sidebar_collapsed <=> root.mail_sidebar_collapsed;
            text_mode <=> root.text_mode;
            source_mode <=> root.source_mode;
            rendering_info_open <=> root.rendering_info_open;
            email-content-aspect <=> root.email-content-aspect;
            email-scroll-y <=> root.email-scroll-y;
            settings_open <=> root.settings_open;
            settings_tab <=> root.settings_tab;
            accent: root.accent;
            accent-soft: root.accent-soft;
            avatar-bg: root.avatar-bg;
            avatar-selected-bg: root.avatar-selected-bg;
            body-text: root.body-text;
            border: root.border;
            border-subtle: root.border-subtle;
            control-bg: root.control-bg;
            faint-text: root.faint-text;
            heading: root.heading;
            muted-control-bg: root.muted-control-bg;
            muted-text: root.muted-text;
            secondary-text: root.secondary-text;
            selected-row: root.selected-row;
            sidebar-bg: root.sidebar-bg;
            surface: root.surface;
            surface-raised: root.surface-raised;
            title-color: root.title-color;
            select_email(id) => { root.select_email(id); }
            search_changed(query) => { root.search_changed(query); }
            set_search_filter(filter) => { root.set_search_filter(filter); }
            select_scope(scope) => { root.select_scope(scope); }
            toggle_sidebar_section(key, open) => { root.toggle_sidebar_section(key, open); }
            toggle_folder(id, expanded) => { root.toggle_folder(id, expanded); }
            request_folder_create(account-id, parent-id, parent-name) => { root.open-folder-create(account-id, parent-id, parent-name); }
            request_folder_rename(id, name) => { root.open-folder-rename(id, name); }
            request_folder_delete(id, name) => { root.open-folder-delete(id, name); }
            request_label_rename(id, name, color) => { root.open-label-rename(id, name, color); }
            request_label_delete(id, name) => { root.open-label-delete(id, name); }
            load_more => { root.load_more(); }
            sync_mail => { root.sync_mail(); }
            message_action(action) => { root.message_action(action); }
            message_action_for_email(id, action) => { root.message_action_for_email(id, action); }
            set_email_checked(id, checked) => { root.set_email_checked(id, checked); }
            set_all_emails_checked(checked) => { root.set_all_emails_checked(checked); }
            toggle_mail_label(id, applied) => { root.toggle_mail_label(id, applied); }
            save_mail_label(id, name, color) => { root.save_mail_label(id, name, color); }
            search_mail_labels(query) => { root.search_mail_labels(query); }
            compose_message_action(action) => { root.compose_message_action(action); }
            close_preview => { root.close_preview(); }
            print_message => { root.print_message(); }
            open_message_in_browser => { root.open_message_in_browser(); }
            open_compose => { root.open_compose(); }
            open_email_link(url) => { root.open_email_link(url); }
            copy_email_status(status) => { root.copy_email_status(status); }
            email-pointer-event(x, y, kind, control, shift, alt, meta) => {
                root.email-pointer-event(x, y, kind, control, shift, alt, meta);
            }
            email-scroll(offset, viewport-height) => { root.email-scroll(offset, viewport-height); }
            email-key-event(text, pressed, repeat, control, shift, alt, meta) => {
                root.email-key-event(text, pressed, repeat, control, shift, alt, meta);
            }
            select-email-text => { root.select-email-text(); }
            load-remote-images-for-message => { root.load-remote-images-for-message(); }
        }
        }

        WorkspaceFrame {
            visible: root.active_view == "calendar";
            compact: root.compact-layout;
            reserve-compact-navigation: root.compact-primary-nav-visible;
            available-width: parent.width;
            available-height: parent.height;

        FunctionalCalendarView {
            active: root.active_view == "calendar";
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            compact: root.compact-layout;
            sidebar-collapsed <=> root.calendar_sidebar_collapsed;
