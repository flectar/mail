            selected-date-has-events: root.calendar_selected_date_has_events;
            view-mode: root.calendar_view_mode;
            background-color: root.page-bg;
            sidebar-color: root.sidebar-bg;
            surface-color: root.surface;
            ui-border-color: root.border;
            subtle-border-color: root.border-subtle;
            title-color: root.title-color;
            body-color: root.body-text;
            secondary-color: root.secondary-text;
            muted-color: root.muted-text;
            control-color: root.control-bg;
            control-hover-color: root.muted-control-bg;
            accent-color: root.accent;
            accent-background: root.accent-soft;
            navigate(scope, direction) => { root.calendar-navigate(scope, direction); }
            select-date(date) => { root.calendar-select-date(date); }
            set-view(mode) => { root.calendar-set-view(mode); }
            set-source-enabled(calendar-id, enabled) => { root.calendar-set-source-enabled(calendar-id, enabled); }
            today => { root.calendar-today(); }
            new-event => { root.calendar-open-editor(); }
            edit-event(event-id) => { root.calendar-edit-event(event-id); }
            delete-event(event-id) => { root.calendar-delete-event(event-id); }
            open-link(url) => { root.open_email_link(url); }
        }
        }

        WorkspaceFrame {
            visible: root.active_view == "contacts";
            compact: root.compact-layout;
            reserve-compact-navigation: root.compact-primary-nav-visible;
            available-width: parent.width;
            available-height: parent.height;

        contacts-view := ContactsView {
            active: root.active_view == "contacts";
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            compact: root.compact-layout;
            layout-mode: root.workspace_layout;
            dark-mode: root.dark-mode;
            sidebar-collapsed <=> root.contacts_sidebar_collapsed;
            contacts: root.contacts;
            sidebar-rows: root.contact_sidebar_rows;
            toggle-section(key, open) => { root.toggle-contact-section(key, open); }
            query: root.contact_search_query;
            filter: root.contact_scope == "Favorites" ? "favorites" : "all";
            selected-scope: root.contact_scope;
            scope-label: root.contact_scope_label;
            status: root.contact_save_status != "" ? root.contact_save_status
                : @tr("Showing {} of {} contacts", root.contact_shown_count, root.contact_visible_count);
            visible-count: root.contact_visible_count;
            can-load-more: root.contact_can_load_more;
            loading-more: root.contact_loading_more;
            content-revision: root.contact_list_revision;
            total-count: root.contact_total_count;
            favorite-count: root.contact_favorite_count;
            has-selected: root.contact_has_selection;
            selected-id <=> root.contact_id;
            edit-name <=> root.contact_name;
            edit-email <=> root.contact_email;
            edit-phone <=> root.contact_phone;
            edit-company <=> root.contact_company;
            edit-job-title <=> root.contact_job_title;
            edit-website <=> root.contact_website;
            edit-birthday <=> root.contact_birthday;
            edit-postal-address <=> root.contact_address;
            edit-notes <=> root.contact_notes;
            edit-tags <=> root.contact_tags;
            edit-favorite <=> root.contact_favorite;
            edit-initials: root.contact_initials;
            interaction-label: root.contact_interactions + (root.contact_last_interacted != "" ? " · " + root.contact_last_interacted : "");
            accent: root.accent;
            accent-soft: root.accent-soft;
            avatar-bg: root.avatar-bg;
            body-text: root.body-text;
            border: root.border;
            border-subtle: root.border-subtle;
            control-bg: root.control-bg;
            heading: root.heading;
            muted-control-bg: root.muted-control-bg;
            muted-text: root.muted-text;
            secondary-text: root.secondary-text;
            selected-row: root.selected-row;
            sidebar-bg: root.sidebar-bg;
            surface: root.surface;
            surface-raised: root.surface-raised;
            title-color: root.title-color;
            select-contact(id) => { root.select-contact(id); }
            search(query) => { root.search-contacts(query); }
            refresh => { root.load-contacts(); }
            load-more => { root.load-more-contacts(); }
            select-filter(filter) => {
                root.select-contact-scope(filter == "favorites" ? "Favorites"
                    : filter == "all" ? "All contacts" : filter);
            }
            new-contact => { root.new-contact(); }
            save-contact(id, name, email, phone, company, job-title, website, birthday, address, notes, tags, favorite) => {
                root.save-contact(
                    id, name, email, phone, company, job-title, website,
                    birthday, address, notes, tags, favorite
                );
            }
            delete-contact(id) => { root.delete-contact(id); }
            compose-to-contact(email) => {
                root.compose_to = email;
                root.open_compose();
            }
        }
        }

        WorkspaceFrame {
            visible: root.active_view == "files";
            compact: root.compact-layout;
            reserve-compact-navigation: root.compact-primary-nav-visible;
            available-width: parent.width;
            available-height: parent.height;
            files-view := FilesView { active: root.active_view == "files"; width: parent.width; height: parent.height; compact: root.compact-layout; layout-mode: root.workspace_layout; account-model: root.connected_accounts; }
        }

        CompactProductNav {
            visible: root.compact-primary-nav-visible;
            x: 0px;
            y: parent.height - root.compact-primary-nav-height;
            width: parent.width;
            height: root.compact-primary-nav-height;
            active-view <=> root.active_view;
            settings-active: root.settings_open;
            background-color: root.sidebar-bg;
            divider-color: root.border;
            accent-color: root.accent;
            accent-background: root.accent-soft;
            muted-color: root.muted-text;
            open-settings => { root.toggle_settings(); }
            select-view(view) => {
                root.active_view = view;
                root.settings_open = false;
                if (view == "contacts") { root.load-contacts(); }
                if (view == "files") { FilesUi.command("load", "", ""); }
            }
        }

