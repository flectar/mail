        if (key == "Event saved. Provider sync will run when enabled.") { return @tr("Event saved. Provider sync will run when enabled."); }
        return "";
    }

    ui-message-startup(key, argument, second-argument, third-argument) => {
        if (key == "Email resource render failed: {}") { return @tr("Email resource render failed: {}", argument); }
        if (key == "Message refresh failed: {}") { return @tr("Message refresh failed: {}", argument); }
        if (key == "Message load failed: {}") { return @tr("Message load failed: {}", argument); }
        if (key == "Your local mailbox could not be opened. No account operation was started. Retry, or copy the diagnostics for support.") { return @tr("Your local mailbox could not be opened. No account operation was started. Retry, or copy the diagnostics for support."); }
