// Keep the non-visual tray in its own Slint compilation unit. app.slint embeds
// the UI font; compiling a SystemTrayIcon alongside it makes Slint create
// a window adapter just to register that font, which leaks an empty 800x600
// "Slint Window" into Linux task switchers.
export component FlectarTray inherits SystemTrayIcon {
    in-out property <bool> enabled: false;
    // The unread mail the app icon counts, which Rust also draws on the icon
    // where the tray shows the app's own picture; 0 for none.
    in property <int> unread: 0;
    // Whether that counts conversations, as the mail list shows them, or
    // messages.
    in property <bool> conversations: false;
    // Linux trays list the item by its name, but macOS shows it as text
    // beside the menu bar icon, so Rust turns it off there and names the
    // item for VoiceOver itself.
    in property <bool> named: true;
    visible: root.enabled;
    // Rust sets the chosen icon's tray image from AppIcon.tray-image, which
    // explains the small size; this compilation unit cannot share globals
    // with app.slint.
    in property <image> image: @image-url("../resources/app-icon/flectar-mail-tray.png");
    icon: root.image;
    title: root.named ? @tr("Flectar Mail") : "";
    tooltip: root.unread == 0 ? @tr("Flectar Mail")
        : root.conversations ? @tr("Flectar Mail") + "\n" + @tr("{n} unread conversation" | "{n} unread conversations" % root.unread)
        : @tr("Flectar Mail") + "\n" + @tr("{n} unread message" | "{n} unread messages" % root.unread);

    callback show_window();
    callback quit_app();
    // Each time the tray turns on, for Rust to draw it, which it skips while
    // the tray is off, and to name the macOS menu bar item.
    callback shown();

    changed enabled => {
        if root.enabled {
            root.shown();
        }
    }

    clicked => { root.show_window(); }

    Menu {
        MenuItem {
            title: @tr("Show Flectar Mail");
            activated => { root.show_window(); }
        }
        MenuItem {
            title: @tr("Quit");
            activated => { root.quit_app(); }
        }
    }
}
