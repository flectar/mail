// The calendar the open message carries (src/invitation.rs): an invitation,
// its update or cancellation, or an answer to one.
export global Invitation {
    // The open message carries one.
    in property <bool> available;
    // What it asks: "request", "cancel", "reply", "counter",
    // "declinecounter", "publish" or "refresh".
    in property <string> kind;
    in property <string> title;
    // When it takes place, as the user reads dates, and the date on its
    // tile.
    in property <string> when;
    in property <string> tile-month;
    in property <string> tile-day;
    in property <string> location;
    in property <string> join-url;
    // Who organizes it, by name where the invitation gives one.
    in property <string> organizer;
    // For an answer: who answered, and how (a PARTSTAT).
    in property <string> answered-by;
    in property <string> their-answer;
    // The guest list: how many, and how many accepted.
    in property <int> guests;
    in property <int> accepted;
    // The first of the user's other events at the same time, and how many
    // more there are.
    in property <string> conflict;
    in property <int> more-conflicts;
    // The user's answer: "ACCEPTED", "TENTATIVE", "DECLINED" or "".
    in property <string> my-answer;
    // The user organizes the event.
    in property <bool> organized;
    // The user is on its guest list.
    in property <bool> invited;
    // The calendar has a later version of the event than this message.
    in property <bool> out-of-date;
    in property <bool> cancelled;
    // The message is in Spam or Trash, or from a blocked sender.
    in property <bool> kept-out;
    // The event is in the user's calendar.
    in property <bool> in-calendar;
    in property <bool> repeats;
    // The message is about one occurrence of a repeating event.
    in property <bool> occurrence;
    // The user can answer it here: an invitation to them, up to date,
    // that they don't organize.
    in property <bool> answerable;
    // A cancelled event still in the calendar, which the card can take
    // out of it.
    in property <bool> removable;
    // An answer or a removal is on its way.
    in property <bool> working;
    // Answer: "accepted", "tentative" or "declined".
    callback answer(string);
    // Take the cancelled event out of the calendar.
    callback remove();
    callback open-link(string);
    callback show-in-calendar();
}
