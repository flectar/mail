import { SavedSearchUi } from "../saved-searches.slint";
import { SidebarRowSurface, SidebarStyle } from "sidebar-row.slint";
import { AccountProblem, AccountStatus, MailDragApi } from "../models.slint";
import { AccountStatusPanel, AccountStatusText } from "account-status.slint";
import { ActivitySpinner } from "activity-spinner.slint";
import { Avatar } from "avatar.slint";
import { IconButton, LineEdit } from "controls.slint";
import { WorkspaceMiniHeading } from "workspace-layout.slint";
import { AppTheme, LayoutMetrics } from "../design-system.slint";
import { TypeScale } from "../typography.slint";
import { PopupMenu } from "popup-menu.slint";
import { Badge } from "badge.slint";

component SidebarIcon {
    in property <image> icon;
    in property <color> color;
    in property <length> icon-size: SidebarStyle.icon-size;

    width: SidebarStyle.icon-size;
    height: 28px;

    Image {
        x: (parent.width - root.icon-size) / 2;
        y: (parent.height - root.icon-size) / 2;
        width: root.icon-size;
        height: root.icon-size;
        source: root.icon;
        colorize: root.color;
        image-fit: contain;
        accessible-role: none;
    }
}

// A row's pointer area, which sits inside the row's ContextMenuArea so taps
// reach it first: on Android, Slint holds every press on a menu's own area to
// wait for a long press, which swallowed taps on the rows above it. A
// right-click opens the menu, and so does holding a finger still for half a
// second, as on Android and iOS.
component SidebarRowHit inherits TouchArea {
    in property <bool> menu-enabled;
    callback activated();
    callback open-menu(Point);
    private property <bool> holding: false;
    private property <bool> held: false;
    private property <length> hold-x;
    private property <length> hold-y;

    pointer-event(event) => {
        if event.kind == PointerEventKind.down {
            self.held = false;
            if event.button == PointerEventButton.right && root.menu-enabled {
                root.open-menu({ x: self.mouse-x, y: self.mouse-y });
            } else if event.button == PointerEventButton.left && event.touch-finger-id != 0 && root.menu-enabled {
                self.hold-x = self.mouse-x;
                self.hold-y = self.mouse-y;
                self.holding = true;
            }
        } else if event.kind == PointerEventKind.move {
            if self.holding && (abs(self.mouse-x - self.hold-x) > 8px || abs(self.mouse-y - self.hold-y) > 8px) {
                self.holding = false;
            }
        } else {
            self.holding = false;
        }
    }
    clicked => {
        // The finger that opened the menu lifts here; it was not a tap.
        if !self.held {
            root.activated();
        }
        self.held = false;
    }

    Timer {
        interval: 500ms;
        running: root.holding;
        triggered => {
            root.holding = false;
            root.held = true;
            root.open-menu({ x: root.hold-x, y: root.hold-y });
        }
    }
}

// A folder row is shared by unified and account sections so indentation,
// selection, hover, and counts remain consistent throughout the tree.
export component SidebarItem inherits SidebarRowSurface {
    in property <bool> interactive: true;
    in property <string> label;
    in property <string> accessible-name: root.label;
    in property <string> count;
    in property <string> scope;
    in property <image> icon;
    in property <bool> selected: false;
    in property <bool> label-has-emoji: false;
    in property <string> label-path: root.label;
    in property <length> row-height: SidebarStyle.row-height;
    in property <length> left-padding: SidebarStyle.icon-left;
    in property <int> account-id: -1;
    in property <int> folder-id: -1;
    in property <int> label-id: -1;
    in property <bool> has-children: false;
    in property <bool> expanded: true;
    in property <bool> label-tree-node: false;
    in property <bool> folder-menu-enabled: false;
    in property <bool> can-create-child: false;
    in property <bool> can-rename: false;
    in property <bool> can-delete: false;
    // The folder can be hidden from the sidebar (#253).
    in property <bool> can-hide: false;
    in property <bool> can-empty-trash: false;
    // The row lists unread mail that "Mark all as read…" can mark (#234).
    in property <bool> can-mark-all-read: false;
    in property <bool> label-manageable: false;
    in property <bool> label-can-create-child: false;
    // A Gmail label Gmail's label list shows, which can go under More, or
    // one it doesn't always show, which can show again (#253).
    in property <bool> label-can-hide: false;
    in property <bool> label-can-show: false;
    in property <bool> label-is-global: false;
    in property <string> label-account-name: "";
    in property <bool> mail-drop-enabled: false;
    in property <bool> mail-drop-copies: false;
    // A saved search, whose menu edits, moves and deletes it (#243). Its id
    // is `label-id`.
    in property <bool> saved-search: false;
    in property <color> sidebar-background;
    in property <color> selection-background;
    in property <color> accent-color;
    in property <color> body-color;
    in property <color> muted-color;
    in property <color> icon-color: muted-color;
    in property <color> editable-color: icon-color;
    callback clicked(string);
    callback toggled(int, bool);
    callback new-subfolder(int, int, string);
    callback rename-folder(int, string);
    callback delete-folder(int, string);
    callback hide-folder(int);
    callback empty-trash(int);
    // The row's scope and the name it shows.
    callback mark-all-read(string, string);
    callback new-child-label(int, int, string, string);
    callback rename-label(int, string, color, string, bool);
    callback delete-label(int, string, string, bool, bool);
    // Gmail's label list shows the label, or not (#253).
    callback set-label-listed(int, bool);

    height: root.visible ? root.row-height : 0px;
    idle-background: root.sidebar-background;
    active-background: root.selection-background;
    hovered: row-hit.has-hover;
    active: root.selected || mail-drop-target.has-drag;
    face-border-width: mail-drop-target.has-drag ? 2px : 0px;
    face-border-color: root.accent-color;

    SidebarIcon {
        x: root.left-padding;
        y: 0px;
        height: root.row-height;
        icon: root.icon;
        color: root.icon-color;
    }

    if root.has-children: Image {
        x: root.left-padding - 18px;
        y: (root.row-height - self.height) / 2;
        width: 12px;
        height: 12px;
        source: root.expanded
            ? @image-url("../icons/lucide/outline/chevron-down.svg")
            : @image-url("../icons/lucide/outline/chevron-right.svg");
        colorize: root.muted-color;
        image-fit: contain;
        accessible-role: none;
    }

    Text {
        x: root.left-padding + SidebarStyle.label-offset;
        y: 0px;
        width: max(0px, parent.width - self.x - (root.count == "" ? 6px : count-badge.width + 12px));
        height: root.row-height;
        text: root.label;
        color: root.body-color;
        font-size: SidebarStyle.label-size;
        font-weight: root.selected ? SidebarStyle.selected-weight : SidebarStyle.normal-weight;
        font-family: root.label-has-emoji ? "Noto Emoji" : "";
        vertical-alignment: center;
        overflow: elide;
    }

    // The unread count, in the accent on the selected row.
    count-badge := Badge {
        x: parent.width - self.width - 6px;
        y: (root.row-height - self.height) / 2;
        width: min(52px, self.preferred-width);
        visible: root.count != "";
        text: root.count;
        tone: root.selected ? "accent" : "neutral";
    }

    // Folder and label actions. Rows without any keep the area disabled.
    private property <bool> row-menu-enabled: root.interactive && (root.can-mark-all-read || root.folder-menu-enabled || root.can-hide || root.can-empty-trash || root.label-manageable || root.saved-search);

    Rectangle {
        width: parent.width;
        height: parent.height;
        row-menu := PopupMenu {
            label: root.accessible-name;
            entries: [
                { id: "mark-all-read", title: @tr("Mark all as read…"), hidden: !root.can-mark-all-read },
                { id: "new-subfolder", title: @tr("New subfolder"), group: 1, hidden: !root.folder-menu-enabled, disabled: !root.can-create-child },
                { id: "rename-folder", title: @tr("Rename folder"), group: 1, hidden: !root.folder-menu-enabled, disabled: !root.can-rename },
                { id: "hide-folder", title: @tr("Hide folder"), group: 1, hidden: !root.can-hide },
                { id: "delete-folder", title: @tr("Delete folder"), group: 1, hidden: !root.folder-menu-enabled, disabled: !root.can-delete },
                { id: "empty-trash", title: @tr("Empty Trash…"), group: 1, hidden: !root.can-empty-trash },
                { id: "new-label", title: @tr("New nested label"), group: 1, hidden: !(root.label-manageable && root.label-can-create-child) },
                {
                    id: "rename-label",
                    title: root.label-is-global ? @tr("Rename global label") : @tr("Rename label in {}", root.label-account-name),
                    group: 1,
                    hidden: !root.label-manageable,
                },
                { id: "show-label", title: @tr("Show label"), group: 1, hidden: !root.label-can-show },
                { id: "hide-label", title: @tr("Hide label"), group: 1, hidden: !root.label-can-hide },
                {
                    id: "delete-label",
                    title: root.label-is-global ? @tr("Delete global label") : @tr("Delete label from {}", root.label-account-name),
                    group: 1,
                    hidden: !root.label-manageable,
                },
                { id: "edit-search", title: @tr("Edit saved search…"), group: 1, hidden: !root.saved-search },
                { id: "search-up", title: @tr("Move up"), group: 1, hidden: !root.saved-search },
                { id: "search-down", title: @tr("Move down"), group: 1, hidden: !root.saved-search },
                { id: "delete-search", title: @tr("Delete saved search…"), group: 1, hidden: !root.saved-search },
            ];
            activated(id, index) => {
                if id == "mark-all-read" {
                    root.mark-all-read(root.scope, root.label);
                } else if id == "new-subfolder" {
                    root.new-subfolder(root.account-id, root.folder-id, root.label);
                } else if id == "rename-folder" {
                    root.rename-folder(root.folder-id, root.label);
                } else if id == "hide-folder" {
                    root.hide-folder(root.folder-id);
                } else if id == "delete-folder" {
                    root.delete-folder(root.folder-id, root.label);
                } else if id == "empty-trash" {
                    root.empty-trash(root.account-id);
                } else if id == "new-label" {
                    root.new-child-label(root.account-id, root.label-id, root.label-path, root.label-account-name);
                } else if id == "rename-label" {
                    root.rename-label(root.label-id, root.label-path, root.editable-color, root.label-account-name, root.label-is-global);
                } else if id == "show-label" {
                    root.set-label-listed(root.label-id, true);
                } else if id == "hide-label" {
                    root.set-label-listed(root.label-id, false);
                } else if id == "delete-label" {
                    root.delete-label(root.label-id, root.label-path, root.label-account-name, root.label-is-global, root.has-children);
                } else if id == "edit-search" {
                    SavedSearchUi.start-edit(root.label-id);
                } else if id == "search-up" {
                    SavedSearchUi.move(root.label-id, -1);
                } else if id == "search-down" {
                    SavedSearchUi.move(root.label-id, 1);
                } else if id == "delete-search" {
                    SavedSearchUi.start-delete(root.label-id);
                }
            }
        }

        row-hit := SidebarRowHit {
            enabled: root.interactive;
            menu-enabled: root.row-menu-enabled;
            accessible-role: button;
            accessible-label: root.accessible-name;
            accessible-checked: root.selected;
            accessible-action-default => { root.clicked(root.scope); }
            activated => { root.clicked(root.scope); }
            open-menu(position) => { row-menu.open-at(self.absolute-position.x + position.x, self.absolute-position.y + position.y, false); }
            mouse-cursor: pointer;
        }
    }

    if root.has-children: TouchArea {
        enabled: root.interactive;
        x: max(0px, root.left-padding - 22px);
        y: 0px;
        width: 22px;
        height: root.row-height;
        accessible-role: button;
        accessible-label: root.label-tree-node
            ? (root.expanded ? @tr("Collapse label") : @tr("Expand label"))
            : (root.expanded ? @tr("Collapse folder") : @tr("Expand folder"));
        accessible-expanded: root.expanded;
        accessible-action-default => {
            root.toggled(root.folder-id, !root.expanded);
        }
        clicked => { root.toggled(root.folder-id, !root.expanded); }
        mouse-cursor: pointer;
    }

    mail-drop-target := DropArea {
        width: parent.width;
        height: parent.height;
        enabled: root.interactive && root.mail-drop-enabled;
        can-drop(event) => {
            MailDragApi.can-drop-on-mailbox(
                event.data,
                root.scope,
                root.account-id,
                root.folder-id,
            ) ? (root.mail-drop-copies ? DragAction.copy : DragAction.move) : DragAction.none
        }
        dropped(event) => {
            if MailDragApi.drop-on-mailbox(
                event.data,
                root.scope,
                root.account-id,
                root.folder-id,
            ) {
                return root.mail-drop-copies ? DragAction.copy : DragAction.move;
            }
            return DragAction.none;
        }
    }
}

// Expansion belongs to the host model so recycled headers retain their state.
export component SidebarSectionHeader inherits SidebarRowSurface {
    in property <bool> interactive: true;
    in property <string> label;
    in property <string> detail;
    // A collapsed account shows the unread mail of the folders it hides.
    in property <string> count;
    in property <string> avatar;
    in property <image> avatar-image;
    in property <bool> has-avatar-image: false;
    in property <image> icon;
    in property <bool> has-avatar: false;
    // The account's avatar color (Avatar's color-tone).
    in property <int> avatar-tone: -1;
    in property <bool> open: true;
    in property <color> sidebar-background;
    in property <color> body-color;
    in property <color> muted-color;
    in property <color> icon-color;
    in property <int> label-font-weight: SidebarStyle.selected-weight;
    in property <length> left-padding: 4px;
    in property <bool> folder-row-style: false;
    // A phone's drawer passes rows a finger can hit.
    in property <length> row-height: SidebarStyle.row-height;
    // An account's heading offers that account's actions on right-click.
    in property <bool> account-menu: false;
    in property <bool> can-check-mail: true;
    // An account's checks: a spinner while one runs, and a button that
    // explains a problem that stops them.
    in property <AccountStatus> status;
    in property <bool> touch-mode: false;
    // Headers and children share the same icon and text columns. The leading
    // gutter belongs to disclosure controls, not to an extra icon indent.
    private property <length> icon-left: root.left-padding + SidebarStyle.icon-left - 4px;
    private property <length> label-left: root.icon-left + SidebarStyle.label-offset;
    private property <bool> marked: root.status.marked && root.status.problem != AccountProblem.none;
    private property <length> status-width: !(root.status.checking || root.marked) ? 0px
        : root.touch-mode ? LayoutMetrics.touch-target : 24px;
    private property <length> status-x: (root.count == "" ? root.width - 4px : count-badge.x - 2px) - root.status-width;
    private property <length> trailing: (root.count == "" ? 8px : count-badge.width + 12px) + root.status-width;
    private property <string> problem-title: AccountStatusText.problem(root.status.problem);
    private property <bool> status-from-keyboard: false;
    private property <string> last-checked: AccountStatusText.last-checked(root.status.checked_day, root.status.checked_at);
    private property <bool> waiting: root.status.problem == AccountProblem.waiting;
    // The menu's first line.
    private property <string> status-line: root.status.checking ? @tr("Checking for new mail…")
        : root.problem-title != "" ? root.problem-title : root.last-checked;
    callback toggled(bool);
    callback check-mail();
    callback account-settings();
    callback sign-in();

    height: root.folder-row-style || root.detail == "" ? root.row-height : 7px + max(20px, header-label.preferred-height) + header-detail.height;
    idle-background: root.sidebar-background;
    hovered: header-hit.has-hover;

    Image {
        x: root.left-padding;
        y: (parent.height - self.height) / 2;
        width: 12px;
        height: 12px;
        source: root.open
            ? @image-url("../icons/lucide/outline/chevron-down.svg")
            : @image-url("../icons/lucide/outline/chevron-right.svg");
        colorize: root.muted-color;
        image-fit: contain;
        accessible-role: none;
    }

    if root.has-avatar: Avatar {
        x: root.icon-left + (SidebarStyle.icon-size - self.width) / 2;
        y: (parent.height - self.height) / 2;
        size: 22px;
        source: root.avatar-image;
        has-source: root.has-avatar-image;
        fallback: root.avatar;
        color-tone: root.avatar-tone;
        background-color: root.has-avatar-image ? #ffffff : root.hover-background;
        foreground-color: root.body-color;
    }

    if !root.has-avatar: SidebarIcon {
        x: root.icon-left;
        y: (parent.height - self.height) / 2;
        height: 22px;
        icon: root.icon;
        color: root.icon-color;
    }

    header-label := Text {
        x: root.label-left;
        y: root.detail == "" ? 0px : 4px;
        width: parent.width - self.x - root.trailing;
        height: root.detail == "" ? parent.height : max(20px, self.preferred-height);
        text: root.label;
        color: root.body-color;
        font-size: SidebarStyle.label-size;
        font-weight: root.label-font-weight;
        vertical-alignment: center;
        overflow: elide;
    }

    header-detail := Text {
        visible: root.detail != "";
        x: root.label-left;
        y: header-label.y + header-label.height - 2px;
        width: parent.width - self.x - root.trailing;
        height: max(15px, self.preferred-height);
        text: root.detail;
        color: root.muted-color;
        font-size: TypeScale.caption;
        vertical-alignment: center;
        overflow: elide;
    }


    count-badge := Badge {
        x: parent.width - self.width - 6px;
        y: (parent.height - self.height) / 2;
        width: min(52px, self.preferred-width);
        visible: root.count != "";
        text: root.count;
    }

    private property <bool> heading-menu-enabled: root.interactive && root.account-menu;

    Rectangle {
        width: parent.width;
        height: parent.height;
        heading-menu := PopupMenu {
            label: root.label;
            // How the account's checks are going, then when it checks again while it
            // waits for the server, or its last complete check when another problem
            // stops them.
            entries: [
                { title: root.status-line, hidden: root.status-line == "", disabled: true },
                {
                    title: AccountStatusText.checks-again(root.status.resume_day, root.status.resume_at),
                    hidden: !(root.waiting && !root.status.checking && root.status.resume_at != ""),
                    disabled: true,
                },
                {
                    title: root.last-checked,
                    hidden: !(root.problem-title != "" && !root.waiting && !root.status.checking && root.last-checked != ""),
                    disabled: true,
                },
                { id: "check-mail", title: @tr("Check for new mail"), group: 1, disabled: !root.can-check-mail },
                { id: "account-settings", title: @tr("Account settings"), group: 1 },
            ];
            activated(id, index) => {
                if id == "check-mail" {
                    root.check-mail();
                } else if id == "account-settings" {
                    root.account-settings();
                }
            }
        }

        header-hit := SidebarRowHit {
            enabled: root.interactive;
            menu-enabled: root.heading-menu-enabled;
            accessible-role: button;
            accessible-label: root.label;
            accessible-description: root.status-line;
            accessible-expanded: root.open;
            accessible-action-default => {
                root.toggled(!root.open);
            }
            activated => {
                root.toggled(!root.open);
            }
            open-menu(position) => { heading-menu.open-at(self.absolute-position.x + position.x, self.absolute-position.y + position.y, false); }
            mouse-cursor: pointer;
        }
    }

    if root.status.checking : ActivitySpinner {
        x: root.status-x + (root.status-width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        color: root.muted-color;
    }

    // Above the row's own pointer area, so it takes its clicks.
    if root.marked && !root.status.checking : IconButton {
        x: root.status-x;
        y: (parent.height - self.height) / 2;
        width: root.status-width;
        height: min(root.status-width, parent.height);
        icon: root.waiting
            ? @image-url("../icons/lucide/outline/history.svg")
            : @image-url("../icons/lucide/outline/alert-circle.svg");
        icon-size: 16px;
        icon-color: root.waiting ? root.muted-color : AppTheme.destructive;
        hover-background: AppTheme.muted-control-bg;
        tooltip-text: root.problem-title;
        clicked => {
            root.status-from-keyboard = self.focus-visible;
            status-popup.show();
        }
    }

    status-popup := PopupWindow {
        x: 4px;
        y: root.height + 2px;
        // On a desktop it may reach over the message list; in a phone drawer
        // it stays inside the drawer.
        width: root.touch-mode ? root.width - 8px : max(300px, root.width - 8px);
        height: status-panel.preferred-height;
        close-policy: close-on-click-outside;
        forward-focus: popup-keys;
        // Opened from the keyboard, focus goes on to the fixing action.
        init => {
            if root.status-from-keyboard {
                status-panel.focus-action();
            }
        }

        popup-keys := FocusScope {
            key-pressed(event) => {
                if event.text == Key.Escape {
                    status-popup.close();
                    return accept;
                }
                reject
            }

            status-panel := AccountStatusPanel {
                status: root.status;
                can-check-mail: root.can-check-mail;
                touch: root.touch-mode;
                check-mail => {
                    status-popup.close();
                    root.check-mail();
                }
                sign-in => {
                    status-popup.close();
                    root.sign-in();
                }
                account-settings => {
                    status-popup.close();
                    root.account-settings();
                }
            }
        }
    }
}

// A group's label over its rows, in small capitals. A group after
// another one keeps `SidebarStyle.group-gap` above its label. An action, such
// as adding an account, sits at its end.
export component SidebarGroupLabel inherits Rectangle {
    in property <string> label;
    in property <color> label-color: AppTheme.secondary;
    in property <bool> first: false;
    in property <bool> has-action: false;
    in property <image> action-icon: @image-url("../icons/lucide/outline/plus.svg");
    in property <string> action-tooltip;
    callback action();

    height: (root.first ? 0px : SidebarStyle.group-gap) + SidebarStyle.group-label-height;

    Text {
        x: 0px;
        y: parent.height - SidebarStyle.group-label-height;
        width: parent.width - (root.has-action ? 28px : 0px);
        height: SidebarStyle.group-label-height - SidebarStyle.group-label-below;
        text: root.label;
        color: root.label-color;
        font-size: TypeScale.overline;
        font-weight: 600;
        letter-spacing: 0.6px;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }

    if root.has-action : IconButton {
        x: parent.width - self.width;
        y: parent.height - SidebarStyle.group-label-height + (SidebarStyle.group-label-height - SidebarStyle.group-label-below - self.height) / 2;
        width: 24px;
        height: 24px;
        icon: root.action-icon;
        icon-size: 16px;
        icon-color: AppTheme.secondary;
        tooltip-text: root.action-tooltip;
        clicked => { root.action(); }
    }
}

// The search under a sidebar's main button, or at its head: Mail's folder
// finder and Settings' search are this one field.
export component SidebarSearch inherits Rectangle {
    in-out property <string> query;
    in property <string> placeholder;
    in property <string> clear-tooltip;
    in property <color> muted-color: AppTheme.muted;
    in property <color> hover-background: AppTheme.muted-control-bg;
    callback edited(string);

    height: LayoutMetrics.small-control-height;

    LineEdit {
        width: parent.width;
        height: parent.height;
        outlined: false;
        filled: true;
        text <=> root.query;
        placeholder-text: root.placeholder;
        input-label: root.placeholder;
        show-leading-icon: true;
        leading-icon: @image-url("../icons/lucide/outline/search.svg");
        leading-icon-color: root.muted-color;
        trailing-content-width: root.query == "" ? 0px : 32px;
        edited(value) => { root.edited(value); }
    }

    if root.query != "" : IconButton {
        x: parent.width - 32px;
        width: 32px;
        height: parent.height;
        icon: @image-url("../icons/lucide/outline/x.svg");
        icon-size: 14px;
        icon-color: root.muted-color;
        hover-background: root.hover-background;
        tooltip-text: root.clear-tooltip;
        clicked => {
            root.query = "";
            root.edited("");
        }
    }
}

// An account's name over its rows where they don't fold: Calendar's
// accounts. It lines up with SidebarSectionHeader's avatar, name and address.
export component SidebarAccountHeading inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <string> avatar;
    in property <image> avatar-image;
    in property <bool> has-avatar-image: false;
    in property <int> avatar-tone: -1;
    in property <color> body-color: AppTheme.body;
    in property <color> muted-color: AppTheme.muted;
    in property <color> avatar-background: AppTheme.muted-control-bg;
    private property <length> icon-left: SidebarStyle.icon-left;
    private property <length> label-left: root.icon-left + SidebarStyle.label-offset;

    height: root.detail == "" ? SidebarStyle.row-height : 7px + max(20px, heading-label.preferred-height) + heading-detail.height;

    Avatar {
        x: root.icon-left + (SidebarStyle.icon-size - self.width) / 2;
        y: (parent.height - self.height) / 2;
        size: 22px;
        source: root.avatar-image;
        has-source: root.has-avatar-image;
        fallback: root.avatar;
        color-tone: root.avatar-tone;
        background-color: root.has-avatar-image ? #ffffff : root.avatar-background;
        foreground-color: root.body-color;
    }

    heading-label := Text {
        x: root.label-left;
        y: root.detail == "" ? 0px : 4px;
        width: parent.width - self.x - 8px;
        height: root.detail == "" ? parent.height : max(20px, self.preferred-height);
        text: root.label;
        color: root.body-color;
        font-size: SidebarStyle.label-size;
        font-weight: SidebarStyle.selected-weight;
        vertical-alignment: center;
        overflow: elide;
    }

    heading-detail := Text {
        visible: root.detail != "";
        x: root.label-left;
        y: heading-label.y + heading-label.height - 2px;
        width: parent.width - self.x - 8px;
        height: max(15px, self.preferred-height);
        text: root.detail;
        color: root.muted-color;
        font-size: TypeScale.caption;
        vertical-alignment: center;
        overflow: elide;
    }
}

// A calendar's show and hide in the sidebar: a check box in the calendar's
// own color, sized and rounded like the app's CheckBox. Its row owns the
// pointer area and the accessible check box.
export component SidebarColorToggle inherits Rectangle {
    in property <color> calendar-color;
    in property <bool> checked: true;

    width: SidebarStyle.icon-size;
    height: SidebarStyle.icon-size;

    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: max(2px, LayoutMetrics.corner-base * 0.4);
        background: root.checked ? root.calendar-color : transparent;
        border-width: root.checked ? 0px : 1.5px;
        border-color: root.calendar-color;

        if root.checked : Image {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 12px;
            height: 12px;
            source: @image-url("../icons/lucide/outline/check.svg");
            colorize: white;
            image-fit: contain;
            accessible-role: none;
        }
    }
}

// The foot of a phone drawer. Phones have no rail, so Settings stays here,
// below the drawer's list however far it scrolls.
export component DrawerSettingsItem inherits VerticalLayout {
    in property <color> background-color: AppTheme.sidebar-bg;
    in property <color> selection-background: AppTheme.accent-soft;
    in property <color> accent-color: AppTheme.accent;
    in property <color> body-color: AppTheme.body;
    in property <color> muted-color: AppTheme.muted;
    in property <color> divider-color: AppTheme.border;
    // Lines the divider up with the drawer's own inset content.
    in property <length> divider-inset: 0px;
    callback clicked;

    padding-bottom: 8px;
    spacing: 4px;

    HorizontalLayout {
        padding-left: root.divider-inset;
        padding-right: root.divider-inset;
        Rectangle {
            height: 1px;
            background: root.divider-color;
        }
    }

    SidebarItem {
        label: @tr("Settings");
        icon: @image-url("../icons/lucide/filled/gear.svg");
        row-height: LayoutMetrics.touch-target;
        sidebar-background: root.background-color;
        selection-background: root.selection-background;
        accent-color: root.accent-color;
        body-color: root.body-color;
        muted-color: root.muted-color;
        clicked => { root.clicked(); }
    }
}
