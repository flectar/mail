import { AppTheme, LayoutMetrics } from "../design-system.slint";
import { TypeScale } from "../typography.slint";
import { Invitation } from "../invitation.slint";
import { Button } from "button.slint";
import { ToolbarIconButton } from "controls.slint";

// A sentence under the event, with an icon at its first line.
component CardNote inherits HorizontalLayout {
    in property <image> icon;
    in property <color> tint: AppTheme.secondary;
    in property <string> text;
    spacing: 6px;

    VerticalLayout {
        alignment: start;
        padding-top: 2px;
        Image {
            width: 14px;
            height: 14px;
            source: root.icon;
            colorize: root.tint;
            image-fit: contain;
            accessible-role: none;
        }
    }
    Text {
        horizontal-stretch: 1;
        text: root.text;
        color: root.tint;
        font-size: TypeScale.secondary;
        wrap: word-wrap;
    }
}

// The answer buttons. The user's answer shows as the selected one. On a
// phone the three share their row evenly.
component AnswerButton inherits Button {
    in property <string> answer;
    in property <bool> compact;
    height: root.compact ? 40px : 32px;
    preferred-width: root.compact ? 0px : max(88px, self.content-width);
    min-width: self.preferred-width;
    horizontal-stretch: root.compact ? 1 : 0;
    label-overflow: elide;
    checkable: true;
    selected: Invitation.my-answer == root.answer;
    enabled: !Invitation.working;
    clicked => {
        Invitation.answer(root.answer == "ACCEPTED" ? "accepted" : root.answer == "TENTATIVE" ? "tentative" : "declined");
    }
}

component JoinButton inherits Button {
    in property <bool> compact;
    height: root.compact ? 40px : 32px;
    preferred-width: max(88px, self.content-width);
    min-width: self.preferred-width;
    horizontal-stretch: root.compact ? 1 : 0;
    text: @tr("a button that opens an online meeting" => "Join");
    has-icon: true;
    icon: @image-url("../icons/lucide/outline/external-link.svg");
    clicked => { Invitation.open-link(Invitation.join-url); }
}

// The card above a message that carries a calendar: the event as the
// message has it, set against the user's calendar now (#228).
export component InvitationCard inherits Rectangle {
    in property <bool> compact: false;

    private property <bool> answer-kind: Invitation.kind == "reply" || Invitation.kind == "counter" || Invitation.kind == "refresh";
    private property <string> headline: Invitation.kind == "request"
        ? (Invitation.organized ? @tr("You sent this invitation")
            : Invitation.organizer == "" ? @tr("Invitation")
            : Invitation.invited ? @tr("{} invited you", Invitation.organizer)
            : @tr("Invitation from {}", Invitation.organizer))
        : Invitation.kind == "cancel"
        ? (Invitation.organized ? (Invitation.occurrence ? @tr("You cancelled one occurrence") : @tr("You cancelled this event"))
            : Invitation.organizer == "" ? (Invitation.occurrence ? @tr("One occurrence was cancelled") : @tr("This event was cancelled"))
            : Invitation.occurrence ? @tr("{} cancelled one occurrence", Invitation.organizer)
            : @tr("{} cancelled this event", Invitation.organizer))
        : Invitation.kind == "reply"
        ? (Invitation.invited
            ? (Invitation.their-answer == "ACCEPTED" ? @tr("You accepted the invitation")
                : Invitation.their-answer == "TENTATIVE" ? @tr("You might attend")
                : Invitation.their-answer == "DECLINED" ? @tr("You declined the invitation")
                : @tr("You answered the invitation"))
            : (Invitation.their-answer == "ACCEPTED" ? @tr("{} accepted the invitation", Invitation.answered-by)
                : Invitation.their-answer == "TENTATIVE" ? @tr("{} might attend", Invitation.answered-by)
                : Invitation.their-answer == "DECLINED" ? @tr("{} declined the invitation", Invitation.answered-by)
                : @tr("{} answered the invitation", Invitation.answered-by)))
        : Invitation.kind == "counter" ? @tr("{} proposed a new time", Invitation.answered-by)
        : Invitation.kind == "declinecounter"
        ? (Invitation.organizer == "" ? @tr("Your proposed change was declined") : @tr("{} declined your proposed change", Invitation.organizer))
        : Invitation.kind == "refresh" ? @tr("{} asked for the latest version of this event", Invitation.answered-by)
        : Invitation.organizer == "" ? @tr("Event") : @tr("Event from {}", Invitation.organizer);
    private property <string> guests-text: Invitation.guests == 0 ? ""
        : Invitation.accepted == 0 ? @tr("One guest" | "{n} guests" % Invitation.guests)
        : @tr("One guest, {} accepted" | "{n} guests, {} accepted" % Invitation.guests, Invitation.accepted);
    private property <string> when-text: Invitation.when == ""
        ? (Invitation.occurrence ? @tr("This occurrence") : Invitation.repeats ? @tr("Repeats") : "")
        : Invitation.occurrence ? @tr("{} · This occurrence", Invitation.when)
        : Invitation.repeats ? @tr("{} · Repeats", Invitation.when) : Invitation.when;
    private property <string> answer-text: Invitation.my-answer == "ACCEPTED" ? @tr("You accepted")
        : Invitation.my-answer == "TENTATIVE" ? @tr("You might attend")
        : Invitation.my-answer == "DECLINED" ? @tr("You declined") : "";
    // A link from mail kept out of the calendar, or from a version since
    // replaced, may not be the meeting's.
    private property <bool> joinable: Invitation.join-url != "" && !Invitation.cancelled && !root.answer-kind
        && !Invitation.kept-out && !Invitation.out-of-date;
    private property <bool> join-below: root.compact && (Invitation.answerable || Invitation.removable || Invitation.addable);

    background: AppTheme.control-bg;
    border-radius: LayoutMetrics.corner-radius;
    border-width: 1px;
    border-color: AppTheme.border;
    accessible-role: groupbox;
    accessible-label: root.headline;

    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 12px;

            // The date, as a calendar page.
            VerticalLayout {
                alignment: start;
                Rectangle {
                    width: 48px;
                    height: 54px;
                    border-radius: 6px;
                    background: Invitation.cancelled ? AppTheme.muted-control-bg : AppTheme.accent-soft;
                    accessible-role: none;
                    // A calendar without a time, such as some answers.
                    if Invitation.tile-day == "" : Image {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 22px;
                        height: 22px;
                        source: @image-url("../icons/lucide/outline/calendar.svg");
                        colorize: AppTheme.accent;
                        image-fit: contain;
                    }
                    if Invitation.tile-day != "" : VerticalLayout {
                        alignment: center;
                        spacing: 0px;
                        Text {
                            text: Invitation.tile-month;
                            color: Invitation.cancelled ? AppTheme.secondary : AppTheme.accent;
                            font-size: TypeScale.caption;
                            font-weight: 700;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: Invitation.tile-day;
                            color: Invitation.cancelled ? AppTheme.secondary : AppTheme.title;
                            font-size: TypeScale.title-small;
                            font-weight: 700;
                            horizontal-alignment: center;
                        }
                    }
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                alignment: start;
                Text {
                    text: root.headline;
                    color: Invitation.cancelled ? AppTheme.destructive : AppTheme.secondary;
                    font-size: TypeScale.secondary;
                    font-weight: 600;
                    wrap: word-wrap;
                }
                Text {
                    text: Invitation.title;
                    color: Invitation.cancelled ? AppTheme.secondary : AppTheme.title;
                    font-size: TypeScale.body-large;
                    font-weight: 700;
                    wrap: word-wrap;
                }
                if root.when-text != "" : Text {
                    text: root.when-text;
                    color: AppTheme.body;
                    font-size: TypeScale.secondary;
                    wrap: word-wrap;
                }
                if Invitation.location != "" : Text {
                    text: Invitation.location;
                    color: AppTheme.secondary;
                    font-size: TypeScale.secondary;
                    wrap: word-wrap;
                }
                if root.guests-text != "" : Text {
                    text: root.guests-text;
                    color: AppTheme.secondary;
                    font-size: TypeScale.secondary;
                }
            }

            if Invitation.in-calendar : VerticalLayout {
                alignment: start;
                ToolbarIconButton {
                    compact: root.compact;
                    icon: @image-url("../icons/lucide/outline/calendar.svg");
                    icon-color: AppTheme.body;
                    hover-background: AppTheme.muted-control-bg;
                    tooltip-text: @tr("Show in calendar");
                    clicked => { Invitation.show-in-calendar(); }
                }
            }
        }

        if Invitation.kept-out : CardNote {
            icon: @image-url("../icons/lucide/outline/alert.svg");
            text: @tr("Invitations in Spam or Trash, and from blocked senders, stay out of your calendar.");
        }
        if !Invitation.kept-out && Invitation.out-of-date : CardNote {
            icon: @image-url("../icons/lucide/outline/info.svg");
            text: root.answer-kind ? @tr("{} has answered again since.", Invitation.answered-by)
                : @tr("Your calendar has a newer version of this event.");
        }
        if !Invitation.kept-out && Invitation.cancelled && Invitation.kind != "cancel" : CardNote {
            icon: @image-url("../icons/lucide/outline/info.svg");
            tint: AppTheme.destructive;
            text: @tr("This event has since been cancelled.");
        }
        if Invitation.answerable && !Invitation.invited : CardNote {
            icon: @image-url("../icons/lucide/outline/info.svg");
            text: @tr("You aren't on the guest list, so the organizer may not count your answer.");
        }
        if Invitation.held : CardNote {
            icon: @image-url("../icons/lucide/outline/calendar.svg");
            text: @tr("Not in your calendar yet. Answering adds it.");
        }
        if Invitation.conflict != "" : CardNote {
            icon: @image-url("../icons/lucide/outline/alert.svg");
            tint: AppTheme.body;
            text: Invitation.more-conflicts == 0 ? @tr("At the same time as {}", Invitation.conflict)
                : @tr("At the same time as {} and one other event" | "At the same time as {} and {n} other events" % Invitation.more-conflicts, Invitation.conflict);
        }
        if !Invitation.answerable && root.answer-text != "" && !Invitation.organized && !Invitation.cancelled : CardNote {
            icon: @image-url("../icons/lucide/outline/check.svg");
            text: root.answer-text;
        }

        // On a phone the answers fill their row, and Join gets its own.
        if Invitation.answerable || Invitation.removable || Invitation.addable || (root.joinable && !root.join-below) : HorizontalLayout {
            spacing: 8px;

            if Invitation.answerable : AnswerButton { compact: root.compact; answer: "ACCEPTED"; text: @tr("Accept"); }
            if Invitation.answerable : AnswerButton { compact: root.compact; answer: "TENTATIVE"; text: @tr("Maybe"); }
            if Invitation.answerable : AnswerButton { compact: root.compact; answer: "DECLINED"; text: @tr("Decline"); }
            if Invitation.removable : Button {
                height: root.compact ? 40px : 32px;
                preferred-width: max(96px, self.content-width);
                min-width: self.preferred-width;
                horizontal-stretch: root.compact ? 1 : 0;
                text: @tr("Remove from calendar");
                enabled: !Invitation.working;
                clicked => { Invitation.remove(); }
            }
            if Invitation.addable : Button {
                height: root.compact ? 40px : 32px;
                preferred-width: max(96px, self.content-width);
                min-width: self.preferred-width;
                horizontal-stretch: root.compact ? 1 : 0;
                text: @tr("Add to calendar");
                primary: true;
                enabled: !Invitation.working;
                clicked => { Invitation.add(); }
            }
            // On a desktop the buttons keep their widths, and Join goes to
            // the end of a row it shares.
            if !root.compact && (Invitation.answerable || Invitation.removable || Invitation.addable) : Rectangle { horizontal-stretch: 1; }
            if root.joinable && !root.join-below : JoinButton { compact: root.compact; }
            if !root.compact && !(Invitation.answerable || Invitation.removable || Invitation.addable) : Rectangle { horizontal-stretch: 1; }
        }
        if root.joinable && root.join-below : HorizontalLayout {
            JoinButton { compact: root.compact; horizontal-stretch: 1; }
        }
    }
}
