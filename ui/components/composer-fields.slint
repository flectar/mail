import { HorizontalBox } from "std-widgets.slint";
import { AccountRow, ComposeContact } from "../models.slint";
import { Avatar } from "avatar.slint";
import { IconButton } from "controls.slint";
import { ModeButton, RecipientRow } from "composer-controls.slint";
import { ComposerContactMenu } from "composer-contact-menu.slint";
import { TypeScale } from "../typography.slint";
import { MotionSettings } from "../design-system.slint";
import { WindowControlsClearance } from "../window-chrome.slint";

// What a composer is for: its heading, and its window's title.
export global ComposerText {
    public pure function mode-title(mode: string) -> string {
        return mode == "reply" ? @tr("Reply")
            : mode == "reply_all" ? @tr("Reply all")
            : mode == "forward" ? @tr("Forward")
            : mode == "draft" ? @tr("Edit draft")
            : mode == "edit_as_new" ? @tr("Edit as new")
            : mode == "signature" ? @tr("Signature")
            : @tr("New message");
    }
}

export component ComposerHeader inherits Rectangle {
    in property <bool> compact: false;
    in property <string> mode: "new";
    // On the desktop: move the message into a window of its own.
    in property <bool> can-pop-out: false;
    in property <color> control-hover-color;
    in property <color> muted-color;
    in property <color> raised-color;
    in property <color> secondary-color;
    in property <color> subtle-border-color;
    in property <color> title-color;
    callback request-close();
    callback pop-out();

            height: 52px;
            background: root.raised-color;

            // The full-window compact composer can sit under the window controls.
            header-clearance := WindowControlsClearance { width: parent.width; height: parent.height; }

            Rectangle {
                x: 0px;
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: root.subtle-border-color;
            }

            Text {
                x: max(18px, header-clearance.leading);
                width: parent.width - self.x - (root.can-pop-out ? 142px : 102px) - header-clearance.trailing;
                height: parent.height;
                text: ComposerText.mode-title(root.mode);
                color: root.title-color;
                font-size: TypeScale.heading-small;
                font-weight: 700;
                vertical-alignment: center;
            }

            if root.can-pop-out : IconButton {
                x: parent.width - (root.compact ? 100px : 78px) - header-clearance.trailing;
                y: root.compact ? 4px : 10px;
                width: root.compact ? 44px : 32px;
                height: root.compact ? 44px : 32px;
                icon: @image-url("../icons/lucide/outline/external-link.svg");
                icon-color: root.secondary-color;
                hover-background: root.control-hover-color;
                tooltip-text: @tr("Open in a new window");
                clicked => { root.pop-out(); }
            }

            IconButton {
                x: parent.width - (root.compact ? 52px : 42px) - header-clearance.trailing;
                y: root.compact ? 4px : 10px;
                width: root.compact ? 44px : 32px;
                height: root.compact ? 44px : 32px;
                icon: @image-url("../icons/lucide/outline/x.svg");
                icon-color: root.secondary-color;
                hover-background: root.control-hover-color;
                tooltip-text: @tr("Close");
                clicked => { root.request-close(); }
            }
}

// Who the message is from: one menu picks the account and, when it has
// several, the address. The signature and the account's end-to-end
// protection sit at the end of the same row.
export component ComposerFromRow inherits Rectangle {
    in property <bool> compact: false;
    in property <[AccountRow]> accounts: [];
    in-out property <int> selected-account-id: -1;
    in-out property <string> from-label: @tr("No connected account");
    // The account's addresses, as "Name <address>", and the one in use.
    in property <[string]> sender-names: [];
    in property <int> sender-index: 0;
    // "No signature" first, then the account's signatures.
    in property <[string]> signature-names: [];
    in property <int> signature-index: 0;
    // "encrypted-signed", "encrypted", "signed", or "" for neither.
    in property <string> security: "";
    in property <color> background-color;
    in property <color> frame-border-color;
    in property <color> hover-color;
    in property <color> muted-color;
    in property <color> secondary-color;
    in property <color> selected-background;
    in property <color> title-color;
    callback changed(int);
    callback sender-chosen(int);
    // Past ten addresses, the sender is found by searching (#252).
    callback more-senders();
    callback signature-chosen(int);

    // Account rows hold a name and an address that grow with the platform font.
    private property <length> account-pitch: 14px + max(18px, account-name-probe.preferred-height)
        + max(16px, account-email-probe.preferred-height);
    private property <length> option-pitch: 8px + max(24px, option-probe.preferred-height);
    // The addresses the menu lists: none for an account with one, and a
    // single search row past ten.
    private property <int> sender-rows: root.sender-names.length > 10 ? 1
        : root.sender-names.length > 1 ? root.sender-names.length : 0;
    private property <length> accounts-height: min(5, root.accounts.length) * root.account-pitch;
    private property <length> senders-top: 4px + root.accounts-height + (root.sender-rows > 0 ? 9px : 0px);
    private property <string> sender-label: root.sender-index >= 0 && root.sender-index < root.sender-names.length
        ? root.sender-names[root.sender-index] : root.from-label;
    private property <string> signature-label: root.signature-index <= 0 || root.signature-index >= root.signature-names.length
        ? @tr("No signature") : root.signature-names[root.signature-index];
    private property <length> signature-width: root.compact ? 44px
        : min(190px, signature-probe.preferred-width + 54px);
    private property <length> security-width: root.security == "" ? 0px : root.compact ? 44px : 32px;

    // The menu's rows: the accounts, then the addresses.
    private property <int> highlighted-index: 0;
    private property <int> highlighted-signature: 0;

    function choose(index: int) {
        if (index < 0) {
            return;
        }
        if (index < root.accounts.length) {
            if (root.accounts[index].id != root.selected-account-id) {
                root.selected-account-id = root.accounts[index].id;
                root.from-label = root.accounts[index].name == root.accounts[index].email
                    ? root.accounts[index].email
                    : root.accounts[index].name + "  <" + root.accounts[index].email + ">";
                root.changed(root.selected-account-id);
            }
        } else if (root.sender-names.length > 10) {
            root.more-senders();
        } else if (index - root.accounts.length < root.sender-names.length) {
            root.sender-chosen(index - root.accounts.length);
        }
        from-popup.close();
    }

    function choose-signature(index: int) {
        if (index >= 0 && index < root.signature-names.length) {
            root.signature-chosen(index);
        }
        signature-popup.close();
    }

    height: root.compact ? 52px : 42px;
    background: root.background-color;

    from-label-text := Text {
        x: 12px;
        width: max(60px, self.preferred-width);
        height: parent.height;
        text: @tr("From");
        color: root.muted-color;
        font-size: TypeScale.caption;
        font-weight: 600;
        vertical-alignment: center;
        // The menu beside it carries the name.
        accessible-role: none;
    }

    trigger := Rectangle {
        x: from-label-text.x + from-label-text.width + 4px;
        y: (parent.height - self.height) / 2;
        width: max(0px, min(460px, parent.width - self.x - 20px - root.signature-width - root.security-width));
        height: root.compact ? 44px : 32px;
        border-radius: 7px;
        border-width: 1px;
        border-color: from-popup.is-open || from-focus.has-focus ? root.secondary-color : root.frame-border-color;
        background: from-hit.has-hover ? root.hover-color : root.background-color;

        Text {
            x: 10px;
            width: parent.width - 36px;
            height: parent.height;
            text: root.sender-label;
            color: root.accounts.length > 0 ? root.title-color : root.muted-color;
            font-size: TypeScale.caption;
            font-weight: root.accounts.length > 0 ? 600 : 500;
            vertical-alignment: center;
            overflow: elide;
        }

        Image {
            x: parent.width - 25px;
            y: (parent.height - self.height) / 2;
            width: 14px;
            height: 14px;
            source: @image-url("../icons/lucide/outline/chevron-down.svg");
            colorize: root.muted-color;
            image-fit: contain;
            transform-rotation: from-popup.is-open ? 180deg : 0deg;
            accessible-role: none;
            animate transform-rotation { duration: 120ms; enabled: MotionSettings.movement; }
        }

        from-focus := FocusScope {
            accessible-role: combobox;
            accessible-label: @tr("From");
            accessible-value: root.sender-label;
            accessible-action-default => {
                if (root.accounts.length > 0) {
                    root.highlighted-index = 0;
                    from-popup.show();
                }
            }
            key-pressed(event) => {
                if (event.text == Key.Return || event.text == Key.Space || event.text == Key.DownArrow) {
                    if (root.accounts.length > 0) {
                        root.highlighted-index = 0;
                        from-popup.show();
                    }
                    return accept;
                }
                reject
            }

            from-hit := TouchArea {
                enabled: root.accounts.length > 0;
                clicked => {
                    from-focus.focus();
                    root.highlighted-index = 0;
                    from-popup.show();
                }
                mouse-cursor: root.accounts.length > 0 ? pointer : default;
            }
        }
    }

    signature-trigger := Rectangle {
        x: parent.width - 12px - root.security-width - self.width;
        y: (parent.height - self.height) / 2;
        width: root.signature-width;
        height: root.compact ? 44px : 32px;
        border-radius: 7px;
        border-width: signature-focus.has-focus ? 1px : 0px;
        border-color: root.secondary-color;
        background: signature-hit.has-hover || signature-popup.is-open ? root.hover-color : transparent;

        Image {
            x: root.compact ? (parent.width - self.width) / 2 : 10px;
            y: (parent.height - self.height) / 2;
            width: 15px;
            height: 15px;
            source: @image-url("../icons/lucide/outline/pencil.svg");
            colorize: root.signature-index > 0 ? root.title-color : root.muted-color;
            image-fit: contain;
            accessible-role: none;
        }

        if !root.compact : Text {
            x: 31px;
            width: parent.width - 54px;
            height: parent.height;
            text: root.signature-label;
            color: root.signature-index > 0 ? root.title-color : root.muted-color;
            font-size: TypeScale.caption;
            vertical-alignment: center;
            overflow: elide;
        }

        if !root.compact : Image {
            x: parent.width - 21px;
            y: (parent.height - self.height) / 2;
            width: 12px;
            height: 12px;
            source: @image-url("../icons/lucide/outline/chevron-down.svg");
            colorize: root.muted-color;
            image-fit: contain;
            accessible-role: none;
        }

        signature-focus := FocusScope {
            accessible-role: combobox;
            accessible-label: @tr("Signature");
            accessible-value: root.signature-label;
            accessible-action-default => {
                if (root.signature-names.length > 0) {
                    root.highlighted-signature = max(0, root.signature-index);
                    signature-popup.show();
                }
            }
            key-pressed(event) => {
                if (event.text == Key.Return || event.text == Key.Space || event.text == Key.DownArrow) {
                    if (root.signature-names.length > 0) {
                        root.highlighted-signature = max(0, root.signature-index);
                        signature-popup.show();
                    }
                    return accept;
                }
                reject
            }

            signature-hit := TouchArea {
                enabled: root.signature-names.length > 0;
                clicked => {
                    signature-focus.focus();
                    root.highlighted-signature = max(0, root.signature-index);
                    signature-popup.show();
                }
                mouse-cursor: root.signature-names.length > 0 ? pointer : default;
            }
        }
    }

    // OpenPGP protection, shown only while the account signs or encrypts.
    if root.security != "" : IconButton {
        x: parent.width - 12px - self.width;
        y: (parent.height - self.height) / 2;
        width: root.security-width;
        height: root.compact ? 44px : 32px;
        interactive: false;
        icon: root.security == "signed"
            ? @image-url("../icons/lucide/outline/shield.svg")
            : @image-url("../icons/lucide/outline/lock.svg");
        icon-color: root.secondary-color;
        tooltip-text: root.security == "encrypted-signed" ? @tr("OpenPGP: encrypted and digitally signed")
            : root.security == "encrypted" ? @tr("OpenPGP: encrypted")
            : @tr("OpenPGP: digitally signed, not encrypted");
    }

    account-name-probe := Text { visible: false; text: "Ag"; font-size: TypeScale.secondary; font-weight: 600; }
    account-email-probe := Text { visible: false; text: "Ag"; font-size: TypeScale.caption; }
    option-probe := Text { visible: false; text: "Ag"; font-size: TypeScale.caption; }
    signature-probe := Text { visible: false; text: root.signature-label; font-size: TypeScale.caption; }

    from-popup := PopupWindow {
        x: trigger.x;
        y: trigger.y + trigger.height + 4px;
        width: max(trigger.width, min(410px, root.width - self.x - 12px));
        height: max(52px, root.senders-top + root.sender-rows * root.option-pitch + 4px);
        close-policy: close-on-click-outside;
        forward-focus: from-list;

        Rectangle {
            border-radius: 8px;
            border-width: 1px;
            border-color: root.frame-border-color;
            background: root.background-color;
            drop-shadow-blur: 18px;
            drop-shadow-offset-y: 5px;
            drop-shadow-color: #0000002e;
            clip: true;

            from-list := FocusScope {
                key-pressed(event) => {
                    if (event.text == Key.DownArrow) {
                        root.highlighted-index = min(root.accounts.length + root.sender-rows - 1, root.highlighted-index + 1);
                        return accept;
                    }
                    if (event.text == Key.UpArrow) {
                        root.highlighted-index = max(0, root.highlighted-index - 1);
                        return accept;
                    }
                    if (event.text == Key.Return || event.text == Key.Space) {
                        root.choose(root.highlighted-index);
                        return accept;
                    }
                    if (event.text == Key.Escape) {
                        from-popup.close();
                        from-focus.focus();
                        return accept;
                    }
                    reject
                }

                Flickable {
                    x: 0px;
                    y: 4px;
                    width: parent.width;
                    height: root.accounts-height;
                    content-height: root.accounts.length * root.account-pitch;
                    // The highlighted account stays in view.
                    content-y: min(0px, max(root.accounts-height - root.accounts.length * root.account-pitch,
                        root.accounts-height - (min(root.highlighted-index, root.accounts.length - 1) + 1) * root.account-pitch));

                    for account[index] in root.accounts : Rectangle {
                        x: 4px;
                        y: index * root.account-pitch;
                        width: parent.width - 8px;
                        height: root.account-pitch - 4px;
                        border-radius: 6px;
                        background: index == root.highlighted-index || account-row-hit.has-hover
                            ? root.selected-background : transparent;
                        accessible-role: list-item;
                        accessible-label: account.name == account.email ? account.email : account.name + ", " + account.email;
                        accessible-item-selected: account.id == root.selected-account-id;
                        accessible-action-default => { root.choose(index); }

                        Avatar {
                            x: 8px;
                            y: (parent.height - self.height) / 2;
                            size: 26px;
                            source: account.avatar_small;
                            has-source: account.has_avatar;
                            fallback: account.initials;
                            background-color: account.has_avatar ? #ffffff : root.selected-background;
                            foreground-color: root.title-color;
                            avatar-border-width: account.has_avatar ? 1px : 0px;
                            avatar-border-color: root.frame-border-color;
                        }

                        account-name := Text {
                            x: 43px;
                            y: 5px;
                            width: parent.width - 76px;
                            height: max(18px, self.preferred-height);
                            text: account.name;
                            color: root.title-color;
                            font-size: TypeScale.secondary;
                            font-weight: 600;
                            overflow: elide;
                        }

                        Text {
                            x: 43px;
                            y: account-name.y + account-name.height - 1px;
                            width: parent.width - 76px;
                            height: max(16px, self.preferred-height);
                            text: account.email;
                            color: root.muted-color;
                            font-size: TypeScale.caption;
                            overflow: elide;
                        }

                        Image {
                            x: parent.width - 25px;
                            y: (parent.height - self.height) / 2;
                            width: 16px;
                            height: 16px;
                            visible: account.id == root.selected-account-id;
                            source: @image-url("../icons/lucide/outline/check.svg");
                            colorize: root.secondary-color;
                            accessible-role: none;
                        }

                        account-row-hit := TouchArea {
                            clicked => { root.choose(index); }
                            mouse-cursor: pointer;
                        }
                    }
                }

                // The chosen account's addresses, below a rule.
                if root.sender-rows > 0 : Rectangle {
                    x: 12px;
                    y: root.senders-top - 5px;
                    width: parent.width - 24px;
                    height: 1px;
                    background: root.frame-border-color;
                }

                if root.sender-names.length > 10 : Rectangle {
                    x: 4px;
                    y: root.senders-top;
                    width: parent.width - 8px;
                    height: root.option-pitch - 2px;
                    border-radius: 6px;
                    background: root.highlighted-index == root.accounts.length || more-hit.has-hover
                        ? root.selected-background : transparent;
                    accessible-role: button;
                    accessible-label: @tr("Choose another address…");
                    accessible-action-default => { root.choose(root.accounts.length); }

                    Text {
                        x: 12px;
                        width: parent.width - 24px;
                        height: parent.height;
                        text: @tr("Choose another address…");
                        color: root.title-color;
                        font-size: TypeScale.caption;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    more-hit := TouchArea {
                        clicked => { root.choose(root.accounts.length); }
                        mouse-cursor: pointer;
                    }
                }

                if root.sender-names.length > 1 && root.sender-names.length <= 10 : Rectangle {
                    x: 4px;
                    y: root.senders-top;
                    width: parent.width - 8px;
                    height: root.sender-rows * root.option-pitch;

                    for name[index] in root.sender-names : Rectangle {
                        y: index * root.option-pitch;
                        height: root.option-pitch - 2px;
                        border-radius: 6px;
                        background: root.highlighted-index == root.accounts.length + index || sender-row-hit.has-hover
                            ? root.selected-background : transparent;
                        accessible-role: list-item;
                        accessible-label: name;
                        accessible-item-selected: index == root.sender-index;
                        accessible-action-default => { root.choose(root.accounts.length + index); }

                        Text {
                            x: 12px;
                            width: parent.width - 48px;
                            height: parent.height;
                            text: name;
                            color: root.title-color;
                            font-size: TypeScale.caption;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        Image {
                            x: parent.width - 25px;
                            y: (parent.height - self.height) / 2;
                            width: 16px;
                            height: 16px;
                            visible: index == root.sender-index;
                            source: @image-url("../icons/lucide/outline/check.svg");
                            colorize: root.secondary-color;
                            accessible-role: none;
                        }

                        sender-row-hit := TouchArea {
                            clicked => { root.choose(root.accounts.length + index); }
                            mouse-cursor: pointer;
                        }
                    }
                }
            }
        }
    }

    signature-popup := PopupWindow {
        width: 230px;
        x: min(root.width - self.width - 12px, signature-trigger.x);
        y: signature-trigger.y + signature-trigger.height + 4px;
        height: min(8, root.signature-names.length) * root.option-pitch + 8px;
        close-policy: close-on-click-outside;
        forward-focus: signature-list;

        Rectangle {
            border-radius: 8px;
            border-width: 1px;
            border-color: root.frame-border-color;
            background: root.background-color;
            drop-shadow-blur: 18px;
            drop-shadow-offset-y: 5px;
            drop-shadow-color: #0000002e;
            clip: true;

            signature-list := FocusScope {
                key-pressed(event) => {
                    if (event.text == Key.DownArrow) {
                        root.highlighted-signature = min(root.signature-names.length - 1, root.highlighted-signature + 1);
                        return accept;
                    }
                    if (event.text == Key.UpArrow) {
                        root.highlighted-signature = max(0, root.highlighted-signature - 1);
                        return accept;
                    }
                    if (event.text == Key.Return || event.text == Key.Space) {
                        root.choose-signature(root.highlighted-signature);
                        return accept;
                    }
                    if (event.text == Key.Escape) {
                        signature-popup.close();
                        signature-focus.focus();
                        return accept;
                    }
                    reject
                }

                Flickable {
                    x: 4px;
                    y: 4px;
                    width: parent.width - 8px;
                    height: parent.height - 8px;
                    content-height: root.signature-names.length * root.option-pitch;
                    content-y: min(0px, max(self.height - root.signature-names.length * root.option-pitch,
                        self.height - (root.highlighted-signature + 1) * root.option-pitch));

                    for name[index] in root.signature-names : Rectangle {
                        y: index * root.option-pitch;
                        height: root.option-pitch - 2px;
                        border-radius: 6px;
                        background: index == root.highlighted-signature || signature-row-hit.has-hover
                            ? root.selected-background : transparent;
                        accessible-role: list-item;
                        accessible-label: index == 0 ? @tr("No signature") : name;
                        accessible-item-selected: index == root.signature-index;
                        accessible-action-default => { root.choose-signature(index); }

                        Text {
                            x: 12px;
                            width: parent.width - 48px;
                            height: parent.height;
                            text: index == 0 ? @tr("No signature") : name;
                            color: index == 0 ? root.muted-color : root.title-color;
                            font-size: TypeScale.caption;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        Image {
                            x: parent.width - 25px;
                            y: (parent.height - self.height) / 2;
                            width: 16px;
                            height: 16px;
                            visible: index == root.signature-index;
                            source: @image-url("../icons/lucide/outline/check.svg");
                            colorize: root.secondary-color;
                            accessible-role: none;
                        }

                        signature-row-hit := TouchArea {
                            clicked => { root.choose-signature(index); }
                            mouse-cursor: pointer;
                        }
                    }
                }
            }
        }
    }
}

export component ComposerRecipients inherits Rectangle {
    in property <bool> open: false;
    in-out property <string> to;
    in-out property <string> cc;
    in-out property <string> bcc;
    in property <[ComposeContact]> contacts: [];
    in property <color> accent-background;
    in property <color> accent-color;
    in property <color> background-color;
    in property <color> body-color;
    in property <color> control-hover-color;
    in property <color> muted-color;
    in property <color> raised-color;
    in property <color> subtle-border-color;
    in property <color> title-color;
    out property <bool> contact-menu-open: contact-popup.is-open && root.contacts.length > 0;
    in-out property <int> highlighted-contact: 0;
    callback search-contacts(string);
    callback contact-selected(int);
    private property <bool> show-cc: root.cc != "";
    private property <bool> show-bcc: root.bcc != "";
    // Recipients filled in for the user, such as from a mail link, always
    // show, even in a row that was toggled off.
    changed cc => { if (root.cc != "") { root.show-cc = true; } }
    changed bcc => { if (root.bcc != "") { root.show-bcc = true; } }
    private property <bool> suggestions-dismissed: false;
    // Suggestion rows hold a name and an address that grow with the platform font.
    private property <length> suggestion-pitch: 13px + max(18px, suggestion-name-probe.preferred-height)
        + max(15px, suggestion-email-probe.preferred-height);

    function move-contact-highlight(delta: int) {
        if (root.contacts.length == 0) {
            return;
        }
        root.highlighted-contact = max(0, min(root.contacts.length - 1, root.highlighted-contact + delta));
    }

    // The contact completes the address being typed, and typing goes on
    // after it.
    function accept-contact(index: int) {
        root.contact-selected(index);
        root.suggestions-dismissed = true;
        contact-popup.close();
        to-row.focus();
        to-row.move-caret-to-end();
    }

    function choose-highlighted-contact() {
        if (root.contacts.length > 0) {
            root.accept-contact(root.highlighted-contact);
        }
    }

    changed open => {
        if root.open {
            // A message that already has recipients, such as a reply, a
            // draft or one moved into its own window, goes on in its body.
            if root.to == "" {
                to-row.focus();
            }
        } else {
            contact-popup.close();
        }
    }

            height: recipient-rows.preferred-height;
            background: root.background-color;

            recipient-rows := VerticalLayout {
                to-row := RecipientRow {
                    label: @tr("To");
                    placeholder-text: @tr("name@example.com · separate with commas");
                    right-padding: parent.width - recipient-modes.x + 8px;
                    text <=> root.to;
                    background-color: root.background-color;
                    label-color: root.muted-color;
                    text-color: root.body-color;
                    placeholder-color: root.muted-color;
                    focus-color: root.accent-color;
                    suggestions-open: root.contact-menu-open;
                    edited(value) => {
                        root.suggestions-dismissed = false;
                        root.highlighted-contact = 0;
                        root.search-contacts(value);
                        if (root.contacts.length > 0) {
                            contact-popup.show();
                            to-row.focus();
                        } else {
                            contact-popup.close();
                        }
                    }
                    move-suggestion(delta) => { root.move-contact-highlight(delta); }
                    accept-suggestion => { root.choose-highlighted-contact(); }
                    dismiss-suggestions => { root.suggestions-dismissed = true; }
                }

                if root.show-cc : RecipientRow {
                    label: @tr("Cc");
                    placeholder-text: @tr("Carbon copy");
                    text <=> root.cc;
                    background-color: root.background-color;
                    label-color: root.muted-color;
                    text-color: root.body-color;
                    placeholder-color: root.muted-color;
                    focus-color: root.accent-color;
                }

                if root.show-bcc : RecipientRow {
                    label: @tr("Bcc");
                    placeholder-text: @tr("Blind carbon copy");
                    text <=> root.bcc;
                    background-color: root.background-color;
                    label-color: root.muted-color;
                    text-color: root.body-color;
                    placeholder-color: root.muted-color;
                    focus-color: root.accent-color;
                }
            }

            recipient-modes := HorizontalBox {
                x: parent.width - self.width - 10px;
                y: 7px;
                width: cc-mode.width + bcc-mode.width + 2px;
                height: 26px;
                spacing: 2px;

                cc-mode := ModeButton {
                    width: max(36px, self.label-width + 12px);
                    text: @tr("Cc");
                    selected: root.show-cc;
                    text-color: root.muted-color;
                    selected-text-color: root.accent-color;
                    hover-color: root.control-hover-color;
                    selected-background: root.accent-background;
                    clicked => { root.show-cc = !root.show-cc; }
                }
                bcc-mode := ModeButton {
                    width: max(38px, self.label-width + 12px);
                    text: @tr("Bcc");
                    selected: root.show-bcc;
                    text-color: root.muted-color;
                    selected-text-color: root.accent-color;
                    hover-color: root.control-hover-color;
                    selected-background: root.accent-background;
                    clicked => { root.show-bcc = !root.show-bcc; }
                }
            }

            suggestion-name-probe := Text { visible: false; text: "Ag"; font-size: TypeScale.secondary; font-weight: 600; }
            suggestion-email-probe := Text { visible: false; text: "Ag"; font-size: TypeScale.caption; }

            contact-popup := PopupWindow {
                x: 44px;
                y: to-row.height - 3px;
                width: min(430px, root.width - 56px);
                height: min(6, root.contacts.length) * root.suggestion-pitch + 8px;
                close-policy: close-on-click-outside;
                forward-focus: to-row;

                ComposerContactMenu {
                    width: parent.width;
                    height: parent.height;
                    row-pitch: root.suggestion-pitch;
                    contacts: root.contacts;
                    highlighted-contact: root.highlighted-contact;
                    accent-background: root.accent-background;
                    accent-color: root.accent-color;
                    background-color: root.background-color;
                    frame-border-color: root.subtle-border-color;
                    hover-color: root.raised-color;
                    muted-color: root.muted-color;
                    title-color: root.title-color;
                    selected(index) => { root.accept-contact(index); }
                }
            }

}

export component ComposerSubject inherits Rectangle {
    in-out property <string> subject;
    // A signature being written has a name where a message has its subject.
    in property <bool> naming-signature: false;
    in property <color> accent-color;
    in property <color> background-color;
    in property <color> muted-color;
    in property <color> title-color;

    public function focus-subject() {
        subject-input.focus();
    }

            height: 42px;
            background: root.background-color;

            subject-label := Text {
                x: 12px;
                width: max(46px, self.preferred-width);
                height: parent.height;
                text: root.naming-signature ? @tr("signature" => "Name") : @tr("Subject");
                color: subject-input.has-focus ? root.accent-color : root.muted-color;
                font-size: TypeScale.caption;
                font-weight: 600;
                vertical-alignment: center;
            }

            Text {
                x: subject-label.x + subject-label.width + 12px;
                width: parent.width - self.x - 12px;
                height: parent.height;
                visible: root.subject == "";
                text: root.naming-signature ? @tr("Signature name, for example Work") : @tr("What is this email about?");
                color: root.muted-color;
                font-size: TypeScale.body;
                vertical-alignment: center;
                overflow: elide;
            }

            subject-input := TextInput {
                x: subject-label.x + subject-label.width + 12px;
                width: parent.width - self.x - 12px;
                height: parent.height;
                text <=> root.subject;
                color: root.title-color;
                selection-background-color: root.accent-color;
                selection-foreground-color: white;
                font-size: TypeScale.body-large;
                font-weight: 600;
                single-line: true;
                vertical-alignment: center;
            }
}
