import { ScrollFade } from "scroll-fade.slint";
import { ListView, VerticalBox } from "std-widgets.slint";
import { SidebarRow, SidebarRowKind } from "../models.slint";
import { SidebarItem, SidebarSectionHeader } from "sidebar-controls.slint";
import { Button } from "button.slint";
import {
    CollapsibleWorkspaceSidebar,
    WorkspaceMiniHeading,
} from "workspace-layout.slint";
import { LayoutMetrics } from "../design-system.slint";
import { TypeScale } from "../typography.slint";

export component MailSidebar inherits CollapsibleWorkspaceSidebar {
    in property <bool> touch-mode: false;
    in property <[SidebarRow]> rows: [];
    in-out property <length> scroll-y: 0px;
    in property <string> unified-count;
    in property <string> selected-scope;
    in property <bool> monochrome-icons: false;
    in property <color> background-color;
    in property <color> hover-background;
    in property <color> selection-background;
    in property <color> accent-color;
    in property <color> title-color;
    in property <color> body-color;
    in property <color> muted-color;
    callback select-scope(string);
    callback compose;
    callback manage-accounts;
    callback toggle-folder(int, bool);
    callback toggle-section(string, bool);
    callback request-create-folder(int, int, string);
    callback request-rename-folder(int, string);
    callback request-delete-folder(int, string);
    callback request-rename-label(int, string, color);
    callback request-delete-label(int, string);

    surface-color: root.background-color;
    clip: true;

    if !root.collapsed: VerticalBox {
        x: LayoutMetrics.sidebar-inset;
        y: LayoutMetrics.sidebar-action-top;
        width: parent.width - 2 * LayoutMetrics.sidebar-inset;
        height: parent.height - LayoutMetrics.sidebar-action-top;
        padding: 0px;
        spacing: 8px;

        Button {
            height: LayoutMetrics.sidebar-action-height;
            horizontal-stretch: 1;
            text: @tr("New email");
            icon: @image-url("../icons/phosphor/note-pencil-fill.svg");
            has-icon: true;
            primary: true;
            clicked => { root.compose(); }
        }

        Rectangle {
            vertical-stretch: 1;
            width: parent.width;
            background: transparent;

            mailbox-scroll := ListView {
                // Keep a direct ListView repeater; Slint 1.17 does not
                // virtualize through a wrapper or inherited ListView.
                viewport-width: self.visible-width;
                horizontal-scrollbar-policy: always-off;
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                viewport-y <=> root.scroll-y;

                mouse-drag-pan-enabled: root.touch-mode;

                // The repeater must be a direct ListView child: nesting it in
                // a layout disables virtualization. Rust supplies only expanded rows.
                for entry in root.rows: Rectangle {
                    width: max(0px, mailbox-scroll.visible-width - LayoutMetrics.sidebar-scrollbar-gutter);
                    height: entry.kind == SidebarRowKind.unified-heading ? 21px
                        : entry.kind == SidebarRowKind.accounts-heading ? 25px
                        : entry.kind == SidebarRowKind.account ? (entry.mailbox.detail == "" ? 35px : 45px)
                        : entry.kind == SidebarRowKind.unified-section || entry.kind == SidebarRowKind.unified-inbox ? 35px
                        : entry.kind == SidebarRowKind.folder && entry.mailbox.label == "Inbox" ? 35px
                        : entry.kind == SidebarRowKind.add-account ? 37px : 31px;
                    background: transparent;

                    if entry.kind == SidebarRowKind.unified-heading: WorkspaceMiniHeading {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        label: @tr("UNIFIED");
                        label-color: root.muted-color;
                    }

                    if entry.kind == SidebarRowKind.unified-section: SidebarSectionHeader {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        label: @tr("All Inboxes");
                        icon: @image-url("../icons/phosphor/stack-fill.svg");
                        sidebar-background: root.background-color;
                        hover-background: root.hover-background;
                        body-color: root.title-color;
                        muted-color: root.muted-color;
                        icon-color: root.monochrome-icons ? root.body-color : #2f9cf4;
                        open: entry.open;
                        toggled(open) => { root.toggle-section(entry.key, open); }
                    }

                    if entry.kind == SidebarRowKind.unified-inbox: SidebarItem {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        label: @tr("Inbox");
                        count: root.unified-count;
                        scope: "Unified Inbox";
                        account-id: 0;
                        folder-id: -1;
                        mail-drop-enabled: true;
                        icon: @image-url("../icons/phosphor/tray-fill.svg");
                        selected: root.selected-scope == "Unified Inbox";
                        prominent: true;
                        row-height: 32px;
                        sidebar-background: root.background-color;
                        selection-background: root.selection-background;
                        accent-color: root.accent-color;
                        body-color: root.body-color;
                        muted-color: root.muted-color;
                        icon-color: root.monochrome-icons ? (root.selected-scope == "Unified Inbox" ? root.accent-color : root.muted-color) : #2f9cf4;
                        clicked(scope) => { root.select-scope(scope); }
                    }

                    if entry.kind == SidebarRowKind.unified-mailbox: SidebarItem {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        label: entry.mailbox.label;
                        count: entry.mailbox.count;
                        scope: entry.mailbox.scope;
                        account-id: entry.mailbox.account_id;
                        folder-id: entry.mailbox.folder_id;
                        mail-drop-enabled: entry.mailbox.scope == "Unified Starred"
                            || entry.mailbox.scope == "Unified Archive"
                            || entry.mailbox.scope == "Unified Spam"
                            || entry.mailbox.scope == "Unified Trash";
                        mail-drop-copies: entry.mailbox.scope == "Unified Starred";
                        icon: entry.mailbox.scope == "Unified Starred" ? @image-url("../icons/phosphor/star-fill.svg")
                            : entry.mailbox.scope == "Unified Sent" ? @image-url("../icons/phosphor/paper-plane-tilt-fill.svg")
                            : entry.mailbox.scope == "Unified Spam" ? @image-url("../icons/phosphor/warning-fill.svg")
                            : entry.mailbox.scope == "Unified Trash" ? @image-url("../icons/phosphor/trash-fill.svg")
                            : entry.mailbox.scope == "Unified Archive" ? @image-url("../icons/phosphor/archive-fill.svg")
                            : @image-url("../icons/phosphor/file-plus-fill.svg");
                        selected: entry.mailbox.scope == root.selected-scope;
                        sidebar-background: root.background-color;
                        selection-background: root.selection-background;
                        accent-color: root.accent-color;
                        body-color: root.body-color;
                        muted-color: root.muted-color;
                        icon-color: root.monochrome-icons ? (entry.mailbox.scope == root.selected-scope ? root.accent-color : root.muted-color)
                            : entry.mailbox.scope == "Unified Starred" ? #f5b301
                            : entry.mailbox.scope == "Unified Sent" ? #00a8f3
                            : entry.mailbox.scope == "Unified Spam" ? #f59e0b
                            : entry.mailbox.scope == "Unified Trash" ? #ff5b4d
                            : entry.mailbox.scope == "Unified Archive" ? #8b5cf6
                            : #d946ef;
                        clicked(scope) => { root.select-scope(scope); }
                    }

                    if entry.kind == SidebarRowKind.categories-section: SidebarSectionHeader {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        label: @tr("Categories");
                        label-font-weight: 500;
                        folder-row-style: true;
                        sidebar-background: root.background-color;
                        hover-background: root.hover-background;
                        body-color: root.body-color;
                        muted-color: root.muted-color;
                        icon: @image-url("../icons/phosphor/tag-simple-fill.svg");
                        icon-color: root.monochrome-icons ? root.body-color : #2f9cf4;
                        open: entry.open;
                        toggled(open) => { root.toggle-section(entry.key, open); }
                    }

                    if entry.kind == SidebarRowKind.important: SidebarItem {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        label: @tr("Important");
                        left-padding: 42px;
                        scope: "Important";
                        mail-drop-enabled: true;
                        icon: @image-url("../icons/phosphor/envelope-fill.svg");
                        selected: root.selected-scope == "Important";
                        sidebar-background: root.background-color;
                        selection-background: root.selection-background;
                        accent-color: root.accent-color;
                        body-color: root.body-color;
                        muted-color: root.muted-color;
                        icon-color: root.monochrome-icons ? (root.selected-scope == "Important" ? root.accent-color : root.muted-color) : #2f9cf4;
                        clicked(scope) => { root.select-scope(scope); }
                    }

                    if entry.kind == SidebarRowKind.other: SidebarItem {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        label: @tr("Other");
                        left-padding: 42px;
                        scope: "Other";
                        mail-drop-enabled: true;
                        icon: @image-url("../icons/phosphor/envelope-simple-fill.svg");
                        selected: root.selected-scope == "Other";
                        sidebar-background: root.background-color;
                        selection-background: root.selection-background;
                        accent-color: root.accent-color;
                        body-color: root.body-color;
                        muted-color: root.muted-color;
                        icon-color: root.monochrome-icons ? (root.selected-scope == "Other" ? root.accent-color : root.muted-color) : #64748b;
                        clicked(scope) => { root.select-scope(scope); }
                    }

                    if entry.kind == SidebarRowKind.category: SidebarItem {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        label: entry.label.name;
                        label-has-emoji: entry.label.name_has_emoji;
                        left-padding: 42px;
                        scope: "Label:" + entry.label.id;
                        mail-drop-enabled: true;
                        icon: root.selected-scope == "Label:" + entry.label.id
                            ? @image-url("../icons/phosphor/folder-open-fill.svg")
                            : @image-url("../icons/phosphor/folder-simple-fill.svg");
                        selected: root.selected-scope == "Label:" + entry.label.id;
                        sidebar-background: root.background-color;
                        selection-background: root.selection-background;
                        accent-color: root.accent-color;
                        body-color: root.body-color;
                        muted-color: root.muted-color;
                        icon-color: root.monochrome-icons
                            ? (root.selected-scope == "Label:" + entry.label.id ? root.accent-color : root.muted-color)
                            : entry.label.color;
                        clicked(scope) => { root.select-scope(scope); }
                    }

                    if entry.kind == SidebarRowKind.labels-section: SidebarSectionHeader {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        label: @tr("Labels");
                        label-font-weight: 500;
                        folder-row-style: true;
                        sidebar-background: root.background-color;
                        hover-background: root.hover-background;
                        body-color: root.body-color;
                        muted-color: root.muted-color;
                        icon: @image-url("../icons/phosphor/folders-fill.svg");
                        icon-color: root.monochrome-icons ? root.body-color : #22a06b;
                        open: entry.open;
                        toggled(open) => { root.toggle-section(entry.key, open); }
                    }

                    if entry.kind == SidebarRowKind.label: SidebarItem {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        label: entry.label.name;
                        label-has-emoji: entry.label.name_has_emoji;
                        left-padding: 42px;
                        label-id: entry.label.id;
                        editable-color: entry.label.color;
                        scope: "Label:" + entry.label.id;
                        label-manageable: true;
                        mail-drop-enabled: true;
                        mail-drop-copies: true;
                        icon: root.selected-scope == "Label:" + entry.label.id
                            ? @image-url("../icons/phosphor/folder-open-fill.svg")
                            : @image-url("../icons/phosphor/folder-simple-fill.svg");
                        selected: root.selected-scope == "Label:" + entry.label.id;
                        sidebar-background: root.background-color;
                        selection-background: root.selection-background;
                        accent-color: root.accent-color;
                        body-color: root.body-color;
                        muted-color: root.muted-color;
                        icon-color: root.monochrome-icons
                            ? (root.selected-scope == "Label:" + entry.label.id ? root.accent-color : root.muted-color)
                            : entry.label.color;
                        clicked(scope) => { root.select-scope(scope); }
                        rename-label(id, name, color) => { root.request-rename-label(id, name, color); }
                        delete-label(id, name) => { root.request-delete-label(id, name); }
                    }

                    if entry.kind == SidebarRowKind.accounts-heading: WorkspaceMiniHeading {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: 22px;
                        label: @tr("ACCOUNTS");
                        label-color: root.muted-color;
                        vertical-alignment: bottom;
                    }

                    if entry.kind == SidebarRowKind.account: SidebarSectionHeader {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        label: entry.mailbox.label;
                        detail: entry.mailbox.detail;
                        avatar: entry.mailbox.avatar;
                        avatar-image: entry.mailbox.avatar_image;
                        has-avatar-image: entry.mailbox.has_avatar;
                        has-avatar: true;
                        sidebar-background: root.background-color;
                        hover-background: root.hover-background;
                        body-color: root.title-color;
                        muted-color: root.muted-color;
                        icon-color: root.body-color;
                        open: entry.open;
                        toggled(open) => { root.toggle-section(entry.key, open); }
                    }

                    if entry.kind == SidebarRowKind.folder: SidebarItem {
                        x: 0px;
                        y: 0px;
                        width: parent.width;

                        label: entry.mailbox.label;
                        label-has-emoji: entry.mailbox.label_has_emoji;
                        count: entry.mailbox.count;
                        scope: entry.mailbox.scope;
                        account-id: entry.mailbox.account_id;
                        folder-id: entry.mailbox.folder_id;
                        has-children: entry.mailbox.has_children;
                        expanded: entry.mailbox.expanded;
                        manageable: !entry.mailbox.is_standard && entry.mailbox.folder_id >= 0;
                        mail-drop-enabled: (entry.mailbox.folder_id >= 0
                            && entry.mailbox.label != "Sent"
                            && entry.mailbox.label != "Drafts")
                            || entry.mailbox.label == "Starred";
                        mail-drop-copies: entry.mailbox.label == "Starred";
                        left-padding: 26px + entry.mailbox.depth * 16px;
                        icon: entry.mailbox.label == "Inbox" ? @image-url("../icons/phosphor/tray-fill.svg")
                            : entry.mailbox.label == "Starred" ? @image-url("../icons/phosphor/star-fill.svg")
                            : entry.mailbox.label == "Sent" ? @image-url("../icons/phosphor/paper-plane-tilt-fill.svg")
                            : entry.mailbox.label == "Archive" ? @image-url("../icons/phosphor/archive-fill.svg")
                            : entry.mailbox.label == "Spam" ? @image-url("../icons/phosphor/warning-fill.svg")
                            : entry.mailbox.label == "Trash" ? @image-url("../icons/phosphor/trash-fill.svg")
                            : entry.mailbox.label == "Drafts" ? @image-url("../icons/phosphor/file-plus-fill.svg")
                            : entry.mailbox.scope == root.selected-scope ? @image-url("../icons/phosphor/folder-open-fill.svg")
                            : @image-url("../icons/phosphor/folder-simple-fill.svg");
                        selected: entry.mailbox.scope == root.selected-scope;
                        prominent: entry.mailbox.label == "Inbox";
                        row-height: entry.mailbox.label == "Inbox" ? 32px : 28px;
                        sidebar-background: root.background-color;
                        selection-background: root.selection-background;
                        accent-color: root.accent-color;
                        body-color: root.body-color;
                        muted-color: root.muted-color;
                        icon-color: root.monochrome-icons ? (entry.mailbox.scope == root.selected-scope ? root.accent-color : root.muted-color)
                            : entry.mailbox.label == "Inbox" ? #2f9cf4
                            : entry.mailbox.label == "Starred" ? #f5b301
                            : entry.mailbox.label == "Sent" ? #00a8f3
                            : entry.mailbox.label == "Archive" ? #8b5cf6
                            : entry.mailbox.label == "Spam" ? #f59e0b
                            : entry.mailbox.label == "Trash" ? #ff5b4d
                            : entry.mailbox.label == "Drafts" ? #d946ef
                            : entry.mailbox.has_custom_color ? entry.mailbox.color
                            : #22a06b;
                        clicked(scope) => { root.select-scope(scope); }
                        toggled(folder-id, expanded) => { root.toggle-folder(folder-id, expanded); }
                        new-subfolder(account-id, folder-id, name) => {
                            root.request-create-folder(account-id, folder-id, name);
                        }
                        rename-folder(folder-id, name) => { root.request-rename-folder(folder-id, name); }
                        delete-folder(folder-id, name) => { root.request-delete-folder(folder-id, name); }
                    }

                    if entry.kind == SidebarRowKind.new-folder: SidebarItem {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        label: @tr("New folder");
                        scope: "";
                        icon: @image-url("../icons/phosphor/plus.svg");
                        sidebar-background: root.background-color;
                        selection-background: root.selection-background;
                        accent-color: root.accent-color;
                        body-color: root.body-color;
                        muted-color: root.muted-color;
                        icon-color: root.muted-color;
                        clicked(scope) => { root.request-create-folder(entry.mailbox.account_id, -1, ""); }
                    }

                    if entry.kind == SidebarRowKind.add-account: Rectangle {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: 34px;
                        background: transparent;

                        Text {
                            x: 26px;
                            width: parent.width - 26px;
                            height: parent.height;
                            text: @tr("Add account");
                            color: root.muted-color;
                            font-size: TypeScale.caption;
                            vertical-alignment: center;
                        }

                        Image {
                            x: 5px;
                            y: 10px;
                            width: 14px;
                            height: 14px;
                            source: @image-url("../icons/phosphor/plus.svg");
                            colorize: root.muted-color;
                            image-fit: contain;
                            accessible-role: none;
                        }

                        add-account-hit := TouchArea {
                            accessible-role: button;
                            accessible-label: @tr("Add account");
                            accessible-action-default => { root.manage-accounts(); }
                            clicked => { root.manage-accounts(); }
                            mouse-cursor: pointer;
                        }
                    }
                }
            }

            ScrollFade {
                x: mailbox-scroll.x;
                y: mailbox-scroll.y;
                width: mailbox-scroll.visible-width;
                height: mailbox-scroll.visible-height;
                surface-color: root.background-color;
                viewport-y: mailbox-scroll.viewport-y;
                viewport-height: mailbox-scroll.viewport-height;
                visible-height: mailbox-scroll.visible-height;
            }
        }
    }
}
