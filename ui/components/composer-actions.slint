import { HorizontalBox, ScrollView } from "std-widgets.slint";
import { ComposeAttachment } from "../models.slint";
import { Button } from "button.slint";
import { IconButton, Switch } from "controls.slint";
import { TypeScale } from "../typography.slint";
import { LayoutMetrics } from "../design-system.slint";
import { FocusVisibleScope } from "focus-visible-scope.slint";

// A color the composer offers, with its name for screen readers.
struct ComposerSwatch {
    value: string,
    color: color,
    name: string,
}

// The colors offered for text and its highlight, eight to a row: grays, bright colors, then
// three tints and three shades of each, the palette webmail composers offer.
global ComposerPalette {
    // Color names for screen readers, also in the names of their shades.
    out property <string> red: @tr("Red");
    out property <string> orange: @tr("Orange");
    out property <string> yellow: @tr("Yellow");
    out property <string> green: @tr("Green");
    out property <string> cyan: @tr("Cyan");
    out property <string> blue: @tr("Blue");
    out property <string> purple: @tr("Purple");
    out property <string> magenta: @tr("Magenta");
    out property <string> black: @tr("Black");

    out property <[ComposerSwatch]> swatches: [
        { value: "#000000", color: #000000, name: root.black },
        // Grays for screen readers, numbered away from mid gray.
        { value: "#444444", color: #444444, name: @tr("Dark gray {0}", 4) },
        { value: "#666666", color: #666666, name: @tr("Dark gray {0}", 3) },
        { value: "#999999", color: #999999, name: @tr("Dark gray {0}", 2) },
        { value: "#cccccc", color: #cccccc, name: @tr("Gray") },
        { value: "#eeeeee", color: #eeeeee, name: @tr("Light gray {0}", 2) },
        { value: "#f3f3f3", color: #f3f3f3, name: @tr("Light gray {0}", 3) },
        { value: "#ffffff", color: #ffffff, name: @tr("White") },
        { value: "#ff0000", color: #ff0000, name: root.red },
        { value: "#ff9900", color: #ff9900, name: root.orange },
        { value: "#ffff00", color: #ffff00, name: root.yellow },
        { value: "#00ff00", color: #00ff00, name: root.green },
        { value: "#00ffff", color: #00ffff, name: root.cyan },
        { value: "#0000ff", color: #0000ff, name: root.blue },
        { value: "#9900ff", color: #9900ff, name: root.purple },
        { value: "#ff00ff", color: #ff00ff, name: root.magenta },
        // A color's tint for screen readers, 3 the lightest.
        { value: "#f4cccc", color: #f4cccc, name: @tr("{0}, light {1}", root.red, 3) },
        { value: "#fce5cd", color: #fce5cd, name: @tr("{0}, light {1}", root.orange, 3) },
        { value: "#fff2cc", color: #fff2cc, name: @tr("{0}, light {1}", root.yellow, 3) },
        { value: "#d9ead3", color: #d9ead3, name: @tr("{0}, light {1}", root.green, 3) },
        { value: "#d0e0e3", color: #d0e0e3, name: @tr("{0}, light {1}", root.cyan, 3) },
        { value: "#cfe2f3", color: #cfe2f3, name: @tr("{0}, light {1}", root.blue, 3) },
        { value: "#d9d2e9", color: #d9d2e9, name: @tr("{0}, light {1}", root.purple, 3) },
        { value: "#ead1dc", color: #ead1dc, name: @tr("{0}, light {1}", root.magenta, 3) },
        { value: "#ea9999", color: #ea9999, name: @tr("{0}, light {1}", root.red, 2) },
        { value: "#f9cb9c", color: #f9cb9c, name: @tr("{0}, light {1}", root.orange, 2) },
        { value: "#ffe599", color: #ffe599, name: @tr("{0}, light {1}", root.yellow, 2) },
        { value: "#b6d7a8", color: #b6d7a8, name: @tr("{0}, light {1}", root.green, 2) },
        { value: "#a2c4c9", color: #a2c4c9, name: @tr("{0}, light {1}", root.cyan, 2) },
        { value: "#9fc5e8", color: #9fc5e8, name: @tr("{0}, light {1}", root.blue, 2) },
        { value: "#b4a7d6", color: #b4a7d6, name: @tr("{0}, light {1}", root.purple, 2) },
        { value: "#d5a6bd", color: #d5a6bd, name: @tr("{0}, light {1}", root.magenta, 2) },
        { value: "#e06666", color: #e06666, name: @tr("{0}, light {1}", root.red, 1) },
        { value: "#f6b26b", color: #f6b26b, name: @tr("{0}, light {1}", root.orange, 1) },
        { value: "#ffd966", color: #ffd966, name: @tr("{0}, light {1}", root.yellow, 1) },
        { value: "#93c47d", color: #93c47d, name: @tr("{0}, light {1}", root.green, 1) },
        { value: "#76a5af", color: #76a5af, name: @tr("{0}, light {1}", root.cyan, 1) },
        { value: "#6fa8dc", color: #6fa8dc, name: @tr("{0}, light {1}", root.blue, 1) },
        { value: "#8e7cc3", color: #8e7cc3, name: @tr("{0}, light {1}", root.purple, 1) },
        { value: "#c27ba0", color: #c27ba0, name: @tr("{0}, light {1}", root.magenta, 1) },
        // A color's shade for screen readers, 3 the darkest.
        { value: "#cc0000", color: #cc0000, name: @tr("{0}, dark {1}", root.red, 1) },
        { value: "#e69138", color: #e69138, name: @tr("{0}, dark {1}", root.orange, 1) },
        { value: "#f1c232", color: #f1c232, name: @tr("{0}, dark {1}", root.yellow, 1) },
        { value: "#6aa84f", color: #6aa84f, name: @tr("{0}, dark {1}", root.green, 1) },
        { value: "#45818e", color: #45818e, name: @tr("{0}, dark {1}", root.cyan, 1) },
        { value: "#3d85c6", color: #3d85c6, name: @tr("{0}, dark {1}", root.blue, 1) },
        { value: "#674ea7", color: #674ea7, name: @tr("{0}, dark {1}", root.purple, 1) },
        { value: "#a64d79", color: #a64d79, name: @tr("{0}, dark {1}", root.magenta, 1) },
        { value: "#990000", color: #990000, name: @tr("{0}, dark {1}", root.red, 2) },
        { value: "#b45f06", color: #b45f06, name: @tr("{0}, dark {1}", root.orange, 2) },
        { value: "#bf9000", color: #bf9000, name: @tr("{0}, dark {1}", root.yellow, 2) },
        { value: "#38761d", color: #38761d, name: @tr("{0}, dark {1}", root.green, 2) },
        { value: "#134f5c", color: #134f5c, name: @tr("{0}, dark {1}", root.cyan, 2) },
        { value: "#0b5394", color: #0b5394, name: @tr("{0}, dark {1}", root.blue, 2) },
        { value: "#351c75", color: #351c75, name: @tr("{0}, dark {1}", root.purple, 2) },
        { value: "#741b47", color: #741b47, name: @tr("{0}, dark {1}", root.magenta, 2) },
        { value: "#660000", color: #660000, name: @tr("{0}, dark {1}", root.red, 3) },
        { value: "#783f04", color: #783f04, name: @tr("{0}, dark {1}", root.orange, 3) },
        { value: "#7f6000", color: #7f6000, name: @tr("{0}, dark {1}", root.yellow, 3) },
        { value: "#274e13", color: #274e13, name: @tr("{0}, dark {1}", root.green, 3) },
        { value: "#0c343d", color: #0c343d, name: @tr("{0}, dark {1}", root.cyan, 3) },
        { value: "#073763", color: #073763, name: @tr("{0}, dark {1}", root.blue, 3) },
        { value: "#20124d", color: #20124d, name: @tr("{0}, dark {1}", root.purple, 3) },
        { value: "#4c1130", color: #4c1130, name: @tr("{0}, dark {1}", root.magenta, 3) }
    ];
}

// A toolbar button that opens a palette of colors for text or its highlight. `current` is
// the color the selection shares, as "#rrggbb", "none", or "" when it mixes several.
component ColorPicker inherits Rectangle {
    in property <bool> compact: false;
    in property <image> icon;
    in property <string> tooltip-text;
    // The first choice, which takes the color off.
    in property <string> none-title;
    in property <string> current;
    in property <color> accent-color;
    in property <color> body-color;
    in property <color> control-hover-color;
    in property <color> raised-color;
    in property <color> secondary-color;
    in property <color> subtle-border-color;
    callback chosen(string);

    private property <length> swatch: root.compact ? 30px : 20px;
    private property <length> gap: root.compact ? 4px : 3px;
    // Grays and bright colors stand apart from the tints and shades under them.
    private property <length> group-gap: root.compact ? 10px : 8px;
    private property <length> inset: root.compact ? 12px : 10px;
    private property <length> none-height: root.compact ? LayoutMetrics.touch-target : 30px;
    private property <length> grid-width: 8 * root.swatch + 7 * root.gap;
    private property <length> grid-height: 8 * root.swatch + 5 * root.gap + 2 * root.group-gap;
    // The choice the keyboard is on, once arrow keys moved it: -1 for the first, then the
    // swatches in order.
    private property <int> highlighted: -1;
    private property <bool> keyboard-used: false;
    private property <bool> open: palette-popup.is-open;

    width: 32px;
    height: 32px;

    function swatch-y(index: int) -> length {
        let row = floor(index / 8);
        if row == 0 { return 0px; }
        if row == 1 { return root.swatch + root.group-gap; }
        2 * (root.swatch + root.group-gap) + (row - 2) * (root.swatch + root.gap)
    }

    function choose(value: string) {
        palette-popup.close();
        root.chosen(value);
    }

    function move-highlight(step: int) {
        if !root.keyboard-used {
            root.keyboard-used = true;
            return;
        }
        if root.highlighted + step < -1 {
            root.highlighted = -1;
        } else if root.highlighted + step < ComposerPalette.swatches.length {
            root.highlighted += step;
        }
    }

    trigger := IconButton {
        icon: root.icon;
        icon-color: root.secondary-color;
        hover-background: root.control-hover-color;
        active-background: root.control-hover-color;
        active: root.open;
        tooltip-text: root.tooltip-text;
        clicked => {
            if root.open {
                palette-popup.close();
            } else {
                root.highlighted = -1;
                root.keyboard-used = false;
                palette-popup.show();
            }
        }
    }

    palette-popup := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: root.grid-width + 2 * root.inset;
        height: root.none-height + root.grid-height + 2 * root.inset + 6px;
        close-policy: close-on-click-outside;
        forward-focus: palette-keys;

        Rectangle {
            border-radius: 8px;
            border-width: 1px;
            border-color: root.subtle-border-color;
            background: root.raised-color;
            drop-shadow-blur: 18px;
            drop-shadow-offset-y: 5px;
            drop-shadow-color: #0000002e;
            accessible-role: groupbox;
            accessible-label: root.tooltip-text;
            accessible-item-count: ComposerPalette.swatches.length + 1;

            palette-keys := FocusScope {
                key-pressed(event) => {
                    if event.text == Key.RightArrow { root.move-highlight(1); return accept; }
                    if event.text == Key.LeftArrow { root.move-highlight(-1); return accept; }
                    if event.text == Key.DownArrow { root.move-highlight(root.highlighted < 0 ? 1 : 8); return accept; }
                    if event.text == Key.UpArrow { root.move-highlight(root.highlighted < 8 ? -1 - root.highlighted : -8); return accept; }
                    if (event.text == Key.Return || event.text == Key.Space) && root.keyboard-used {
                        root.choose(root.highlighted < 0 ? "none" : ComposerPalette.swatches[root.highlighted].value);
                        return accept;
                    }
                    if event.text == Key.Escape {
                        palette-popup.close();
                        trigger.focus();
                        return accept;
                    }
                    if event.text == Key.Tab {
                        palette-popup.close();
                        trigger.focus();
                        return reject;
                    }
                    reject
                }
            }

            Rectangle {
                x: root.inset - 4px;
                y: root.inset - 4px;
                width: root.grid-width + 8px;
                height: root.none-height;
                border-radius: 5px;
                background: (root.keyboard-used && root.highlighted == -1) || none-hit.has-hover ? root.control-hover-color : transparent;

                Text {
                    x: 6px;
                    width: parent.width - 34px;
                    height: parent.height;
                    text: root.none-title;
                    color: root.body-color;
                    font-size: TypeScale.body;
                    vertical-alignment: center;
                    overflow: elide;
                }

                if root.current == "none" : Image {
                    x: parent.width - 6px - self.width;
                    y: (parent.height - self.height) / 2;
                    width: LayoutMetrics.icon-size;
                    height: LayoutMetrics.icon-size;
                    source: @image-url("../icons/lucide/outline/check.svg");
                    colorize: root.accent-color;
                    accessible-role: none;
                }

                none-hit := TouchArea {
                    accessible-role: radio-button;
                    accessible-label: root.none-title;
                    accessible-checked: root.current == "none";
                    accessible-item-index: 0;
                    accessible-action-default => { root.choose("none"); }
                    clicked => { root.choose("none"); }
                    mouse-cursor: pointer;
                }
            }

            for swatch[index] in ComposerPalette.swatches : Rectangle {
                x: root.inset + mod(index, 8) * (root.swatch + root.gap);
                y: root.inset + root.none-height + 6px + root.swatch-y(index);
                width: root.swatch;
                height: root.swatch;

                // The color the selection has, and the one the pointer or keyboard is on.
                Rectangle {
                    x: -3px;
                    y: -3px;
                    width: parent.width + 6px;
                    height: parent.height + 6px;
                    border-radius: 5px;
                    border-width: 2px;
                    border-color: swatch.value == root.current ? root.accent-color
                        : (root.keyboard-used && index == root.highlighted) || swatch-hit.has-hover ? root.secondary-color
                        : transparent;
                }

                Rectangle {
                    border-radius: 3px;
                    border-width: 1px;
                    border-color: root.subtle-border-color;
                    background: swatch.color;
                }

                swatch-hit := TouchArea {
                    accessible-role: radio-button;
                    accessible-label: swatch.name;
                    accessible-checked: swatch.value == root.current;
                    accessible-item-index: index + 1;
                    accessible-action-default => { root.choose(swatch.value); }
                    clicked => { root.choose(swatch.value); }
                    mouse-cursor: pointer;
                }
            }
        }
    }
}

export component ComposerToolbar inherits Rectangle {
    in property <bool> compact: false;
    in property <color> accent-background;
    in property <color> accent-color;
    in property <color> control-hover-color;
    in property <color> muted-color;
    in property <color> raised-color;
    in property <color> secondary-color;
    in property <color> subtle-border-color;
    in property <color> body-color;
    in property <bool> bold-active: false;
    in property <bool> italic-active: false;
    in property <bool> underline-active: false;
    in property <bool> strike-active: false;
    in property <bool> code-active: false;
    in property <string> active-color: "none";
    in property <string> active-highlight: "none";
    in property <string> active-size: "normal";
    in property <string> active-family: "default";
    in property <string> active-align: "left";
    in property <bool> link-active: false;
    in property <bool> can-link: false;
    // Templates are messages to start from, which signatures don't have.
    in property <bool> templates-shown: true;
    callback apply-format(string);
    callback insert-image();
    callback open-templates();
    callback undo();
    callback redo();

    height: 44px;
    background: root.raised-color;
    border-width: 1px;
    border-color: root.subtle-border-color;

    toolbar-scroll := ScrollView {
        x: 8px;
        y: 6px;
        width: max(0px, trailing.x - self.x - 4px);
        height: 32px;
        content-width: max(self.visible-width, toolbar-row.preferred-width);
        content-height: self.visible-height;
        // A native horizontal scrollbar consumes part of this 32px viewport
        // and clips the buttons. Compact toolbars remain pannable by touch.
        horizontal-scrollbar-policy: always-off;
        vertical-scrollbar-policy: always-off;
        mouse-drag-pan-enabled: root.compact;

        toolbar-row := HorizontalLayout {
            height: 32px;
            spacing: 2px;

            font-menu := ContextMenuArea {
                width: 32px;
                height: 32px;

                IconButton {
                    icon: @image-url("../icons/lucide/outline/font.svg");
                    icon-color: root.secondary-color;
                    hover-background: root.control-hover-color;
                    tooltip-text: @tr("Font");
                    clicked => { font-menu.show({ x: 0px, y: parent.height + 4px }); }
                }

                Menu {
                    MenuItem { title: @tr("font" => "Default"); checkable: true; checked: root.active-family == "default"; activated => { root.apply-format("family:default"); } }
                    MenuItem { title: @tr("font" => "Serif"); checkable: true; checked: root.active-family == "serif"; activated => { root.apply-format("family:serif"); } }
                    MenuItem { title: @tr("font" => "Fixed width"); checkable: true; checked: root.active-family == "monospace"; activated => { root.apply-format("family:monospace"); } }
                }
            }

            size-menu := ContextMenuArea {
                width: 32px;
                height: 32px;

                IconButton {
                    icon: @image-url("../icons/lucide/outline/text-size.svg");
                    icon-color: root.secondary-color;
                    hover-background: root.control-hover-color;
                    tooltip-text: @tr("Text size");
                    clicked => { size-menu.show({ x: 0px, y: parent.height + 4px }); }
                }

                Menu {
                    MenuItem { title: @tr("text size" => "Small"); checkable: true; checked: root.active-size == "small"; activated => { root.apply-format("size:small"); } }
                    MenuItem { title: @tr("text size" => "Normal"); checkable: true; checked: root.active-size == "normal"; activated => { root.apply-format("size:normal"); } }
                    MenuItem { title: @tr("text size" => "Large"); checkable: true; checked: root.active-size == "large"; activated => { root.apply-format("size:large"); } }
                    MenuItem { title: @tr("text size" => "Huge"); checkable: true; checked: root.active-size == "huge"; activated => { root.apply-format("size:huge"); } }
                }
            }

            Rectangle { width: 1px; height: 18px; background: root.subtle-border-color; }

            IconButton { icon: root.bold-active ? @image-url("../icons/lucide/filled/bold.svg") : @image-url("../icons/lucide/outline/bold.svg"); icon-color: root.bold-active ? root.accent-color : root.secondary-color; active: root.bold-active; hover-background: root.control-hover-color; active-background: root.accent-background; tooltip-text: @tr("Bold · Ctrl+B"); clicked => { root.apply-format("bold"); } }
            IconButton { icon: root.italic-active ? @image-url("../icons/lucide/filled/italic.svg") : @image-url("../icons/lucide/outline/italic.svg"); icon-color: root.italic-active ? root.accent-color : root.secondary-color; active: root.italic-active; hover-background: root.control-hover-color; active-background: root.accent-background; tooltip-text: @tr("Italic · Ctrl+I"); clicked => { root.apply-format("italic"); } }
            IconButton { icon: root.underline-active ? @image-url("../icons/lucide/filled/typography.svg") : @image-url("../icons/lucide/outline/typography.svg"); icon-color: root.underline-active ? root.accent-color : root.secondary-color; active: root.underline-active; hover-background: root.control-hover-color; active-background: root.accent-background; tooltip-text: @tr("Underline · Ctrl+U"); clicked => { root.apply-format("underline"); } }
            IconButton { icon: root.strike-active ? @image-url("../icons/lucide/filled/strikethrough.svg") : @image-url("../icons/lucide/outline/strikethrough.svg"); icon-color: root.strike-active ? root.accent-color : root.secondary-color; active: root.strike-active; hover-background: root.control-hover-color; active-background: root.accent-background; tooltip-text: @tr("Strikethrough"); clicked => { root.apply-format("strike"); } }

            ColorPicker {
                compact: root.compact;
                icon: @image-url("../icons/lucide/outline/text-color.svg");
                tooltip-text: @tr("Text color");
                none-title: @tr("text color" => "Automatic");
                current: root.active-color;
                accent-color: root.accent-color;
                body-color: root.body-color;
                control-hover-color: root.control-hover-color;
                raised-color: root.raised-color;
                secondary-color: root.secondary-color;
                subtle-border-color: root.subtle-border-color;
                chosen(value) => { root.apply-format("color:" + value); }
            }

            ColorPicker {
                compact: root.compact;
                icon: @image-url("../icons/lucide/outline/highlight.svg");
                tooltip-text: @tr("Highlight");
                none-title: @tr("No highlight");
                current: root.active-highlight;
                accent-color: root.accent-color;
                body-color: root.body-color;
                control-hover-color: root.control-hover-color;
                raised-color: root.raised-color;
                secondary-color: root.secondary-color;
                subtle-border-color: root.subtle-border-color;
                chosen(value) => { root.apply-format("highlight:" + value); }
            }

            IconButton { icon: @image-url("../icons/lucide/outline/remove-formatting.svg"); icon-color: root.secondary-color; hover-background: root.control-hover-color; tooltip-text: @tr("Remove formatting · Ctrl+\\"); clicked => { root.apply-format("clear"); } }

            Rectangle { width: 1px; height: 18px; background: root.subtle-border-color; }

            align-menu := ContextMenuArea {
                width: 32px;
                height: 32px;

                IconButton {
                    icon: root.active-align == "center" ? @image-url("../icons/lucide/outline/align-center.svg")
                        : root.active-align == "right" ? @image-url("../icons/lucide/outline/align-right.svg")
                        : @image-url("../icons/lucide/outline/align-left.svg");
                    icon-color: root.secondary-color;
                    hover-background: root.control-hover-color;
                    tooltip-text: @tr("Align");
                    clicked => { align-menu.show({ x: 0px, y: parent.height + 4px }); }
                }

                Menu {
                    MenuItem { title: @tr("Align left"); checkable: true; checked: root.active-align == "left"; activated => { root.apply-format("align:left"); } }
                    MenuItem { title: @tr("Align center"); checkable: true; checked: root.active-align == "center"; activated => { root.apply-format("align:center"); } }
                    MenuItem { title: @tr("Align right"); checkable: true; checked: root.active-align == "right"; activated => { root.apply-format("align:right"); } }
                }
            }

            IconButton { icon: @image-url("../icons/lucide/outline/list-unordered.svg"); icon-color: root.secondary-color; hover-background: root.control-hover-color; tooltip-text: @tr("Bulleted list"); clicked => { root.apply-format("bullet"); } }
            IconButton { icon: @image-url("../icons/lucide/outline/list-ordered.svg"); icon-color: root.secondary-color; hover-background: root.control-hover-color; tooltip-text: @tr("Numbered list"); clicked => { root.apply-format("number"); } }
            IconButton { icon: @image-url("../icons/lucide/outline/quote.svg"); icon-color: root.secondary-color; hover-background: root.control-hover-color; tooltip-text: @tr("Quote"); clicked => { root.apply-format("quote"); } }
            IconButton { icon: root.code-active ? @image-url("../icons/lucide/filled/code.svg") : @image-url("../icons/lucide/outline/code.svg"); icon-color: root.code-active ? root.accent-color : root.secondary-color; active: root.code-active; hover-background: root.control-hover-color; active-background: root.accent-background; tooltip-text: @tr("Inline code"); clicked => { root.apply-format("code"); } }
            IconButton { icon: root.link-active ? @image-url("../icons/lucide/filled/link.svg") : @image-url("../icons/lucide/outline/link.svg"); icon-color: root.link-active ? root.accent-color : root.secondary-color; active: root.link-active; active-background: root.accent-background; interactive: root.can-link; hover-background: root.control-hover-color; tooltip-text: root.can-link ? @tr("Add or edit link") : @tr("Select text to add a link"); clicked => { root.apply-format("link"); } }
            IconButton { icon: @image-url("../icons/lucide/outline/insert-image.svg"); icon-color: root.secondary-color; hover-background: root.control-hover-color; tooltip-text: @tr("Insert image"); clicked => { root.insert-image(); } }

            if root.templates-shown : Rectangle { width: 1px; height: 18px; background: root.subtle-border-color; }

            if root.templates-shown : IconButton { icon: @image-url("../icons/lucide/outline/book.svg"); icon-color: root.secondary-color; hover-background: root.control-hover-color; tooltip-text: @tr("Email templates"); clicked => { root.open-templates(); } }
        }
    }

    // Undo and redo stay in reach while the tools beside them scroll.
    trailing := HorizontalLayout {
        x: parent.width - self.width - 8px;
        y: 6px;
        width: self.preferred-width;
        height: 32px;
        spacing: 2px;

        IconButton { icon: @image-url("../icons/lucide/outline/undo.svg"); icon-color: root.secondary-color; hover-background: root.control-hover-color; tooltip-text: @tr("Undo · Ctrl+Z"); clicked => { root.undo(); } }
        IconButton { icon: @image-url("../icons/lucide/outline/redo.svg"); icon-color: root.secondary-color; hover-background: root.control-hover-color; tooltip-text: @tr("Redo · Ctrl+Shift+Z"); clicked => { root.redo(); } }
    }
}

export component ComposerAttachments inherits Rectangle {
    in property <bool> compact: false;
    in property <[ComposeAttachment]> attachments: [];
    in property <color> accent-color;
    in property <color> background-color;
    in property <color> body-color;
    in property <color> control-hover-color;
    in property <color> muted-color;
    in property <color> raised-color;
    in property <color> subtle-border-color;
    callback remove-attachment(int);
    // Chips hold a name and a detail line; both grow with the platform font.
    private property <length> chip-growth: max(16px, attachment-name-probe.preferred-height)
        + max(13px, attachment-detail-probe.preferred-height) - 29px;
    // Files wider than the strip scroll, with the scroll bar below them rather than over them.
    private property <length> bar-room: attachment-row.preferred-width > attachments-scroll.width ? 12px : 0px;

            visible: root.attachments.length > 0;
            height: root.attachments.length > 0 ? 62px + root.chip-growth + root.bar-room : 0px;
            background: root.raised-color;
            border-width: 1px;
            border-color: root.subtle-border-color;

            attachment-name-probe := Text { visible: false; text: "Ag"; font-size: TypeScale.caption; font-weight: 600; }
            attachment-detail-probe := Text { visible: false; text: "Ag"; font-size: TypeScale.caption; }

            attachments-scroll := ScrollView {
                x: 10px;
                y: 8px;
                width: parent.width - 20px;
                height: 46px + root.chip-growth + root.bar-room;
                content-width: max(self.visible-width, attachment-row.preferred-width);
                content-height: self.visible-height;
                horizontal-scrollbar-policy: as-needed;
                vertical-scrollbar-policy: always-off;
                mouse-drag-pan-enabled: root.compact;

                // The files show whole, centered where there's no scroll bar, which goes below them.
                attachment-row := HorizontalBox {
                    y: (46px + root.chip-growth - self.height) / 2;
                    height: 36px + root.chip-growth;
                    padding-top: 0px;
                    padding-bottom: 0px;
                    spacing: 7px;

                    for attachment[index] in root.attachments : Rectangle {
                        width: 194px;
                        height: 36px + root.chip-growth;
                        border-radius: 7px;
                        border-width: 1px;
                        border-color: root.subtle-border-color;
                        background: root.background-color;

                        Image {
                            x: 17px - self.width / 2;
                            y: (parent.height - self.height) / 2;
                            width: LayoutMetrics.icon-size;
                            height: LayoutMetrics.icon-size;
                            source: @image-url("../icons/lucide/outline/file-added.svg");
                            colorize: root.accent-color;
                            image-fit: contain;
                            accessible-role: none;
                        }

                        attachment-name := Text {
                            x: 32px;
                            y: 4px;
                            width: parent.width - 64px;
                            height: max(16px, self.preferred-height);
                            text: attachment.name;
                            color: root.body-color;
                            font-size: TypeScale.caption;
                            font-weight: 600;
                            overflow: elide;
                        }

                        Text {
                            x: 32px;
                            y: attachment-name.y + attachment-name.height - 1px;
                            width: parent.width - 64px;
                            height: max(13px, self.preferred-height);
                            text: attachment.detail;
                            color: root.muted-color;
                            font-size: TypeScale.caption;
                            overflow: elide;
                        }

                        IconButton {
                            x: parent.width - 29px;
                            y: (parent.height - self.height) / 2;
                            width: 28px;
                            height: 28px;
                            icon: @image-url("../icons/lucide/outline/x.svg");
                            icon-color: root.muted-color;
                            hover-background: root.control-hover-color;
                            tooltip-text: @tr("Remove attachment");
                            clicked => { root.remove-attachment(index); }
                        }
                    }
                }
            }
}

export component ComposerNotice inherits Rectangle {
    in property <string> notice: "";
    in property <bool> notice-is-error: false;
    in property <color> accent-background;
    in property <color> accent-color;

            visible: root.notice != "";
            height: root.notice == "" ? 0px : 24px;
            background: root.notice-is-error ? #d73a4920 : root.accent-background;

            Text {
                x: 14px;
                width: parent.width - 28px;
                height: parent.height;
                text: root.notice;
                color: root.notice-is-error ? #d73a49 : root.accent-color;
                font-size: TypeScale.caption;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }
}

// The message's large photos, which can go out shrunk, while it has some.
export component ComposerPhotos inherits Rectangle {
    in property <bool> compact: false;
    in property <int> count: 0;
    // Their size as they go out, and at full size.
    in property <string> size: "";
    in property <string> full-size: "";
    in-out property <bool> shrink: false;
    in property <bool> working: false;
    in property <color> body-color;
    in property <color> muted-color;
    in property <color> raised-color;
    in property <color> subtle-border-color;
    callback toggled(bool);

    private property <bool> shown: root.count > 0 || root.working;
    private property <length> inset: root.compact ? 14px : 16px;

    visible: root.shown;
    height: root.shown ? max(root.compact ? 48px : 40px, title.preferred-height + 16px) : 0px;
    background: root.raised-color;

    Rectangle {
        y: 0px;
        height: 1px;
        background: root.subtle-border-color;
    }

    title := Text {
        x: root.inset;
        width: min(self.preferred-width, max(0px, switch.x - self.x - 12px));
        height: parent.height;
        text: @tr("Shrink photos");
        color: root.body-color;
        font-size: TypeScale.body;
        font-weight: 600;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: title.x + title.width + 10px;
        width: max(0px, switch.x - self.x - 12px);
        height: parent.height;
        text: root.working ? @tr("Shrinking…")
            : root.shrink && root.size != root.full-size
            ? @tr("{n} photo, {0} ({1} at full size)" | "{n} photos, {0} ({1} at full size)" % root.count, root.size, root.full-size)
            : @tr("{n} photo, {0}" | "{n} photos, {0}" % root.count, root.size);
        color: root.muted-color;
        font-size: TypeScale.caption;
        vertical-alignment: center;
        overflow: elide;
    }

    switch := Switch {
        x: parent.width - self.width - root.inset;
        y: (parent.height - self.height) / 2;
        checked <=> root.shrink;
        control-label: @tr("Shrink photos");
        toggled => { root.toggled(self.checked); }
    }
}

export component ComposerFooter inherits Rectangle {
    in property <bool> compact: false;
    in property <bool> attachment-picker-supported: true;
    in property <string> attachment-summary: "";
    in property <bool> can-send: false;
    in property <bool> has-content: false;
    in property <bool> sending: false;
    // Photos are being shrunk to go out, which a draft waits for too.
    in property <bool> shrinking-photos: false;
    // A signature saves to Settings or is left, with nothing to send or attach.
    in property <bool> signature: false;
    callback save-signature();
    in property <color> control-hover-color;
    in property <color> muted-color;
    in property <color> raised-color;
    in property <color> secondary-color;
    in property <color> subtle-border-color;
    callback submit(bool);
    callback pick-attachments();
    callback request-close();

            height: 54px;
            background: root.raised-color;

            Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: 1px;
                background: root.subtle-border-color;
            }

            if root.signature : Button {
                x: root.compact ? 8px : 12px;
                y: 10px;
                width: max(root.compact ? 96px : 106px, self.content-width);
                height: 34px;
                text: @tr("Save signature");
                primary: true;
                enabled: !root.sending;
                clicked => { root.save-signature(); }
            }

            if root.signature : Button {
                x: parent.width - (root.compact ? 8px : 12px) - self.width;
                y: 11px;
                width: max(root.compact ? 88px : 96px, self.content-width);
                height: 32px;
                text: @tr("Cancel");
                clicked => { root.request-close(); }
            }

            send-button := Button {
                visible: !root.signature;
                x: root.compact ? 8px : 12px;
                y: 10px;
                width: max(root.compact ? 96px : 106px, self.content-width);
                height: 34px;
                text: root.sending ? @tr("Sending…") : @tr("Send");
                icon: @image-url("../icons/lucide/filled/paper-airplane.svg");
                has-icon: true;
                primary: true;
                enabled: root.can-send && !root.sending;
                clicked => { root.submit(true); }
            }

            attach-button := IconButton {
                visible: root.attachment-picker-supported && !root.signature;
                x: send-button.x + send-button.width + (root.compact ? 4px : 8px);
                y: root.compact ? 5px : 11px;
                width: root.compact ? 44px : 32px;
                height: root.compact ? 44px : 32px;
                icon: @image-url("../icons/lucide/outline/paperclip.svg");
                icon-color: root.secondary-color;
                hover-background: root.control-hover-color;
                tooltip-text: @tr("Attach files");
                clicked => { root.pick-attachments(); }
            }

            Text {
                visible: !root.compact && root.attachment-picker-supported && !root.signature;
                x: attach-button.x + attach-button.width + 8px;
                width: max(0px, save-draft.x - self.x - 42px);
                height: parent.height;
                text: root.attachment-summary == "" ? @tr("Attach files") : root.attachment-summary;
                color: root.muted-color;
                font-size: TypeScale.caption;
                vertical-alignment: center;
                overflow: elide;
            }

            save-draft := Button {
                visible: !root.signature;
                x: parent.width - (root.compact ? 54px : 90px) - self.width;
                y: 11px;
                width: max(root.compact ? 104px : 112px, self.content-width);
                height: 32px;
                text: @tr("Save draft");
                enabled: root.has-content && !root.shrinking-photos;
                clicked => { root.submit(false); }
            }

            IconButton {
                visible: !root.signature;
                x: parent.width - (root.compact ? 48px : 78px);
                y: root.compact ? 5px : 11px;
                width: root.compact ? 44px : 32px;
                height: root.compact ? 44px : 32px;
                icon: @image-url("../icons/lucide/outline/trash.svg");
                icon-color: root.secondary-color;
                hover-background: root.control-hover-color;
                tooltip-text: @tr("Discard");
                clicked => { root.request-close(); }
            }

}

// A flat labelled button for the image bar, as the toolbar's buttons are flat.
component BarButton inherits Rectangle {
    in property <string> text;
    in property <bool> has-menu: false;
    in property <color> text-color;
    in property <color> hover-background;
    callback clicked;

    height: 32px;
    width: label.preferred-width + (root.has-menu ? 34px : 20px);
    border-radius: 6px;
    border-width: keyboard.focus-visible ? 2px : 0px;
    border-color: root.text-color;
    background: area.has-hover ? root.hover-background : transparent;
    forward-focus: keyboard;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }

    label := Text {
        x: 10px;
        height: parent.height;
        text: root.text;
        color: root.text-color;
        font-size: TypeScale.body;
        font-weight: 500;
        vertical-alignment: center;
        accessible-role: none;
    }

    if root.has-menu : Image {
        x: label.x + label.preferred-width + 6px;
        y: (parent.height - self.height) / 2;
        width: 14px;
        height: 14px;
        source: @image-url("../icons/lucide/outline/chevron-down.svg");
        colorize: root.text-color;
        accessible-role: none;
    }

    keyboard := FocusVisibleScope {
        accessible-role: none;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space { root.clicked(); return accept; }
            reject
        }
    }
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { keyboard.focus(); keyboard.pointer-activated(); root.clicked(); }
    }
}

// The controls of a selected image: how wide it shows, its alt text, and taking it out.
export component ImageBar inherits Rectangle {
    // "small", "medium", "large", "original", or "custom" for a width of its own.
    in property <string> active-size;
    // The image's own width in pixels: it shows at sizes below it.
    in property <int> image-width;
    in property <color> body-color;
    in property <color> control-hover-color;
    in property <color> raised-color;
    in property <color> secondary-color;
    in property <color> subtle-border-color;
    callback apply-format(string);
    callback edit-alt();

    width: bar-row.preferred-width;
    height: 38px;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.subtle-border-color;
    background: root.raised-color;
    drop-shadow-blur: 10px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: #00000030;

    // Presses on the bar stay off the text under it.
    TouchArea { }

    bar-row := HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        alignment: start;

        size-menu := ContextMenuArea {
            width: size-button.width;
            height: 32px;

            size-button := BarButton {
                text: @tr("image" => "Size");
                has-menu: true;
                text-color: root.body-color;
                hover-background: root.control-hover-color;
                clicked => { size-menu.show({ x: 0px, y: self.height + 6px }); }
            }

            Menu {
                MenuItem { title: @tr("image size" => "Small"); checkable: true; checked: root.active-size == "small"; enabled: root.image-width > 160; activated => { root.apply-format("image-size:small"); } }
                MenuItem { title: @tr("image size" => "Medium"); checkable: true; checked: root.active-size == "medium"; enabled: root.image-width > 320; activated => { root.apply-format("image-size:medium"); } }
                MenuItem { title: @tr("image size" => "Large"); checkable: true; checked: root.active-size == "large"; enabled: root.image-width > 640; activated => { root.apply-format("image-size:large"); } }
                MenuItem { title: @tr("image size" => "Original size"); checkable: true; checked: root.active-size == "original"; activated => { root.apply-format("image-size:original"); } }
            }
        }

        BarButton {
            text: @tr("Alt text");
            text-color: root.body-color;
            hover-background: root.control-hover-color;
            clicked => { root.edit-alt(); }
        }

        Rectangle {
            width: 1px;
            Rectangle { y: (parent.height - self.height) / 2; width: 1px; height: 18px; background: root.subtle-border-color; }
        }

        IconButton {
            icon: @image-url("../icons/lucide/outline/trash.svg");
            icon-color: root.secondary-color;
            hover-background: root.control-hover-color;
            tooltip-text: @tr("Remove image");
            clicked => { root.apply-format("delete"); }
        }
    }
}

// A handle on each corner of a selected image, to drag it to the width wanted. While one
// moves, an outline shows the size the image will have from the opposite corner, and the
// image takes that width when the drag ends. Images keep their shape and never grow past
// their own width.
export component ImageResizeFrame inherits Rectangle {
    // The width and height the image shows at in the editor.
    in property <length> image-width;
    in property <length> image-height;
    // Its width as shown and its own width, in CSS pixels.
    in property <int> shown-css-width;
    in property <int> natural-width;
    // The widest it can show in the editor.
    in property <length> room;
    in property <color> accent-color;
    in property <color> handle-color;
    callback resized(int);

    private property <bool> dragging: false;
    private property <bool> drag-right: true;
    private property <bool> drag-bottom: true;
    private property <length> outline-width: root.image-width;
    private property <float> aspect: root.image-height / max(1px, root.image-width);
    // CSS pixels for each pixel of the editor, at the size shown.
    private property <float> css-scale: root.shown-css-width / max(1, root.image-width / 1px);
    private property <length> narrowest: 16px / max(0.01, root.css-scale);
    private property <length> widest: min(root.room, root.natural-width * 1px / max(0.01, root.css-scale));

    width: root.image-width;
    height: root.image-height;

    if root.dragging : Rectangle {
        x: root.drag-right ? 0px : root.image-width - root.outline-width;
        y: root.drag-bottom ? 0px : root.image-height - root.outline-width * root.aspect;
        width: root.outline-width;
        height: root.outline-width * root.aspect;
        border-width: 2px;
        border-color: root.accent-color;
        background: root.accent-color.with-alpha(0.12);
    }

    for corner in [
        { right: false, bottom: false },
        { right: true, bottom: false },
        { right: false, bottom: true },
        { right: true, bottom: true },
    ] : Rectangle {
        x: (corner.right ? root.image-width : 0px) - 6px;
        y: (corner.bottom ? root.image-height : 0px) - 6px;
        width: 12px;
        height: 12px;
        border-radius: 3px;
        border-width: 2px;
        border-color: root.accent-color;
        background: root.handle-color;
        accessible-role: none;

        TouchArea {
            x: -8px;
            y: -8px;
            width: 28px;
            height: 28px;
            mouse-cursor: corner.right == corner.bottom ? nwse-resize : nesw-resize;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    root.drag-right = corner.right;
                    root.drag-bottom = corner.bottom;
                    root.outline-width = root.image-width;
                    root.dragging = true;
                } else if (event.kind == PointerEventKind.up && root.dragging) {
                    root.dragging = false;
                    if (abs(root.outline-width - root.image-width) >= 1px) {
                        root.resized(round(root.outline-width / 1px * root.css-scale));
                    }
                } else if (event.kind == PointerEventKind.cancel) {
                    root.dragging = false;
                }
            }
            moved => {
                if (root.dragging) {
                    root.outline-width = clamp(
                        root.image-width + (corner.right ? 1 : -1) * (self.mouse-x - self.pressed-x),
                        min(root.narrowest, root.widest),
                        root.widest,
                    );
                }
            }
        }
    }
}

// Asks for a selected image's alt text, the words that stand for it for people who
// can't see it. Left empty, the image counts as decoration.
export component ImageAltEditor inherits Rectangle {
    in property <bool> compact: false;
    in property <bool> open: false;
    in-out property <string> alt: "";
    in property <color> background-color;
    in property <color> body-color;
    in property <color> frame-border-color;
    in property <color> muted-color;
    in property <color> title-color;
    in property <color> accent-color;
    callback cancel();
    callback apply(string);

    visible: root.open;
    background: #00000066;
    z: 6000;
    TouchArea { }

    changed open => {
        if (root.open) {
            alt-input.focus();
            alt-input.select-all();
        }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.compact ? min(380px, parent.width - 32px) : 420px;
        height: alt-field.y + 124px;
        border-radius: 10px;
        border-width: 1px;
        border-color: root.frame-border-color;
        background: root.background-color;

        alt-heading := Text {
            x: 20px;
            y: 18px;
            width: parent.width - 40px;
            height: max(24px, self.preferred-height);
            text: @tr("Alt text");
            color: root.title-color;
            font-size: TypeScale.heading-small;
            font-weight: 700;
        }

        alt-note := Text {
            x: 20px;
            y: alt-heading.y + alt-heading.height + 6px;
            width: parent.width - 40px;
            height: max(20px, self.preferred-height);
            text: @tr("Screen readers read it in place of the image. Leave it empty if the image is only decoration.");
            color: root.muted-color;
            font-size: TypeScale.secondary;
            wrap: word-wrap;
        }

        alt-field := Rectangle {
            x: 20px;
            y: alt-note.y + alt-note.height + 10px;
            width: parent.width - 40px;
            height: 38px;
            border-radius: 7px;
            border-width: 1px;
            border-color: alt-input.has-focus ? root.accent-color : root.frame-border-color;
            background: root.background-color;

            Text {
                x: 11px;
                width: parent.width - 22px;
                height: parent.height;
                visible: root.alt == "";
                text: @tr("Describe the image");
                color: root.muted-color;
                font-size: TypeScale.body;
                vertical-alignment: center;
            }

            alt-input := TextInput {
                x: 11px;
                width: parent.width - 22px;
                height: parent.height;
                text <=> root.alt;
                color: root.body-color;
                selection-background-color: root.accent-color;
                selection-foreground-color: white;
                font-size: TypeScale.body;
                single-line: true;
                vertical-alignment: center;
                accessible-label: @tr("Alt text");
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        root.cancel();
                        return accept;
                    }
                    if (event.text == Key.Return) {
                        root.apply(root.alt);
                        return accept;
                    }
                    reject
                }
            }
        }

        Button {
            x: alt-apply.x - self.width - 8px;
            y: alt-apply.y;
            width: max(78px, self.content-width);
            height: 34px;
            text: @tr("Cancel");
            clicked => { root.cancel(); }
        }

        alt-apply := Button {
            x: parent.width - self.width - 20px;
            y: alt-field.y + 68px;
            width: max(82px, self.content-width);
            height: 34px;
            text: @tr("Apply");
            primary: true;
            clicked => { root.apply(root.alt); }
        }
    }
}

export component LinkEditor inherits Rectangle {
    in property <bool> compact: false;
    in property <bool> open: false;
    in-out property <string> url: "";
    in property <bool> has-existing-link: false;
    in property <color> background-color;
    in property <color> body-color;
    in property <color> frame-border-color;
    in property <color> muted-color;
    in property <color> title-color;
    in property <color> accent-color;
    callback cancel();
    callback apply(string);
    callback remove();

    visible: root.open;
    background: #00000066;
    z: 6000;
    TouchArea { }

    changed open => {
        if (root.open) {
            link-input.focus();
            link-input.select-all();
        }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.compact ? min(380px, parent.width - 32px) : 420px;
        height: link-field.y + 124px;
        border-radius: 10px;
        border-width: 1px;
        border-color: root.frame-border-color;
        background: root.background-color;

        link-heading := Text {
            x: 20px;
            y: 18px;
            width: parent.width - 40px;
            height: max(24px, self.preferred-height);
            text: root.has-existing-link ? @tr("Edit link") : @tr("Add link");
            color: root.title-color;
            font-size: TypeScale.heading-small;
            font-weight: 700;
        }

        link-note := Text {
            x: 20px;
            y: link-heading.y + link-heading.height + 6px;
            width: parent.width - 40px;
            height: max(20px, self.preferred-height);
            text: @tr("The selected text will open this address.");
            color: root.muted-color;
            font-size: TypeScale.secondary;
            wrap: word-wrap;
        }

        link-field := Rectangle {
            x: 20px;
            y: link-note.y + link-note.height + 10px;
            width: parent.width - 40px;
            height: 38px;
            border-radius: 7px;
            border-width: 1px;
            border-color: link-input.has-focus ? root.accent-color : root.frame-border-color;
            background: root.background-color;

            Text {
                x: 11px;
                width: parent.width - 22px;
                height: parent.height;
                visible: root.url == "";
                text: @tr("https://example.com");
                color: root.muted-color;
                font-size: TypeScale.body;
                vertical-alignment: center;
            }

            link-input := TextInput {
                x: 11px;
                width: parent.width - 22px;
                height: parent.height;
                text <=> root.url;
                color: root.body-color;
                selection-background-color: root.accent-color;
                selection-foreground-color: white;
                font-size: TypeScale.body;
                single-line: true;
                vertical-alignment: center;
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        root.cancel();
                        return accept;
                    }
                    if (event.text == Key.Return && root.url != "") {
                        root.apply(root.url);
                        return accept;
                    }
                    reject
                }
            }
        }

        if root.has-existing-link : Button {
            x: 20px;
            y: link-field.y + 68px;
            width: max(104px, self.content-width);
            height: 34px;
            text: @tr("Remove link");
            clicked => { root.remove(); }
        }

        Button {
            x: link-apply.x - self.width - 8px;
            y: link-apply.y;
            width: max(78px, self.content-width);
            height: 34px;
            text: @tr("Cancel");
            clicked => { root.cancel(); }
        }

        link-apply := Button {
            x: parent.width - self.width - 20px;
            y: link-field.y + 68px;
            width: max(82px, self.content-width);
            height: 34px;
            text: @tr("Apply");
            primary: true;
            enabled: root.url != "";
            clicked => { root.apply(root.url); }
        }
    }
}

export component DiscardConfirmation inherits Rectangle {
    in property <bool> compact: false;
    in property <bool> open: false;
    in property <bool> signature: false;
    in property <color> background-color;
    in property <color> frame-border-color;
    in property <color> secondary-color;
    in property <color> title-color;
    callback keep();
    callback discard();

    visible: root.open;
    background: #00000066;
    // Above the link editor and the templates, which a window's own close
    // button can leave open.
    z: 8000;
    TouchArea { }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: root.compact ? min(360px, parent.width - 32px) : 360px;
            height: discard-message.y + discard-message.height + 75px;
            border-radius: 10px;
            border-width: 1px;
            border-color: root.frame-border-color;
            background: root.background-color;

            discard-heading := Text {
                x: 20px;
                y: 20px;
                width: parent.width - 40px;
                height: max(24px, self.preferred-height);
                text: root.signature ? @tr("Discard changes to this signature?") : @tr("Discard this draft?");
                color: root.title-color;
                font-size: TypeScale.heading-small;
                font-weight: 700;
            }

            discard-message := Text {
                x: 20px;
                y: discard-heading.y + discard-heading.height + 7px;
                width: parent.width - 40px;
                height: max(38px, self.preferred-height);
                text: root.signature ? @tr("What you changed since it was last saved won't be kept.") : @tr("The message and its attachments will be removed from this composer.");
                color: root.secondary-color;
                font-size: TypeScale.secondary;
                wrap: word-wrap;
            }

            Button {
                x: discard-button.x - self.width - 8px;
                y: discard-button.y;
                width: max(78px, self.content-width);
                height: 34px;
                text: @tr("Keep");
                clicked => { root.keep(); }
            }

            discard-button := Button {
                x: parent.width - self.width - 20px;
                y: discard-message.y + discard-message.height + 19px;
                width: max(86px, self.content-width);
                height: 34px;
                text: @tr("Discard");
                primary: true;
                clicked => {
                    root.keep();
                    root.discard();
                }
            }
        }
}
