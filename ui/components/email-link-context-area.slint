import { PopupMenu } from "popup-menu.slint";

export component EmailLinkContextArea {
    in property <string> url;
    in property <bool> enabled: true;
    callback open-link;
    callback copy-link;

    TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.open-link(); }
        // A right click offers to open or copy the link.
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                menu.open-at(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, false);
            }
        }
    }

    menu := PopupMenu {
        label: root.url;
        entries: [
            { id: "open", title: @tr("Open link") },
            { id: "copy", title: @tr("Copy link") },
        ];
        activated(id, index) => {
            if id == "open" {
                root.open-link();
            } else {
                root.copy-link();
            }
        }
    }
}
