import { TypeScale } from "../typography.slint";

// A single avatar primitive for people, accounts, and sender brands. The
// caller owns the image data; this component owns circular clipping, fallback
// initials, sizing, and consistent image sampling across the application.
export component Avatar inherits Rectangle {
    in property <image> source;
    in property <bool> has-source: false;
    in property <string> fallback: "?";
    in property <length> size: 40px;
    in property <color> background-color: #f1f1ef;
    in property <color> foreground-color: #4b4c49;
    // The palette slot, 0 to 5, of a person or account without a photo,
    // from their address (src/avatar_tone.rs), so they keep one color in
    // every view. -1 draws `background-color` instead.
    in property <int> color-tone: -1;
    in property <color> avatar-border-color: transparent;
    in property <length> avatar-border-width: 0px;
    in property <ImageFit> image-fit: cover;
    // Six gradients, a lighter hue at the top left deepening to the bottom
    // right. White initials pass 4.5:1 from 30% of the way on, in both
    // themes.
    private property <brush> tone-background: root.color-tone == 0 ? @linear-gradient(135deg, #3b82f6 0%, #4338ca 100%)
        : root.color-tone == 1 ? @linear-gradient(135deg, #8b5cf6 0%, #a21caf 100%)
        : root.color-tone == 2 ? @linear-gradient(135deg, #e1540c 0%, #be123c 100%)
        : root.color-tone == 3 ? @linear-gradient(135deg, #e74796 0%, #9d174d 100%)
        : root.color-tone == 4 ? @linear-gradient(135deg, #c86d06 0%, #b91c1c 100%)
        : @linear-gradient(135deg, #058e64 0%, #0f766e 100%);
    private property <color> tone-foreground: #ffffff;
    // Initials keep at least the caption size, but shrink to fit the circle
    // where the platform font makes them wider than a small avatar.
    private property <length> initials-size: max(TypeScale.caption, root.size * 0.29);

    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    // Downloaded rasters carry their own antialiased circular alpha mask.
    // Keeping the source surface transparent prevents opaque square corners
    // from showing through on software-rendered views.
    background: root.has-source ? transparent
        : root.color-tone >= 0 ? root.tone-background
        : root.background-color;
    clip: true;

    if root.has-source : Image {
        width: parent.width;
        height: parent.height;
        source: root.source;
        image-fit: root.image-fit;
        image-rendering: smooth;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }

    if !root.has-source : Rectangle {
        initials-measure := Text {
            visible: false;
            text: root.fallback;
            font-size: root.initials-size;
            font-weight: 700;
        }
        Text {
            width: parent.width;
            height: parent.height;
            text: root.fallback;
            color: root.color-tone >= 0 ? root.tone-foreground : root.foreground-color;
            font-size: root.initials-size * min(1, (root.size - 1px) / max(1px, initials-measure.preferred-width));
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    // Draw the outline after the image so full-bleed photos cannot cover it.
    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: root.size / 2;
        border-width: root.avatar-border-width;
        border-color: root.avatar-border-color;
        background: transparent;
    }
}
