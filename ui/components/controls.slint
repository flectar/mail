import { AppTheme, LayoutMetrics } from "../design-system.slint";
import { TypeScale } from "../typography.slint";

export component LineEdit inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder-text;
    in property <string> input-label;
    in property <InputType> input-type: InputType.text;
    in property <bool> enabled: true;
    in property <bool> read-only: false;
    in property <bool> invalid: false;
    in property <bool> show-leading-icon: false;
    in property <image> leading-icon;
    in property <color> leading-icon-color: AppTheme.secondary;
    in property <length> trailing-content-width: 0px;
    private property <length> text-inset: root.show-leading-icon ? 40px : 12px;
    callback edited(string);
    callback accepted(string);
    callback select-all;
    callback copy;
    out property <bool> has-focus: editor.has-focus;
    forward-focus: editor;

    height: 36px;
    min-width: 80px;
    border-radius: LayoutMetrics.corner-radius - 2px;
    border-width: 1px;
    border-color: root.invalid ? AppTheme.destructive
        : editor.has-focus ? AppTheme.accent : AppTheme.input-border;
    background: AppTheme.input-bg;
    opacity: root.enabled ? 1 : 0.5;

    Text {
        x: root.text-inset;
        width: max(0px, parent.width - root.text-inset - 12px - root.trailing-content-width);
        height: parent.height;
        visible: root.text == "";
        text: root.placeholder-text;
        color: AppTheme.placeholder;
        font-size: TypeScale.body;
        vertical-alignment: center;
        overflow: elide;
    }

    editor := TextInput {
        x: root.text-inset;
        width: max(0px, parent.width - root.text-inset - 12px - root.trailing-content-width);
        height: parent.height;
        text: root.text;
        color: AppTheme.heading;
        selection-background-color: AppTheme.accent;
        selection-foreground-color: white;
        font-size: TypeScale.body;
        single-line: true;
        vertical-alignment: center;
        input-type: root.input-type;
        accessible-label: root.input-label;
        enabled: root.enabled;
        read-only: root.read-only;
        edited => {
            root.text = self.text;
            root.edited(self.text);
        }
        accepted => { root.accepted(self.text); }
    }

    if root.show-leading-icon : Image {
        x: 12px;
        y: (parent.height - 18px) / 2;
        width: 18px;
        height: 18px;
        source: root.leading-icon;
        colorize: root.leading-icon-color;
        image-fit: contain;
        accessible-role: none;
    }

    select-all => { editor.select-all(); }
    copy => { editor.copy(); }
}

export component TextEdit inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder-text;
    in property <bool> enabled: true;
    in property <bool> read-only: false;
    in property <length> font-size: TypeScale.body;
    callback edited(string);
    callback select-all;
    callback copy;

    min-height: 80px;
    border-radius: LayoutMetrics.corner-radius - 2px;
    border-width: 1px;
    border-color: editor.has-focus ? AppTheme.accent : AppTheme.input-border;
    background: AppTheme.input-bg;
    opacity: root.enabled ? 1 : 0.5;

    Text {
        x: 12px;
        y: 10px;
        width: parent.width - 24px;
        visible: root.text == "";
        text: root.placeholder-text;
        color: AppTheme.placeholder;
        font-size: root.font-size;
        wrap: word-wrap;
    }

    editor := TextInput {
        x: 12px;
        y: 10px;
        width: parent.width - 24px;
        height: parent.height - 20px;
        text: root.text;
        color: AppTheme.heading;
        selection-background-color: AppTheme.accent;
        selection-foreground-color: white;
        font-size: root.font-size;
        single-line: false;
        wrap: word-wrap;
        enabled: root.enabled;
        read-only: root.read-only;
        edited => {
            root.text = self.text;
            root.edited(self.text);
        }
    }

    select-all => { editor.select-all(); }
    copy => { editor.copy(); }
}

export component Switch inherits Rectangle {
    in-out property <bool> checked: false;
    in property <bool> enabled: true;
    callback toggled;

    width: 38px;
    height: 22px;
    border-radius: 11px;
    background: root.checked ? AppTheme.accent : AppTheme.control-border;
    opacity: root.enabled ? 1 : 0.45;

    Rectangle {
        x: root.checked ? parent.width - self.width - 3px : 3px;
        y: 3px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: white;
    }

    TouchArea {
        x: (parent.width - max(parent.width, 44px)) / 2;
        y: (parent.height - 44px) / 2;
        width: max(parent.width, 44px);
        height: 44px;
        accessible-role: switch;
        accessible-label: root.checked ? @tr("On") : @tr("Off");
        accessible-checked: root.checked;
        enabled: root.enabled;
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
        mouse-cursor: pointer;
    }
}

// Shared tri-state control for list selection. The component owns its hit
// target and accessibility contract while callers decide when it is visible.
export component SelectionCheckBox inherits FocusScope {
    in property <bool> checked: false;
    in property <bool> indeterminate: false;
    in property <bool> avatar-overlay: false;
    callback toggled(bool);

    width: 32px;
    height: 32px;
    opacity: root.enabled ? 1 : 0.45;
    focus-on-click: true;
    focus-on-tab-navigation: true;
    accessible-role: checkbox;
    accessible-label: root.checked ? @tr("Clear selection") : @tr("Select");
    accessible-checked: root.checked;
    accessible-action-default => {
        if root.enabled {
            root.toggled(!root.checked);
        }
    }
    key-pressed(event) => {
        if event.text == Key.Return || event.text == Key.Space {
            root.toggled(!root.checked);
            return accept;
        }
        reject
    }

    Rectangle {
        x: (parent.width - 24px) / 2;
        y: (parent.height - 24px) / 2;
        width: 24px;
        height: 24px;
        border-radius: root.avatar-overlay ? self.width / 2 : 6px;
        border-width: root.has-focus ? 2px : 0px;
        border-color: AppTheme.accent;
        background: root.avatar-overlay ? AppTheme.surface.with-alpha(0.72) : transparent;
        drop-shadow-blur: root.avatar-overlay ? 7px : 0px;
        drop-shadow-offset-y: root.avatar-overlay ? 1px : 0px;
        drop-shadow-color: root.avatar-overlay ? #00000038 : transparent;

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 18px;
            height: 18px;
            border-radius: 4px;
            border-width: root.checked || root.indeterminate ? 0px : 1px;
            border-color: AppTheme.secondary;
            background: root.checked || root.indeterminate ? AppTheme.accent : AppTheme.input-bg;

            Image {
                visible: root.checked || root.indeterminate;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 12px;
                height: 12px;
                source: root.indeterminate
                    ? @image-url("../icons/phosphor/minus.svg")
                    : @image-url("../icons/phosphor/check.svg");
                colorize: white;
                image-fit: contain;
                accessible-role: none;
            }
        }
    }

    TouchArea {
        x: (parent.width - max(parent.width, 44px)) / 2;
        y: (parent.height - max(parent.height, 44px)) / 2;
        width: max(parent.width, 44px);
        height: max(parent.height, 44px);
        enabled: root.enabled;
        clicked => { root.toggled(!root.checked); }
        mouse-cursor: pointer;
    }
}

export component RadioButton inherits Rectangle {
    in property <string> text;
    in property <bool> checked: false;
    callback clicked;

    height: 28px;
    min-width: label.preferred-width + 28px;
    background: transparent;

    Rectangle {
        x: 1px;
        y: (parent.height - 16px) / 2;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        border-width: 1px;
        border-color: root.checked ? AppTheme.accent : AppTheme.secondary;
        background: transparent;

        Rectangle {
            visible: root.checked;
            x: 4px;
            y: 4px;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: AppTheme.accent;
        }
    }

    label := Text {
        x: 24px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.text;
        color: AppTheme.body;
        font-size: TypeScale.body;
        vertical-alignment: center;
    }

    TouchArea {
        y: (parent.height - 44px) / 2;
        height: 44px;
        accessible-role: radio-button;
        accessible-label: root.text;
        accessible-checked: root.checked;
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

// A single geometry for compact toolbar actions keeps every SVG optically
// centered regardless of the host platform's native Button padding.
// Show help for one input modality at a time, so keyboard focus does not
// overlap the tooltip beneath a stationary pointer on another button.
global IconButtonInput {
    in-out property <bool> keyboard: false;
}

export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <color> icon-color;
    in property <color> idle-background: #00000000;
    in property <color> hover-background: idle-background;
    in property <color> active-background: idle-background;
    in property <color> primary-background: AppTheme.primary;
    // Match Button's primary palette so icon-only and labeled actions have
    // the same visual weight in every color scheme.
    in property <color> primary-hover-background: AppTheme.primary-hover;
    in property <color> primary-pressed-background: AppTheme.primary-pressed;
    in property <bool> ghost: false;
    in property <bool> primary: false;
    in property <bool> active: false;
    in property <bool> interactive: true;
    in property <length> icon-size: 18px;
    in property <string> tooltip-text: "";
    in property <bool> tooltip-above: false;
    in property <bool> tooltip-align-left: false;
    callback clicked;

    width: 32px;
    height: 32px;
    border-radius: LayoutMetrics.corner-radius - 2px;
    background: root.primary
        ? (hit-area.pressed ? root.primary-pressed-background : hit-area.has-hover ? root.primary-hover-background : root.primary-background)
        : root.ghost
            ? (hit-area.pressed || root.active ? root.active-background : hit-area.has-hover ? root.hover-background : transparent)
            : root.active ? root.active-background : hit-area.has-hover ? root.hover-background : root.idle-background;
    forward-focus: keyboard;
    border-width: keyboard.has-focus ? 2px : 0px;
    border-color: AppTheme.accent;
    opacity: root.interactive ? 1 : 0.42;
    accessible-role: button;
    accessible-label: root.tooltip-text;
    accessible-action-default => {
        if root.interactive {
            root.clicked();
        }
    }

    Image {
        x: (parent.width - root.icon-size) / 2;
        y: (parent.height - root.icon-size) / 2;
        width: root.icon-size;
        height: root.icon-size;
        source: root.icon;
        colorize: root.primary ? white : root.icon-color;
        image-fit: contain;
        accessible-role: none;
    }

    keyboard := FocusScope {
        enabled: root.interactive;
        changed has-focus => { if self.has-focus { IconButtonInput.keyboard = true; } }
        focus-on-tab-navigation: true;
        accessible-role: none;
        key-pressed(event) => {
            IconButtonInput.keyboard = true;
            if root.interactive && (event.text == Key.Return || event.text == Key.Space) {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    hit-area := TouchArea {
        enabled: root.interactive;
        moved => { IconButtonInput.keyboard = false; }
        clicked => { keyboard.focus(); IconButtonInput.keyboard = false; root.clicked(); }
        mouse-cursor: pointer;
    }

    // Keep action help inside the main scene. Native Tooltip uses a popup
    // surface, which is not consistently presented by every AppImage/Wayland
    // compositor combination.
    Rectangle {
        visible: root.tooltip-text != "" && (IconButtonInput.keyboard ? keyboard.has-focus : hit-area.has-hover);
        x: root.tooltip-align-left ? 0px : parent.width - self.width;
        y: root.tooltip-above ? -self.height - 6px : parent.height + 6px;
        width: tooltip-label.preferred-width + 16px;
        height: 28px;
        border-radius: 5px;
        background: #292929;
        z: 10000;

        tooltip-label := Text {
            text: root.tooltip-text;
            color: white;
            font-size: TypeScale.secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// Primary actions that replace a collapsed workspace sidebar float above the
// list surface. Keeping the geometry here makes mail and contacts identical.
export component FloatingActionButton inherits IconButton {
    width: LayoutMetrics.touch-target + 8px;
    height: LayoutMetrics.touch-target + 8px;
    border-radius: self.width / 2;
    icon-size: 22px;
    primary: true;
    tooltip-above: true;
    drop-shadow-blur: 12px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: #00000040;
}

// Canonical app-bar action geometry. Toolbars opt into this component instead
// of choosing 32/40/44px independently on every screen.
export component ToolbarIconButton inherits IconButton {
    in property <bool> compact: false;

    width: root.compact ? LayoutMetrics.touch-target : LayoutMetrics.desktop-icon-button-size;
    height: root.compact ? LayoutMetrics.touch-target : LayoutMetrics.desktop-icon-button-size;
    icon-size: root.compact ? LayoutMetrics.compact-toolbar-icon-size : LayoutMetrics.desktop-toolbar-icon-size;
    // App-bar actions are visually quiet until hovered, pressed, or active.
    // Primary actions still use IconButton's primary branch.
    ghost: true;
}
