import { ComboBox, HorizontalBox, VerticalBox } from "std-widgets.slint";
import { LineEdit, Switch } from "controls.slint";
import { TypeScale } from "../typography.slint";

// Settings navigation is intentionally separate from MailSidebar: the latter
// owns mailbox models, compose actions, and tree expansion state.
export component SettingsNavItem inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> selected: false;
    in property <color> accent;
    in property <color> accent-soft;
    in property <color> body-text;
    in property <color> muted-text;
    callback clicked;

    height: 36px;
    border-radius: 7px;
    background: root.selected ? root.accent-soft : nav-hit.has-hover ? root.accent-soft : transparent;

    Image {
        x: 10px;
        y: (parent.height - self.height) / 2;
        width: 17px;
        height: 17px;
        source: root.icon;
        colorize: root.selected ? root.accent : root.muted-text;
        image-fit: contain;
        accessible-role: none;
    }
    Text {
        x: 37px;
        width: parent.width - 47px;
        height: parent.height;
        text: root.text;
        color: root.selected ? root.accent : root.body-text;
        font-size: TypeScale.body;
        font-weight: root.selected ? 700 : 500;
        vertical-alignment: center;
        overflow: elide;
    }
    nav-hit := TouchArea {
        accessible-role: button;
        accessible-label: root.text;
        accessible-checked: root.selected;
        accessible-action-default => { root.clicked(); }
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

export component SettingsCard inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <color> surface;
    in property <color> card-border-color;
    in property <color> heading;
    in property <color> secondary-text;

    background: root.surface;
    border-radius: 10px;
    border-width: 1px;
    border-color: root.card-border-color;

    Text {
        x: 20px;
        y: 17px;
        width: parent.width - 40px;
        height: 20px;
        text: root.title;
        color: root.heading;
        font-size: TypeScale.subtitle;
        font-weight: 700;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: 20px;
        y: 41px;
        width: parent.width - 40px;
        height: 17px;
        text: root.description;
        color: root.secondary-text;
        font-size: TypeScale.caption;
        vertical-alignment: center;
        overflow: elide;
    }
}

// Shared preference row for boolean appearance and behavior settings. Keeping
// the label, description, touch target, and spacing here prevents individual
// settings cards from slowly drifting apart.
export component SettingsSwitchRow inherits Rectangle {
    in property <bool> compact: false;
    in property <string> title;
    in property <string> description;
    in property <bool> checked: false;
    in property <bool> enabled: true;
    in property <color> title-color;
    in property <color> description-color;
    callback toggled(bool);

    height: root.compact ? 78px : 48px;
    opacity: root.enabled ? 1 : 0.5;

    HorizontalBox {
        spacing: 16px;
        VerticalBox {
            horizontal-stretch: 1;
            min-width: 0px;
            spacing: 2px;
            Text {
                text: root.title;
                color: root.title-color;
                font-size: TypeScale.body;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                height: root.compact ? 34px : 17px;
                text: root.description;
                color: root.description-color;
                font-size: TypeScale.caption;
                wrap: word-wrap;
            }
        }
        Switch {
            checked: root.checked;
            enabled: root.enabled;
            toggled => { root.toggled(self.checked); }
        }
    }
}

// A small app-level wrapper keeps select geometry consistent while retaining
// the platform widget's keyboard navigation, popup behavior, and accessibility.
export component SettingsSelect inherits ComboBox {
    in property <[string]> choices;
    in-out property <int> selected-index: 0;
    callback selection-changed(int, string);

    model: root.choices;
    current-index <=> root.selected-index;
    height: 36px;
    min-width: 180px;

    selected(value) => {
        root.selection-changed(root.selected-index, value);
    }
}

export component SettingsSelectRow inherits Rectangle {
    in property <bool> compact: false;
    in property <length> compact-description-height: 34px;
    in property <string> title;
    in property <string> description;
    in property <[string]> choices;
    in-out property <int> selected-index: 0;
    in property <color> title-color;
    in property <color> description-color;
    callback selected(int, string);

    height: root.compact ? 70px + root.compact-description-height : 58px;
    vertical-stretch: 0;

    if !root.compact : HorizontalBox {
        spacing: 20px;
        VerticalBox {
            spacing: 2px;
            Text {
                text: root.title;
                color: root.title-color;
                font-size: TypeScale.body;
                font-weight: 600;
            }
            Text {
                height: 17px;
                text: root.description;
                color: root.description-color;
                font-size: TypeScale.caption;
                overflow: elide;
            }
        }
        Rectangle { horizontal-stretch: 1; }
        SettingsSelect {
            width: 210px;
            choices: root.choices;
            selected-index <=> root.selected-index;
            selection-changed(index, value) => { root.selected(index, value); }
        }
    }

    if root.compact : VerticalBox {
        spacing: 7px;
        Text {
            height: 20px;
            text: root.title;
            color: root.title-color;
            font-size: TypeScale.body;
            font-weight: 600;
        }
        Text {
            height: root.compact-description-height;
            text: root.description;
            color: root.description-color;
            font-size: TypeScale.caption;
            wrap: word-wrap;
        }
        SettingsSelect {
            width: parent.width;
            choices: root.choices;
            selected-index <=> root.selected-index;
            selection-changed(index, value) => { root.selected(index, value); }
        }
    }
}

export component SettingsLinkRow inherits Rectangle {
    in property <string> text;
    in property <string> description;
    in property <image> icon;
    in property <bool> colorize-icon: true;
    in property <color> accent;
    in property <color> body-text;
    in property <color> muted-text;
    in property <color> hover-background;
    callback clicked;

    height: 52px;
    border-radius: 7px;
    background: link-hit.has-hover ? root.hover-background : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-description: root.description;
    accessible-action-default => { root.clicked(); }

    Image {
        x: 10px;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        source: root.icon;
        colorize: root.colorize-icon ? root.accent : transparent;
        image-fit: contain;
        accessible-role: none;
    }
    VerticalBox {
        x: 40px;
        y: 7px;
        width: parent.width - 80px;
        height: parent.height - 14px;
        spacing: 1px;
        Text { text: root.text; color: root.body-text; font-size: TypeScale.body; font-weight: 600; overflow: elide; }
        Text { text: root.description; color: root.muted-text; font-size: TypeScale.caption; overflow: elide; }
    }
    Text {
        x: parent.width - 28px;
        width: 18px;
        height: parent.height;
        text: "↗";
        color: root.accent;
        font-size: TypeScale.body;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    link-hit := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

export component ShortcutRow inherits Rectangle {
    in property <string> title;
    in property <string> shortcut;
    in property <color> title-color;
    in property <color> shortcut-color;
    in property <color> key-background;
    in property <color> key-border;

    height: 40px;
    Text {
        x: 0px;
        width: parent.width - 52px;
        height: parent.height;
        text: root.title;
        color: root.title-color;
        font-size: TypeScale.body;
        vertical-alignment: center;
        overflow: elide;
    }
    Rectangle {
        x: parent.width - self.width;
        y: (parent.height - self.height) / 2;
        width: max(32px, key-label.preferred-width + 16px);
        height: 26px;
        border-radius: 5px;
        border-width: 1px;
        border-color: root.key-border;
        background: root.key-background;
        key-label := Text {
            text: root.shortcut;
            color: root.shortcut-color;
            font-size: TypeScale.caption;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component FormField inherits VerticalBox {
    in property <bool> enabled: true;
    in property <string> label;
    in-out property <string> value;
    in property <string> placeholder;
    in property <InputType> input-type: InputType.text;
    in property <color> label-color;
    callback edited(string);

    padding: 0px;
    spacing: 5px;
    Text {
        height: 16px;
        text: root.label;
        color: root.label-color;
        font-size: TypeScale.caption;
        font-weight: 600;
        vertical-alignment: center;
    }
    LineEdit {
        enabled: root.enabled;
        height: 36px;
        text: root.value;
        placeholder-text: root.placeholder;
        input-type: root.input-type;
        edited(value) => {
            root.value = value;
            root.edited(value);
        }
    }
}
