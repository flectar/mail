import { HorizontalBox, VerticalBox, ScrollView } from "std-widgets.slint";
import { AppIcon } from "../app-icon.slint";
import { Button } from "../components/button.slint";
import { LineEdit } from "../components/controls.slint";
import { AppTheme } from "../design-system.slint";
import { TypeScale } from "../typography.slint";

// Drafts stay local until the host confirms that settings were persisted.
export component OAuthSetupDialog inherits Rectangle {
    in-out property <bool> open: false;
    in property <bool> google-available;
    in property <bool> microsoft-available;
    in property <bool> google-bundled;
    in property <bool> microsoft-bundled;
    in property <string> google-client-id;
    in property <string> google-client-secret;
    in property <string> ms-client-id;
    callback save(string, string, string);
    in property <bool> saving: false;
    in-out property <string> save-error: "";
    // The provider shown first, "google" or "microsoft", and why the dialog
    // opened, such as an account that can't sign in here without keys.
    in property <string> provider: "google";
    in property <string> reason: "";
    private property <bool> google: true;
    // Each kind of device has its own registration, as the providers want.
    private property <string> platform: AppIcon.platform;
    private property <bool> phone: root.platform == "android" || root.platform == "ios";
    private property <string> draft-google-id;
    private property <string> draft-google-secret;
    private property <string> draft-ms-id;

    visible: root.open;
    background: AppTheme.scrim;
    accessible-role: groupbox;
    accessible-label: @tr("Sign-in settings");
    changed open => {
        if root.open {
            root.google = root.provider != "microsoft";
            root.draft-google-id = root.google-client-id;
            root.draft-google-secret = root.google-client-secret;
            root.draft-ms-id = root.ms-client-id;
            root.save-error = "";
            dialog-focus.focus();
        } else {
            root.draft-google-secret = "";
        }
    }
    TouchArea { }
    panel := Rectangle {
        width: min(480px, parent.width - 32px);
        height: min(560px, parent.height - 32px);
        border-radius: 14px;
        border-width: 1px;
        border-color: AppTheme.control-border;
        background: AppTheme.surface;
        clip: true;
        dialog-focus := FocusScope {
            capture-key-pressed(event) => {
                if event.text == Key.Escape && !root.saving {
                    root.open = false;
                    return accept;
                }
                reject
            }
            VerticalBox {
                padding: 24px;
                spacing: 16px;
                Text { text: @tr("Sign-in settings"); color: AppTheme.heading; font-size: TypeScale.title-large; font-weight: 600; }
                Text {
                    text: root.reason != "" ? root.reason : @tr("Use your own OAuth app registration for Gmail or Outlook.");
                    color: AppTheme.secondary; font-size: TypeScale.body; wrap: word-wrap;
                }
                HorizontalBox {
                    spacing: 8px;
                    Button { text: @tr("Google"); primary: root.google; enabled: !root.saving; clicked => { root.google = true; root.save-error = ""; } }
                    Button { text: @tr("Microsoft"); primary: !root.google; enabled: !root.saving; clicked => { root.google = false; root.save-error = ""; } }
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalBox {
                        padding: 0px;
                        padding-right: 12px;
                        spacing: 12px;
                        Text {
                            text: root.google
                                ? (root.google-client-id != "" ? @tr("Using your saved Google app keys") : root.google-bundled ? @tr("Using the app’s built-in Google keys") : root.google-available ? @tr("Using Google keys from the environment") : @tr("Google sign-in needs app keys"))
                                : (root.ms-client-id != "" ? @tr("Using your saved Microsoft app key") : root.microsoft-bundled ? @tr("Using the app’s built-in Microsoft key") : root.microsoft-available ? @tr("Using a Microsoft key from the environment") : @tr("Microsoft sign-in needs an app key"));
                            color: AppTheme.heading; font-size: TypeScale.body; font-weight: 600; wrap: word-wrap;
                        }
                        Text { text: @tr("Client ID"); color: AppTheme.heading; font-size: TypeScale.body; }
                        if root.google : LineEdit {
                            height: 40px;
                            enabled: !root.saving;
                            input-label: @tr("Google client ID");
                            text <=> root.draft-google-id;
                            placeholder-text: root.platform == "android" ? @tr("Google Android client ID")
                                : root.platform == "ios" ? @tr("Google iOS client ID")
                                : @tr("Google desktop client ID");
                            edited(value) => { root.save-error = ""; }
                        }
                        if !root.google : LineEdit {
                            height: 40px;
                            enabled: !root.saving;
                            input-label: @tr("Microsoft client ID");
                            text <=> root.draft-ms-id;
                            placeholder-text: root.phone ? @tr("Microsoft Entra client ID") : @tr("Microsoft Entra desktop client ID");
                            edited(value) => { root.save-error = ""; }
                        }
                        // Android and iOS clients have no secret.
                        if root.google && !root.phone : Text { text: @tr("Client secret (if provided)"); color: AppTheme.heading; font-size: TypeScale.body; }
                        if root.google && !root.phone : LineEdit {
                            height: 40px;
                            enabled: !root.saving;
                            input-label: @tr("Google client secret");
                            input-type: password;
                            text <=> root.draft-google-secret;
                            placeholder-text: @tr("Paste your client secret");
                            edited(value) => { root.save-error = ""; }
                        }
                        Text {
                            text: root.google
                                ? (root.platform == "android" ? @tr("Create an Android client in Google Cloud for the package {} with this app’s signing certificate, and enable the Gmail API.", "com.flectar.mail")
                                    : root.platform == "ios" ? @tr("Create an iOS client in Google Cloud for the bundle ID {}, and enable the Gmail API.", "com.flectar.mail")
                                    : @tr("Create a Desktop app client in Google Cloud and enable the Gmail API. To send large files from Google Drive, enable the Google Drive API too."))
                                : (root.platform == "android" ? @tr("In Microsoft Entra, add an Android platform for the package {} with this app’s signature hash. No client secret is needed.", "com.flectar.mail")
                                    : root.platform == "ios" ? @tr("In Microsoft Entra, add an iOS platform for the bundle ID {}. No client secret is needed.", "com.flectar.mail")
                                    : @tr("Use a public desktop app registration in Microsoft Entra. No client secret is needed."));
                            color: AppTheme.secondary; font-size: TypeScale.caption; wrap: word-wrap;
                        }
                        // A way to add Gmail, not to sign an account in again.
                        if root.google && root.reason == "" : Text {
                            text: @tr("Gmail also works without app keys. Close this, choose Connect another provider, and sign in with a Google app password.");
                            color: AppTheme.secondary; font-size: TypeScale.caption; wrap: word-wrap;
                        }
                        Text {
                            text: @tr("Leave the client ID blank to use default keys, if available. Keys are shared with Settings.");
                            color: AppTheme.secondary; font-size: TypeScale.caption; wrap: word-wrap;
                        }
                        Text {
                            text: @tr("With Flectar Mail Sync, your other devices of this kind get these keys too.");
                            color: AppTheme.secondary; font-size: TypeScale.caption; wrap: word-wrap;
                        }
                        if root.save-error != "" : Text {
                            text: root.save-error;
                            color: AppTheme.destructive; font-size: TypeScale.caption; wrap: word-wrap;
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
                HorizontalBox {
                    spacing: 8px;
                    Button { text: @tr("Cancel"); enabled: !root.saving; clicked => { root.open = false; } }
                    save-button := Button {
                        text: root.saving ? @tr("Saving…") : @tr("Save settings");
                        primary: true;
                        enabled: !root.saving;
                        clicked => {
                            root.save(root.draft-google-id, root.draft-google-secret, root.draft-ms-id);
                        }
                    }
                }
            }
        }
    }
}
